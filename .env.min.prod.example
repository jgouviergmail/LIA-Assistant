# ============================================================================
# LIA - MINIMAL PRODUCTION CONFIGURATION
# ============================================================================
# Contains ONLY the essential variables needed for a working deployment.
# For the full configuration with all options, see .env.prod.example
#
# Steps:
# 1. Copy this file to .env
# 2. Replace all CHANGE_ME_* placeholders with real values
# 3. Generate secrets:
#    - SECRET_KEY: openssl rand -base64 32
#    - FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================================

# ============================================================================
# [01] ENVIRONMENT
# ============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
# Uncomment to start the full observability stack (Grafana, Prometheus, Loki,
# Tempo, exporters, Portainer). Minimal installs default to core-only (ADR-215).
# COMPOSE_PROFILES=observability

# ============================================================================
# [02] SECURITY & AUTHENTICATION
# ============================================================================
# Generate with: openssl rand -base64 32 (minimum 32 characters)
SECRET_KEY=CHANGE_ME_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME_FERNET_KEY

# ============================================================================
# [03] DATABASE (PostgreSQL)
# ============================================================================
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_DB=lia
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# Connection-budget sizing (audit F004) — REQUIRED with 4 uvicorn workers:
# without these lines the per-worker defaults (pool 30 + overflow 30) burst
# to 288 connections against 195 usable, and the API refuses to boot
# (ConnectionBudgetError fail-fast — measured on the v1.30.1 qualification:
# every leg of the disposable matrix crash-looped to readiness_timeout).
# Worst case here: 4 x (20 + 10) + checkpointer 32 + store 16 = 168 <= 195.
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_MAX_CONNECTIONS=200
WEB_CONCURRENCY=4

# ============================================================================
# [04] REDIS
# ============================================================================
REDIS_PASSWORD=CHANGE_ME_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ============================================================================
# [05] SESSION
# ============================================================================
SESSION_COOKIE_NAME=lia_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=.yourdomain.com

# ============================================================================
# [06] URLS & CORS
# ============================================================================
CORS_ORIGINS=https://lia.yourdomain.com,https://lia-back.yourdomain.com
FRONTEND_URL=https://lia.yourdomain.com
API_URL=https://lia-back.yourdomain.com
NEXT_PUBLIC_API_URL=https://lia-back.yourdomain.com
NEXT_PUBLIC_APP_URL=https://lia.yourdomain.com
API_URL_SERVER=https://lia-back.yourdomain.com
# Runtime canonical origin for host-neutral web images (ADR-215/B03):
# read server-side at request time; empty = relative canonicals.
APP_URL_SERVER=https://lia.yourdomain.com

# ============================================================================
# [07] APPLICATION
# ============================================================================
NEXT_PUBLIC_APP_NAME=LIA
NODE_ENV=production
DEFAULT_LANGUAGE=fr

# ============================================================================
# [08] LLM PROVIDER (at least one required)
# ============================================================================
# Configure at least one LLM provider via the Admin UI (Settings > Administration > LLM Configuration)
# or set API keys here as fallback. Supports: OpenAI, Anthropic, Google Gemini, DeepSeek, Perplexity, Ollama.
#
# Example: OPENAI_API_KEY=CHANGE_ME_API_KEY
# API keys can also be configured per-provider in the Admin UI (encrypted in DB).

# ============================================================================
# [09] DATABASE BACKUP (optional — safe defaults apply if omitted)
# ============================================================================
# pg_dump sidecar with daily/weekly/monthly rotation (ADR-109).
# Restore runbook: docs/runbooks/DATABASE_BACKUP_RESTORE.md
POSTGRES_BACKUP_SCHEDULE=@daily
POSTGRES_BACKUP_KEEP_DAYS=7
POSTGRES_BACKUP_KEEP_WEEKS=4
POSTGRES_BACKUP_KEEP_MONTHS=6
POSTGRES_BACKUP_HOST_DIR=../lia-data/postgres-backups

# ============================================================================
# [10] BACKGROUND CHAT RUNS (optional — safe default applies if omitted)
# ============================================================================
# Kill-switch for detached chat generation (ADR-117). false = legacy path.
BACKGROUND_RUNS_ENABLED=false

# ============================================================================
# [11] ALERTING (optional — omit to run Alertmanager in log-only mode, ADR-119)
# ============================================================================
# With SMTP set and no Slack/PagerDuty, Alertmanager runs in email-only mode.
# The 13-alert core (API/DB/Redis down, disk, OOM, 5xx, SSE latency, backup,
# tunnel/cert, meta) notifies the address below. Runbooks: docs/runbooks/alerts/
ALERTMANAGER_SMTP_SMARTHOST=CHANGE_ME_SMTP_HOST:587
ALERTMANAGER_SMTP_AUTH_USERNAME=CHANGE_ME_SMTP_USERNAME
ALERTMANAGER_SMTP_AUTH_PASSWORD=CHANGE_ME_SMTP_PASSWORD
ALERTMANAGER_SMTP_FROM=alerts@yourdomain.com
ALERTMANAGER_BACKEND_TEAM_EMAIL=your-email@example.com
# End-to-end public URL probe (PublicEndpointDown/CertificateExpirySoon).
# Leave empty to disable.
BLACKBOX_PUBLIC_PROBE_URL=https://lia.yourdomain.com
