# ============================================================================
# LIA - MINIMAL PRODUCTION CONFIGURATION
# ============================================================================
# Contains ONLY the essential variables needed for a working deployment.
# For the full configuration with all options, see .env.prod.example
#
# Steps:
# 1. Copy this file to .env
# 2. Replace all CHANGE_ME_* placeholders with real values
# 3. Generate secrets:
#    - SECRET_KEY: openssl rand -base64 32
#    - FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================================

# ============================================================================
# TABLE OF CONTENTS
# ============================================================================
#
# [01] ENVIRONMENT
# [02] SECURITY & AUTHENTICATION
# [03] DATABASE (PostgreSQL)
# [04] REDIS
# [05] SESSION
# [06] URLS & CORS
# [07] APPLICATION
# [08] LLM PROVIDER (at least one required)
# [09] DATABASE BACKUP (optional — safe defaults apply if omitted)
# [10] BACKGROUND CHAT RUNS (optional — safe default applies if omitted)
# [11] ALERTING (optional — omit to run Alertmanager in log-only mode, ADR-119)
# [12] MAPS & PUSH NOTIFICATIONS (optional)
# [13] SPEAKING AVATAR (optional — ADR-334)
# [14] APPLICATION TOOLS (ADR-339)
# [15] PEER CAPABILITY SHARING (ADR-350)
# [16] HTTP SCAN PROTECTION (ADR-353)
# [17] SMS & PHONE INGESTION (ADR-357)
# [18] PROACTIVE DISCUSSIONS (ADR-358, ADR-359, ADR-360)
# [19] LIA WORLD (optional — ADR-365)

# ============================================================================
# [01] ENVIRONMENT
# ============================================================================
ENVIRONMENT=production  # differs from default: the production environment
DEBUG=false
LOG_LEVEL=INFO
# Uncomment to start the full observability stack (Grafana, Prometheus, Loki,
# Tempo, exporters, Portainer). Minimal installs default to core-only (ADR-215).
# COMPOSE_PROFILES=observability
# The wizard generates these when observability is enabled and preserves them.
# For manual profile activation, set a user and a strong private password first.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# ============================================================================
# [02] SECURITY & AUTHENTICATION
# ============================================================================
# Generate with: openssl rand -base64 32 (minimum 32 characters)
SECRET_KEY=CHANGE_ME_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME_FERNET_KEY

# ============================================================================
# [03] DATABASE (PostgreSQL)
# ============================================================================
POSTGRES_USER=CHANGE_ME_DB_USER
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_DB=lia
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# Connection-budget sizing (audit F004, ADR-283) with 4 uvicorn workers.
# Two bounds, both checked at boot and in CI:
# - the CEILING: worst-case burst 4 x (5 + 15) + checkpointer 32 + store 16
#   = 128 <= 195 usable (ConnectionBudgetError fail-fast otherwise — measured
#   on the v1.30.1 qualification, every leg crash-looped to readiness_timeout
#   when the pools were oversized);
# - the FLOOR: every PERSISTENT connection is an idle Postgres backend holding
#   ~7 MB; 4 x (5 + 1 + 1) = 28 backends + shared_buffers 512 MB = 708 MB must
#   stay under half of the Postgres memory limit (2G in the shipped compose),
#   or the database swaps every morning (measured 2026-09-11 at 20 per worker).
# These are the code defaults since v1.44.5; written here so the sizing is
# visible where a self-hoster tunes it.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=15
# PostgreSQL bounds every connection of the application starts with (audit AC-028,
# ADR-304): a lock wait, and an idle transaction. 0 leaves the server's own setting.
DATABASE_LOCK_TIMEOUT_MS=30000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000
DATABASE_MAX_CONNECTIONS=200
WEB_CONCURRENCY=4

# ============================================================================
# [04] REDIS
# ============================================================================
REDIS_PASSWORD=CHANGE_ME_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# ============================================================================
# [05] SESSION
# ============================================================================
SESSION_COOKIE_NAME=lia_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=.yourdomain.com

# ============================================================================
# [06] URLS & CORS
# ============================================================================
CORS_ORIGINS=https://lia.yourdomain.com,https://lia-back.yourdomain.com  # differs from default: a deployment value to fill in
FRONTEND_URL=https://lia.yourdomain.com  # differs from default: a deployment value to fill in
API_URL=https://lia-back.yourdomain.com  # differs from default: a deployment value to fill in
NEXT_PUBLIC_API_URL=https://lia-back.yourdomain.com
NEXT_PUBLIC_APP_URL=https://lia.yourdomain.com
API_URL_SERVER=https://lia-back.yourdomain.com
# Runtime canonical origin for host-neutral web images (ADR-215/B03):
# read server-side at request time; empty = relative canonicals.
APP_URL_SERVER=https://lia.yourdomain.com

# ============================================================================
# [07] APPLICATION
# ============================================================================
NEXT_PUBLIC_APP_NAME=LIA
NODE_ENV=production
DEFAULT_LANGUAGE=fr

# ============================================================================
# [08] LLM PROVIDER (at least one required)
# ============================================================================
# Configure at least one LLM provider via the Admin UI (Settings > Administration > LLM Configuration)
# or set API keys here as fallback. Supports: OpenAI, Anthropic, Google Gemini, DeepSeek, Perplexity, Ollama.
#
# Example: OPENAI_API_KEY=CHANGE_ME_API_KEY
# API keys can also be configured per-provider in the Admin UI (encrypted in DB).

# Provider identity is never inherited from the maintainer.
OPENAI_ORGANIZATION_ID=

# ============================================================================
# [09] DATABASE BACKUP (optional — safe defaults apply if omitted)
# ============================================================================
# pg_dump sidecar with daily/weekly/monthly rotation (ADR-109).
# Restore runbook: docs/runbooks/DATABASE_BACKUP_RESTORE.md
POSTGRES_BACKUP_SCHEDULE=@daily
POSTGRES_BACKUP_KEEP_DAYS=7
POSTGRES_BACKUP_KEEP_WEEKS=4
POSTGRES_BACKUP_KEEP_MONTHS=6
POSTGRES_BACKUP_HOST_DIR=../lia-data/postgres-backups

# ============================================================================
# [10] BACKGROUND CHAT RUNS (optional — safe default applies if omitted)
# ============================================================================
# Detached chat generation (ADR-117) runs when the key is omitted;
# BACKGROUND_RUNS_ENABLED=false brings back the legacy inline path.

# Optional personal radio (ADR-324). The installer asks before enabling it:
# programmes consume the instance's model and voice provider budget.
RADIO_ENABLED=false  # differs from default: the installer asks before enabling it
# Set at or below the ElevenLabs account allowance when enabling its TTS.
ELEVENLABS_TTS_MAX_CONCURRENCY=5
# Set at or below the Fish Audio account allowance when enabling its speech or transcription.
FISHAUDIO_MAX_CONCURRENCY=5

# ============================================================================
# [11] ALERTING (optional — omit to run Alertmanager in log-only mode, ADR-119)
# ============================================================================

# With SMTP set and no Slack/PagerDuty, Alertmanager runs in email-only mode.
# The 13-alert core (API/DB/Redis down, disk, OOM, 5xx, SSE latency, backup,
# tunnel/cert, meta) notifies the address below. Runbooks: docs/runbooks/alerts/
ALERTMANAGER_SMTP_SMARTHOST=CHANGE_ME_SMTP_HOST:587  # differs from default: a deployment value to fill in
ALERTMANAGER_SMTP_AUTH_USERNAME=CHANGE_ME_SMTP_USERNAME
ALERTMANAGER_SMTP_AUTH_PASSWORD=CHANGE_ME_SMTP_PASSWORD
ALERTMANAGER_SMTP_FROM=alerts@yourdomain.com
ALERTMANAGER_BACKEND_TEAM_EMAIL=your-email@example.com
# End-to-end public URL probe (PublicEndpointDown/CertificateExpirySoon).
# Leave empty to disable.
BLACKBOX_PUBLIC_PROBE_URL=https://lia.yourdomain.com

# ============================================================================
# [12] MAPS & PUSH NOTIFICATIONS (optional)
# ============================================================================
# Interactive Maps (server settings): an explicit browser key AND a Cloud map ID;
# no server-key fallback. Never use DEMO_MAP_ID in production. An empty
# configuration keeps maps unavailable.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Android push needs all four FIREBASE_* values from your own Firebase project.
FIREBASE_PROJECT_ID=
# Optional browser push configuration; blank values do not provision Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ============================================================================
# [13] SPEAKING AVATAR (optional — ADR-334)
# ============================================================================
# Optional personal Simli avatar: the installer asks before offering it.
# Each account connects its own key and opts in; an open session can consume
# personal credits during silence. Finite bounds mirror AvatarSettings.
AVATAR_MINTS_PER_HOUR=6
AVATAR_ENABLED=false
AVATAR_SESSION_LENGTH_SECONDS=3600
AVATAR_IDLE_SECONDS=3600
AVATAR_HTTP_TIMEOUT_SECONDS=10
AVATAR_CONNECT_TIMEOUT_SECONDS=15
AVATAR_PRESENCE_TIMEOUT_SECONDS=120

# ============================================================================
# [14] APPLICATION TOOLS (ADR-339)
# ============================================================================
# Application management tools: deployment ceiling; administrator switch under Platform Capabilities.
APPLICATION_TOOLS_ENABLED=true
APPLICATION_COMMAND_TTL_SECONDS=900

# ============================================================================
# [15] PEER CAPABILITY SHARING (ADR-350)
# ============================================================================
# Peer capability transfers (server settings). Email/event JEV switches are
# DB-backed and default OFF; enable them after local qualification. This file
# never supplies a JEV enable flag or credentials for shared capabilities.
PEERS_CAPABILITY_PREVIEW_TTL_SECONDS=600
PEERS_CAPABILITY_RETRY_TTL_SECONDS=86400
PEERS_CAPABILITY_LEASE_SECONDS=120
PEERS_CAPABILITY_SENDER_DAILY_LIMIT=20
PEERS_CAPABILITY_PAIR_DAILY_LIMIT=5
PEERS_CAPABILITY_RECIPIENT_DAILY_LIMIT=50
PEERS_CAPABILITY_DAILY_BYTES=20971520
PEERS_CAPABILITY_RATE_LIMIT_CALLS=20
PEERS_CAPABILITY_RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# [16] HTTP SCAN PROTECTION (ADR-353)
# ============================================================================
# API HTTP scan protection (shared Redis bans; normal session/resource errors excluded).
HTTP_SCAN_PROTECTION_ENABLED=true
HTTP_SCAN_WINDOW_SECONDS=60
HTTP_SCAN_NOT_FOUND_LIMIT=20
HTTP_SCAN_AUTH_WINDOW_SECONDS=600
HTTP_SCAN_AUTH_FAILURE_LIMIT=20
HTTP_SCAN_BAN_SECONDS=900
HTTP_SCAN_REDIS_TIMEOUT_SECONDS=0.2

# ============================================================================
# [17] SMS & PHONE INGESTION (ADR-357)
# ============================================================================
# Personal SMS archive; assistant access still requires explicit user consent.
# See .env.prod.example for bounded ingestion/search/delivery limits.
SMS_ENABLED=true
BRIEFING_MAX_SMS_ITEMS=10

# ============================================================================
# [18] PROACTIVE DISCUSSIONS (ADR-358, ADR-359, ADR-360)
# ============================================================================
# Proactive discussions: independent opt-in, native quotas still apply.
# Costs in USD: per run, per owner/day, and total instance/day (daily buckets use UTC).
# Starting operator limits, adjustable; runs also respect source consent and activity hours.
# After changing environment settings, recreate the API container to apply them.
# Config: apps/api/src/core/config/proactive_discussions.py
PROACTIVE_DISCUSSIONS_ENABLED=true
DISCUSSION_INTERVAL_MINUTES=15
DISCUSSION_RUN_BUDGET_USD=0.10
DISCUSSION_OWNER_DAILY_BUDGET_USD=1.00
DISCUSSION_INSTANCE_DAILY_BUDGET_USD=5.00

# Hours a reply to an opening restrains later discussions while memory has not
# acknowledged it (transient guard, ADR-359).
DISCUSSION_REPLY_GUARD_TTL_HOURS=168

# ============================================================================
# [19] LIA WORLD (optional — ADR-365)
# ============================================================================
# The installer asks before offering this shared space. Native operator policy,
# participant presence consent and private-panel permissions still apply.
# Drawing is client-side; no extra Compose service or provider key is needed.
WORLD_ENABLED=false
# Admission and authority defaults live in apps/api/src/core/config/world.py.
# Paid translation uses the configured World translator slot and native quotas.
