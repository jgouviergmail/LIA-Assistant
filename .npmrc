auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=true
# Node is pinned to the line CI (node-version 24) and the Docker images
# (node:24-alpine) already run. The pre-commit hook executes on the host, so a
# drifting local Node means the local gate no longer reproduces CI: fail the
# install rather than let that come back silently.
engine-strict=true
