# Node modules (all workspaces)
**/node_modules

# Build outputs
exports/
# Operator-local preview packaging is never part of a production web image.
apps/web/public/landing-media-dev/
# Offline motion authoring and its media do not enter application images.
tools/lia-motion/
.tmp/
output/
**/.next
# Every per-session proof dist, whatever its name (`.next-e2e*`, `.next-public-screenshots`,
# `.next-hitl-validation`...): the pattern `.gitignore` and capture_public_screenshots.ps1
# (`^\.next-[a-zA-Z0-9-]+$`) already use. A bare `.next-e2e` once let ~22k files into the
# context (2026-08-23); `.next-e2e*` still let in every dist named otherwise (audit A03).
**/.next-*
**/dist
**/out

# Git
.git

# Python
**/__pycache__
**/*.pyc
**/.venv

# Logs
**/*.log

# Large ML models (built into image separately)
apps/api/models/sensevoice

# Dev files
**/JGO
**/.pytest_cache
**/.tmp-codex
**/*tmp-codex*
**/coverage

# Analysis artifacts (type-check + coverage reports)
# Regenerated locally on every run and never consumed by an image build.
# Note: the patterns above match a path component named exactly "coverage",
# which is why these distinct names need their own entries.
**/.mypy_cache
**/htmlcov
**/.coverage*
**/coverage*.json

# Environment files never enter a build context.
#
# This is the WEB image's context (`context: .` in the compose files), and its
# Dockerfile copies named paths only — verified 2026-08-07, no `.env*` exists
# in either built image. That is today's Dockerfile: one `COPY . .` added
# tomorrow would ship every secret of this machine into a layer. Excluding
# them here makes the leak impossible rather than merely absent.
#
# `apps/api/.dockerignore` already does this for the API context.
.env
.env.*
!.env*.example
**/.env
**/.env.*
!**/.env*.example
