graph TB
    subgraph Triggers["Two trigger mechanisms (ADR-106 unified contract)"]
        direction LR
        OutputDriven["Output-driven — post-execution<br/>tool returns requires_confirmation=True<br/>+ draft_type (email, event, *_delete, …)"]
        FlagDriven["Flag-driven — pre-execution<br/>manifest.permissions.hitl_required=True<br/>NON-draft mutations only<br/>(invariant locked by test)"]
    end

    subgraph PipelineMode["Pipeline mode"]
        Orchestrator[task_orchestrator_node<br/>ParallelExecutor]
        ApprovalGateP["approval_gate_node<br/>plan_approval — currently<br/>AUTO-APPROVE pass-through<br/>(tool-level HITL supersedes)"]
        ClarificationP["clarification_node<br/>clarification — pre-execution<br/>(semantic validator loop)"]
    end

    subgraph ReactModeHITL["ReAct mode"]
        ReactTools[react_execute_tools_node]
        ToolConfirm["tool_confirmation interrupt<br/>pre-execution mutation gate<br/>(hitl_required=True, ADR-106)"]
    end

    OutputDriven --> Orchestrator
    OutputDriven --> ReactTools
    FlagDriven --> ReactTools
    ReactTools --> ToolConfirm

    Orchestrator -->|"Pending draft"| HITLDispatch["hitl_dispatch_node<br/>draft_critique / modifier review<br/>ADR-092: ONE interrupt per node<br/>execution — edit/replan/clarify<br/>persist then SELF-LOOP"]
    ReactTools -->|"Draft prepared"| HITLDispatch

    Orchestrator -->|"FOR_EACH bulk mutation"| ForEachConfirm["for_each_confirm_node<br/>for_each_confirmation<br/>ADR-092: providers pre-executed ONCE<br/>into for_each_hitl_ctx<br/>(guarded by plan_id + turn_id)"]

    subgraph Interrupt["GraphInterrupt → typed action_requests"]
        ActionRequests["action_requests (typed):<br/>draft_critique · tool_confirmation<br/>for_each_confirmation · entity_disambiguation<br/>plan_approval · clarification"]
    end

    HITLDispatch --> ActionRequests
    ForEachConfirm --> ActionRequests
    ToolConfirm --> ActionRequests
    ClarificationP --> ActionRequests
    ApprovalGateP -.->|"bypassed — no interrupt emitted"| ActionRequests

    subgraph Delivery["Multi-Channel Delivery"]
        direction LR
        WebSSE["Web SSE<br/>Always"]
        TelegramKB["Telegram<br/>Inline Keyboard"]
        FCMPush["FCM Push<br/>If enabled"]
    end

    ActionRequests --> WebSSE
    ActionRequests --> TelegramKB
    ActionRequests --> FCMPush

    Delivery --> UserResponse["User natural-language response"]
    UserResponse --> Classifier["HitlResponseClassifier (LLM)<br/>versioned few-shots per action type"]

    Classifier --> Decision{Decision}
    Decision -->|APPROVE| Resume["Resume execution<br/>draft executed / FOR_EACH resumes<br/>orchestrator with NO re-fetch"]
    Decision -->|REJECT| Rejected["Cancel — enriched localized<br/>message (HitlMessages, 6 languages)"]
    Decision -->|EDIT| Edited["Persist modification, then self-loop:<br/>draft → modified draft checkpointed;<br/>FOR_EACH → item filter run once,<br/>cumulative indices"]
    Decision -->|REPLAN| Replan["Back to planner_node_v3<br/>with reformulated intent"]
    Decision -->|AMBIGUOUS| Clarify["Clarification question<br/>then re-interrupt"]

    Edited --> ActionRequests
    Clarify --> ActionRequests

    Resume --> Response["initiative_node → response_node"]
    Rejected --> Response

    Invariant["ADR-092 invariant:<br/>what the user LAST SAW is<br/>exactly what executes —<br/>no LLM call ever replays"]

    style OutputDriven fill:#e1f5ff
    style FlagDriven fill:#fff4e1
    style ApprovalGateP fill:#f5f5f5
    style HITLDispatch fill:#ffe1e1
    style ForEachConfirm fill:#ffe1e1
    style ToolConfirm fill:#ffcccc
    style ClarificationP fill:#e1f5ff
    style ActionRequests fill:#f0e1ff
    style Classifier fill:#fff9e1
    style Resume fill:#e1ffe1
    style Rejected fill:#ffcccc
    style Invariant fill:#e1fff5
