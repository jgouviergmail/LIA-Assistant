<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                The way back from the system browser after a provider sign-in.

                A custom scheme, not an App Link: App Links pin domains at build
                time and one published app serves every self-hosted server, whose
                address the user types at first launch. Any installed app can
                claim this scheme, so the link must be assumed intercepted —
                which is why the code it carries is worthless without the
                verifier the WebView kept (RFC 8252 §8.1).
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lia" android:host="auth-callback" />
                <data android:scheme="lia" android:host="connector-callback" />
                <data android:scheme="lia" android:host="mcp-callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 13 made notifications a runtime permission. Declaring it is
         what allows the shell to ASK; a refusal is a normal answer the setup
         path reports rather than a failure. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Microphone for the web page's getUserMedia (push-to-talk, meeting
         recording). Capacitor's BridgeWebChromeClient grants a WebView
         AUDIO_CAPTURE request only when BOTH permissions are declared and
         granted at runtime; without them it calls request.deny() and the page
         sees a permission error although the user was never asked. The probe
         bench only checks that the API exists (page.html), which is why this
         gap survived the first measurement. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Location for the web page's navigator.geolocation, the first source of
         the location cascade (ADR-219: live > remembered > home). Capacitor's
         BridgeWebChromeClient answers the WebView prompt by REQUESTING these
         two; Android refuses a permission the manifest never declared without
         showing any dialog, so the page reads "denied", the user is never
         asked, and the permission does not even appear in the app's settings
         to be repaired. The cascade then falls back to the remembered position
         silently — which is the failure nobody diagnoses. Same class as the
         microphone above, measured on a OneUI 9 device 2026-09-04.

         NOT declared, deliberately: CAMERA. Capacitor treats an undeclared
         CAMERA as "capture supported" and delegates to the camera app, so
         declaring it would only add a prompt and a failure mode. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest>
