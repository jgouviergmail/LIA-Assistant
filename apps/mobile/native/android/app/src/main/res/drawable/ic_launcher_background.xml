<?xml version="1.0" encoding="utf-8"?>
<!--
    The brand gradient, measured out of apps/web/public/icon-512.png rather than
    picked again: #2C4BDB at the top-left corner, #6D3DEA at the bottom-right.
    Angle 315 is Android's way of spelling that diagonal.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="#6D3DEA"
        android:startColor="#2C4BDB"
        android:type="linear"/>
</shape>
