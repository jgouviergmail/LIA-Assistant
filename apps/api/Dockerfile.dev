# syntax=docker/dockerfile:1.4

# =============================================================================
# Model download stage - Downloads Sherpa-onnx Whisper Small INT8 STT model
# =============================================================================
FROM python:3.14-slim-trixie AS model-downloader

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /models/whisper-small

# Download Whisper Small INT8 model files (~375MB total)
# Multi-language: 99+ languages including French
# Source: HuggingFace csukuangfj/sherpa-onnx-whisper-small
ARG HF_BASE_URL=https://huggingface.co/csukuangfj/sherpa-onnx-whisper-small/resolve/main

# Same three properties as Dockerfile.prod — see the comment there for why a
# plain `-L -o` silently produced an HTML file named `encoder.onnx`, and why a
# single HTTP/2 stream reset used to kill the build.
RUN set -eu; \
    for f in "encoder.onnx:small-encoder.int8.onnx:1000000" \
             "decoder.onnx:small-decoder.int8.onnx:1000000" \
             "tokens.txt:small-tokens.txt:1000"; do \
        out="${f%%:*}"; rest="${f#*:}"; src="${rest%%:*}"; min="${rest#*:}"; \
        curl -fL --http1.1 --retry 5 --retry-all-errors --retry-delay 5 \
             -o "${out}" "${HF_BASE_URL}/${src}"; \
        size="$(wc -c < "${out}")"; \
        [ "${size}" -ge "${min}" ] || { \
            echo "ERROR: ${out} is ${size} bytes, expected at least ${min}" >&2; exit 1; }; \
        echo "${out}: ${size} bytes"; \
    done

# Silero VAD (~644 KB): the Whisper engine decodes only the first 30 s of a
# buffer (measured 2026-09-02); the service cuts longer audio on the silences
# this model finds. A missing file degrades to fixed windows, so the size floor
# below is what makes the degradation impossible to ship by accident.
WORKDIR /models/silero-vad
RUN set -eu; \
    curl -fL --http1.1 --retry 5 --retry-all-errors --retry-delay 5 \
         -o silero_vad.onnx \
         https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/silero_vad.onnx; \
    size="$(wc -c < silero_vad.onnx)"; \
    [ "${size}" -ge 500000 ] || { \
        echo "ERROR: silero_vad.onnx is ${size} bytes, expected at least 500000" >&2; exit 1; }; \
    echo "silero_vad.onnx: ${size} bytes"

# =============================================================================
# GeoIP database download stage - DB-IP Lite City (free, CC-BY-4.0)
# =============================================================================
FROM python:3.14-slim-trixie AS geoip-downloader

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /data/geoip

# DB-IP Lite City database — free, no account needed, updated monthly.
# db-ip.com keeps only the last ~2 months online, so resolve the latest
# available month at build time (current month, then the previous one) instead
# of hard-coding a date that 404s a couple of months later. Override a specific
# month with `--build-arg DBIP_DATE=YYYY-MM`.
ARG DBIP_DATE=""
RUN set -eu; \
    if [ -n "${DBIP_DATE}" ]; then \
        CANDIDATES="${DBIP_DATE}"; \
    else \
        CANDIDATES="$(date -u +%Y-%m) $(date -u -d "$(date -u +%Y-%m-15) -1 month" +%Y-%m)"; \
    fi; \
    DONE=0; \
    for M in ${CANDIDATES}; do \
        URL="https://download.db-ip.com/free/dbip-city-lite-${M}.mmdb.gz"; \
        echo "Fetching ${URL}"; \
        if curl -fsSL "${URL}" -o dbip-city-lite.mmdb.gz && gunzip dbip-city-lite.mmdb.gz; then \
            DONE=1; echo "DB-IP City Lite ${M} ready"; break; \
        fi; \
        rm -f dbip-city-lite.mmdb.gz dbip-city-lite.mmdb; \
    done; \
    [ "${DONE}" -eq 1 ] || { echo "ERROR: no DB-IP City Lite database found for: ${CANDIDATES}" >&2; exit 1; }

# =============================================================================
# Development stage
# =============================================================================
FROM python:3.14-slim-trixie

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/app/.cache/huggingface

# Create app directory
WORKDIR /app

# Install system dependencies + uv (ultra-fast pip replacement)
# Includes Docker CLI for container management from within the container
# (Node.js is installed in the next layer, from the official distribution)
#
# gnupg is listed EXPLICITLY: `gpg --dearmor` below used to work only because the
# NodeSource setup script installed gnupg as a side effect of its own bootstrap.
# Dropping that script therefore broke this layer with `gpg: not found` — an
# implicit dependency is one nobody can see until it disappears.
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    curl \
    git \
    ffmpeg \
    gnupg \
    xz-utils \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian trixie stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y docker-ce-cli \
    && rm -rf /var/lib/apt/lists/* \
    && pip install uv

# Install Node.js from the OFFICIAL nodejs.org distribution, latest of the 24 LTS
# line — same line as the web image, CI and the `engines` lock. See
# Dockerfile.prod for why NodeSource is no longer used (`| bash -` cannot fail
# loudly, so a transient outage silently left a Debian Node without npm) and why
# the version floats inside the line rather than being hard-coded.
ARG NODE_MAJOR=24
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in amd64) node_arch=x64 ;; arm64) node_arch=arm64 ;; \
      *) echo "ERROR: unsupported architecture: $arch" >&2; exit 1 ;; esac; \
    base="https://nodejs.org/dist/latest-v${NODE_MAJOR}.x"; \
    cd /tmp; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 5 \
         -o SHASUMS256.txt "${base}/SHASUMS256.txt"; \
    file="$(grep -oE "node-v[0-9]+\.[0-9]+\.[0-9]+-linux-${node_arch}\.tar\.xz" \
            SHASUMS256.txt | head -1)"; \
    [ -n "${file}" ] || { \
      echo "ERROR: no ${node_arch} tarball listed for Node ${NODE_MAJOR}.x" >&2; exit 1; }; \
    curl -fsSL --retry 5 --retry-all-errors --retry-delay 5 -o "${file}" "${base}/${file}"; \
    expected="$(grep -F " ${file}" SHASUMS256.txt | awk '{print $1}')"; \
    actual="$(sha256sum "${file}" | awk '{print $1}')"; \
    if [ -z "${expected}" ] || [ "${expected}" != "${actual}" ]; then \
      echo "ERROR: checksum mismatch for ${file}" >&2; exit 1; \
    fi; \
    tar -xJf "${file}" -C /usr/local --strip-components=1 --no-same-owner; \
    rm -f "${file}" SHASUMS256.txt; \
    node -v; npm -v

# Install Claude Code CLI for DevOps remote server management
# Auth is persisted via Docker volume (~/.claude/)
# CLAUDE.md workspace is mounted via docker-compose
RUN npm install -g @anthropic-ai/claude-code \
    && mkdir -p /opt/claude-workspace

# Copy compiled lockfile (requirements-dev.lock.txt is self-contained: it
# layers requirements-dev.txt on top of requirements.lock.txt via `task deps:lock`)
COPY requirements-dev.lock.txt ./

# Install Python dependencies with uv (10-100x faster than pip)
# Exact pins + hash verification: dev containers match prod resolution.
# No cache mount = Docker layer cache works = instant rebuild if lock unchanged
# URLLIB3_NO_OVERRIDE + --no-binary urllib3-future: build the urllib3 fork
# from sdist so it does NOT clobber the genuine urllib3 (see requirements.txt).
RUN URLLIB3_NO_OVERRIDE=1 uv pip install --system --require-hashes --no-binary urllib3-future -r requirements-dev.lock.txt

# Copy STT models from model-downloader stage (Whisper + Silero VAD)
COPY --from=model-downloader /models/whisper-small /models/whisper-small
COPY --from=model-downloader /models/silero-vad /models/silero-vad

# Copy GeoIP database from geoip-downloader stage
COPY --from=geoip-downloader /data/geoip /data/geoip

# Copy entrypoint script first
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# Install Playwright Chromium browser (F7 — Browser Control)
# playwright install downloads the browser binary + system deps
RUN playwright install --with-deps chromium

# Copy application code
COPY . .

# Expose ports (8000: API HTTPS, 9091: Prometheus metrics HTTP)
EXPOSE 8000 9091

# Set entrypoint to run migrations before starting app
ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Run with hot reload
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
