# ============================================================================
# LIA API - Test Environment Configuration
# ============================================================================
# Minimal configuration for running unit/integration tests.
# Values are test stubs — never use in production.
# ============================================================================

# ============================================================================
# [01] CORE
# ============================================================================
API_PREFIX=/api/v1
DEBUG=true

# ============================================================================
# [02] DATABASE & REDIS
# ============================================================================
# Database (managed by test fixtures / testcontainers)
DATABASE_URL=postgresql+asyncpg://test:test@localhost:5432/test_db
# Short bounds in tests: a blackholed/failed connect must degrade into a fast
# retry or a loud PoolTimeout, never a wedged run (LangGraph psycopg pools).
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_TIMEOUT=15

# Redis (overridden by conftest.py, uses DB 15 to avoid collisions)
REDIS_URL=redis://localhost:6379/15

# ============================================================================
# [03] SECURITY (test-only values, NOT for production)
# ============================================================================
SECRET_KEY=test-secret-key-change-in-production-minimum-32-chars-required-for-security
FERNET_KEY=nXQIoBSMZtcMuA30Zz8LUORRsD3zsV04L5oOJDoR0WM=
# The HTTP test client (httpx ASGITransport, http://test) never resends a
# `Secure` cookie, so every session-authenticated endpoint would 401 if the
# host/container environment leaks SESSION_COOKIE_SECURE=true into the tests.
SESSION_COOKIE_SECURE=false

# Google OAuth stubs — the PKCE authorization-URL contract test asserts the
# redirect_uri path; values are test stubs, no real OAuth call is ever made.
GOOGLE_CLIENT_ID=test-google-client-id
GOOGLE_CLIENT_SECRET=test-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ============================================================================
# [04] LLM MODEL STUBS
# ============================================================================
# These are test stubs — LLM calls are mocked in unit tests.
# Uses fake model names to ensure no real API calls are made.
ROUTER_LLM_MODEL=gpt-4.1-mini-mini
HITL_CLASSIFIER_LLM_MODEL=gpt-4.1-mini-mini
HITL_QUESTION_GENERATOR_LLM_MODEL=gpt-4.1-mini-mini
HITL_PLAN_APPROVAL_QUESTION_LLM_MODEL=gpt-4.1-mini-mini
PLANNER_LLM_MODEL=gpt-4.1-mini-mini
CONTACTS_AGENT_LLM_MODEL=gpt-4.1-mini-mini
EMAILS_AGENT_LLM_MODEL=gpt-4.1-mini-mini

# ============================================================================
# [05] OBSERVABILITY (disabled for tests)
# ============================================================================
OTEL_SDK_DISABLED=true
LANGFUSE_SECRET_KEY=sk-lf-test
LANGFUSE_PUBLIC_KEY=pk-lf-test
LANGFUSE_HOST=http://localhost:3000

# ============================================================================
# [06] RATE LIMITING (disabled for tests)
# ============================================================================
RATE_LIMIT_ENABLED=false

# ============================================================================
# [07] MEMORY (aggressive values for fast test cleanup)
# ============================================================================
MEMORY_MIN_AGE_FOR_CLEANUP_DAYS=1
MEMORY_RECENCY_DECAY_DAYS=7
MEMORY_USAGE_PENALTY_AGE_DAYS=3
MEMORY_USAGE_PENALTY_FACTOR=0.5
MEMORY_PURGE_THRESHOLD=0.5
MEMORY_CLEANUP_HOUR=0
MEMORY_CLEANUP_MINUTE=0
MEMORY_RELEVANCE_THRESHOLD=0.5
MEMORY_RETENTION_WEIGHT_IMPORTANCE=0.7
MEMORY_RETENTION_WEIGHT_RECENCY=0.3
MEMORY_CONSOLIDATION_ENABLED=false
MEMORY_CONSOLIDATION_HOUR=5
MEMORY_CONSOLIDATION_SIMILARITY_THRESHOLD=0.9
MEMORY_CONSOLIDATION_MAX_PAIRS_PER_USER=50
MEMORY_CONSOLIDATION_EMOTIONAL_DIFF_SKIP=5

# Semantic expansion: the code default was aligned to production (true) by
# the 2026-08-06 config alignment. The seven iso tests and the env-isolation
# contract pin the OTHER path, so the test environment declares it here
# instead of inheriting a product decision.
SEMANTIC_EXPANSION_EVIDENCE_DRIVEN_ENABLED=false
# Cost assertions are raw USD: EUR would convert at a LIVE exchange rate.
DEFAULT_CURRENCY=USD
