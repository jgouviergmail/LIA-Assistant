# Every stage starts from ONE Python image, pinned by version and digest
# (dependency programme, lot 7): the skills sandbox runs on the same one
# (Dockerfile.sandbox, held equal by test_sandbox_toolbox.py) and so does the
# development image (Dockerfile.dev, test_one_value_one_owner_guard.py), and
# Dependabot moves all of them in one pull request.
FROM python:3.14.7-slim-trixie@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d AS builder

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore \
    PATH=/root/.local/bin:$PATH

WORKDIR /build

# The slim base excludes manpages required by bash and util-linux alternatives
# during the upgrade. Seed the real files here as in the runtime stage below.
RUN set -eu; \
    printf '%s\n' \
      'path-include /usr/share/man/man7/bash-builtins.7.gz' \
      'path-include /usr/share/man/man1/more.1.gz' \
      > /etc/dpkg/dpkg.cfg.d/zz-lia-alternatives-manpages; \
    apt-get update -qq; \
    cd /tmp; \
    apt-get download -qq bash util-linux; \
    mkdir -p /tmp/lia-manpages; \
    for package in bash_*.deb util-linux_*.deb; do \
      dpkg-deb -x "$package" /tmp/lia-manpages; \
    done; \
    install -D -m644 /tmp/lia-manpages/usr/share/man/man7/bash-builtins.7.gz \
      /usr/share/man/man7/bash-builtins.7.gz; \
    install -D -m644 /tmp/lia-manpages/usr/share/man/man1/more.1.gz \
      /usr/share/man/man1/more.1.gz; \
    ln -sfn /etc/alternatives/pager.1.gz /usr/share/man/man1/pager.1.gz; \
    rm -rf /tmp/lia-manpages /tmp/bash_*.deb /tmp/util-linux_*.deb

# Install build dependencies and security patches
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy compiled lockfile and install dependencies (exact pins, hash-verified).
# requirements.lock.txt is generated from requirements.txt via `task deps:lock`
# (uv pip compile --universal): single multi-platform lock, installable by pip.
COPY requirements.lock.txt .
# URLLIB3_NO_OVERRIDE + --no-binary urllib3-future: build the urllib3 fork
# from sdist so it does NOT clobber the genuine urllib3 (see requirements.txt).
RUN URLLIB3_NO_OVERRIDE=1 pip install --user --no-cache-dir --require-hashes --no-binary urllib3-future -r requirements.lock.txt

# =============================================================================
# Model download stage - Downloads Sherpa-onnx Whisper Small INT8 STT model
# =============================================================================
FROM python:3.14.7-slim-trixie@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d AS model-downloader

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /models/whisper-small

# Download Whisper Small INT8 model files (~375MB total)
# Multi-language: 99+ languages including French
# Source: HuggingFace csukuangfj/sherpa-onnx-whisper-small at a fixed revision
# (its last commit, 2024-07-13) rather than `resolve/main`, an address whose
# content could change under it, and every file checked against the sha256 of
# that revision (the LFS metadata for the two models, the download itself for
# the tokens). They are the files the images built from `main` held (measured
# on dev and in production, 2026-10-02).
ARG HF_BASE_URL=https://huggingface.co/csukuangfj/sherpa-onnx-whisper-small/resolve/8f3c18b358db4d1f2fc1eae49d75cd20989e4309
ARG WHISPER_ENCODER_SHA256=4cbe7b22fa9026b843b60a68640c747de05bafb1a11b57edc0e66c232d9f33a9
ARG WHISPER_DECODER_SHA256=acad50b5c782696e91b55914cc5ab4f756f1532f76e22aa6fc615f39fb69a8ee
ARG WHISPER_VOCAB_SHA256=b34b360dbb493e781e479794586d661700670d65564001f23024971d1f2fa126

# Three properties this layer needs and did not have:
#   --fail       a plain `-L -o` writes the HTTP error BODY to the file: a 404 or
#                a CDN maintenance page produced a few hundred bytes of HTML named
#                `encoder.onnx`, the build SUCCEEDED, and speech-to-text failed at
#                runtime on an opaque onnx parse error.
#   --retry      a single stream reset on a 107 MB transfer killed the whole build
#                (observed in CI: `curl: (92) HTTP/2 stream 1 was not closed
#                cleanly: CANCEL (err 8)` after 3.6 s at 0 byte received).
#   --http1.1    that reset is an HTTP/2 multiplexing failure against the CDN;
#                HTTP/1.1 costs nothing on three sequential large downloads.
#
# The retry BUDGET matters as much as the count. `--retry 5 --retry-delay 5`
# gives up after 25 s and, worse, a FIXED delay makes curl ignore the
# `Retry-After` header a 429 carries — the very thing the host is telling us.
# Hugging Face rate-limits anonymous CI runners and failed the v1.27.10 release
# twice that way. Dropping `--retry-delay` restores exponential backoff
# (1, 2, 4 … s) and honours `Retry-After`; 8 attempts inside a 600 s ceiling is
# about four minutes of patience, bounded so a genuinely dead host still fails
# the build instead of hanging it. The User-Agent is not cosmetic: anonymous
# clients without one are the first bucket a CDN throttles.
# The checksum is the last line of defence: it refuses any body that is not the
# file — a short one that still came back with a 200, which --fail cannot see,
# as much as a different file under the same name.
RUN set -eu; \
    for f in "encoder.onnx:small-encoder.int8.onnx:${WHISPER_ENCODER_SHA256}" \
             "decoder.onnx:small-decoder.int8.onnx:${WHISPER_DECODER_SHA256}" \
             "tokens.txt:small-tokens.txt:${WHISPER_VOCAB_SHA256}"; do \
        out="${f%%:*}"; rest="${f#*:}"; src="${rest%%:*}"; sha="${rest#*:}"; \
        curl -fL --http1.1 --retry 8 --retry-all-errors --retry-max-time 600 \
             -A "lia-build (+https://github.com/jgouviergmail/LIA-Assistant)" \
             -o "${out}" "${HF_BASE_URL}/${src}"; \
        echo "${sha}  ${out}" | sha256sum -c -; \
    done

# Silero VAD (~644 KB): the Whisper engine decodes only the first 30 s of a
# buffer (measured 2026-09-02); the service cuts longer audio on the silences
# this model finds. A missing file degrades to fixed windows, so the checksum
# below is what makes the degradation impossible to ship by accident — and a
# release asset can be replaced under the same name, so it is also what pins
# the content.
WORKDIR /models/silero-vad
ARG SILERO_VAD_SHA256=9e2449e1087496d8d4caba907f23e0bd3f78d91fa552479bb9c23ac09cbb1fd6
RUN set -eu; \
    curl -fL --http1.1 --retry 8 --retry-all-errors --retry-max-time 600 \
         -A "lia-build (+https://github.com/jgouviergmail/LIA-Assistant)" \
         -o silero_vad.onnx \
         https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/silero_vad.onnx; \
    echo "${SILERO_VAD_SHA256}  silero_vad.onnx" | sha256sum -c -

# =============================================================================
# GeoIP database download stage - DB-IP Lite City (free, CC-BY-4.0)
# =============================================================================
FROM python:3.14.7-slim-trixie@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d AS geoip-downloader

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /data/geoip

# DB-IP Lite City database — free, no account needed, updated monthly.
# db-ip.com keeps only the last ~2 months online, so resolve the latest
# available month at build time (current month, then the previous one) instead
# of hard-coding a date that 404s a couple of months later. Override a specific
# month with `--build-arg DBIP_DATE=YYYY-MM`.
# The one download here without a checksum, by necessity: no address keeps one
# content long enough to pin a digest. gunzip's CRC refuses a truncated file,
# and a wrong one only mislabels a log line's country (ADR-213); the exception
# is written, with that reason, in test_build_inputs_pinned_guard.py.
ARG DBIP_DATE=""
RUN set -eu; \
    if [ -n "${DBIP_DATE}" ]; then \
        CANDIDATES="${DBIP_DATE}"; \
    else \
        CANDIDATES="$(date -u +%Y-%m) $(date -u -d "$(date -u +%Y-%m-15) -1 month" +%Y-%m)"; \
    fi; \
    DONE=0; \
    for M in ${CANDIDATES}; do \
        URL="https://download.db-ip.com/free/dbip-city-lite-${M}.mmdb.gz"; \
        echo "Fetching ${URL}"; \
        if curl -fsSL "${URL}" -o dbip-city-lite.mmdb.gz && gunzip dbip-city-lite.mmdb.gz; then \
            DONE=1; echo "DB-IP City Lite ${M} ready"; break; \
        fi; \
        rm -f dbip-city-lite.mmdb.gz dbip-city-lite.mmdb; \
    done; \
    [ "${DONE}" -eq 1 ] || { echo "ERROR: no DB-IP City Lite database found for: ${CANDIDATES}" >&2; exit 1; }

# =============================================================================
# Runtime stage
# =============================================================================
FROM python:3.14.7-slim-trixie@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/home/appuser/.local/bin:$PATH \
    BROWSER_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# Build provenance (audit F030) — pass at build time so the artifact carries its
# own identity:  docker build --build-arg APP_VERSION=1.24.0 \
#   --build-arg GIT_COMMIT_SHA=$(git rev-parse HEAD) --build-arg BUILD_DATE=$(date -u +%FT%TZ)
ARG APP_VERSION=0.0.0-dev
ARG GIT_COMMIT_SHA=unknown
ARG BUILD_DATE=unknown
ENV APP_VERSION=${APP_VERSION} \
    GIT_COMMIT_SHA=${GIT_COMMIT_SHA} \
    BUILD_DATE=${BUILD_DATE}

# Install prerequisites for repository setup (curl, gnupg needed for apt key imports)
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js from the OFFICIAL nodejs.org distribution, on the 24 LTS line
# — the same line the web image, CI (node-version: "24") and the `engines` lock
# (>=24.0.0, enforced by engine-strict) already run on.
#
# NodeSource is deliberately NOT used, and the reason is the FAILURE MODE, not
# the outage that revealed it. `curl -fsSL <url> | bash -` cannot fail loudly: a
# pipeline reports the exit status of its LAST command, so when curl fails, bash
# reads an empty stdin and exits 0. On 2026-07-27 deb.nodesource.com answered 403
# for about an hour (it answers 200 again since — this was an outage, not a
# removal). That was enough: the layer SUCCEEDED, apt resolved `nodejs` from
# Debian instead (18.x, which ships no npm), and the build died four layers later
# on `npm: not found`. Any future hiccup of that endpoint would do the same.
# Fetching a versioned archive from the official distribution and verifying it
# removes both the third-party dependency and the silent-degradation mode.
#
# The version is exact and both archives' checksums are written here
# (dependency programme, lot 7): it used to float inside the 24 line through
# `latest-v24.x`, verified only against a SHASUMS256.txt from the same server,
# so each build could unpack a different Node. Nothing moves an ARG by itself,
# so the version is held equal to the skills sandbox's Node stage
# (Dockerfile.sandbox) by test_one_value_one_owner_guard.py: the pull request
# Dependabot opens for that image cannot merge until this follows — the version
# and both lines of https://nodejs.org/dist/v<version>/SHASUMS256.txt.
ARG NODE_VERSION=24.21.0
ARG NODE_SHA256_AMD64=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6
ARG NODE_SHA256_ARM64=6ad1325edbdb5649c379b75a237147a666c95d4f9ae8d340fef2d1575d289ad2
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) node_arch=x64; sha="${NODE_SHA256_AMD64}" ;; \
      arm64) node_arch=arm64; sha="${NODE_SHA256_ARM64}" ;; \
      *) echo "ERROR: unsupported architecture: $arch" >&2; exit 1 ;; esac; \
    file="node-v${NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    cd /tmp; \
    curl -fsSL --retry 8 --retry-all-errors --retry-max-time 600 \
         -o "${file}" "https://nodejs.org/dist/v${NODE_VERSION}/${file}"; \
    echo "${sha}  ${file}" | sha256sum -c -; \
    tar -xJf "${file}" -C /usr/local --strip-components=1 --no-same-owner; \
    rm -f "${file}"; \
    node -v; npm -v

# Add the Docker CE repository (Docker CLI for DevOps container management).
# The signing key is checked before apt trusts it: this digest is the file
# whose primary fingerprint is 9DC8 5822 9FC7 DD38 854A E2D8 8D81 803C 0EBF CD88,
# the one https://docs.docker.com/engine/install/debian/ publishes. A key Docker
# re-issues changes the digest and stops the build until someone compares the
# fingerprint again.
ARG DOCKER_GPG_SHA256=1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570
RUN set -eu; \
    curl -fsSL --retry 8 --retry-all-errors --retry-max-time 600 \
         -o /tmp/docker.asc https://download.docker.com/linux/debian/gpg; \
    echo "${DOCKER_GPG_SHA256}  /tmp/docker.asc" | sha256sum -c -; \
    gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg /tmp/docker.asc; \
    rm -f /tmp/docker.asc; \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian trixie stable" > /etc/apt/sources.list.d/docker.list

# Install runtime dependencies, security patches, Chromium and Docker CLI.
# The browser tool's engine is Debian's own chromium (ADR-059 amendment
# 2026-10-02), launched by Playwright through BROWSER_CHROMIUM_EXECUTABLE: a
# signed package on every architecture, which declares its own libraries (no
# hand-written list to drift from them), installed without its recommends.
# This layer follows the provenance ARGs, which differ at every deploy and
# every release (commit, build date): each build re-resolves it, so the engine
# is the stable release Debian ships at build time — Chrome ships every two
# weeks, and a version frozen in a Playwright release falls out of support
# within weeks.
# Docker CLI required for DevOps container management from within the container
# Buildx is only a build-time tool; the Docker package recommends it, so purge
# it from the API runtime while retaining Docker CLI and Compose.
# Debian slim excludes manpages, but bash and util-linux update-alternatives
# still require these two targets during upgrades. Restore the real pages from
# the signed apt packages before upgrading, then retain just these pages.
RUN set -eu; \
    printf '%s\n' \
      'path-include /usr/share/man/man7/bash-builtins.7.gz' \
      'path-include /usr/share/man/man1/more.1.gz' \
      > /etc/dpkg/dpkg.cfg.d/zz-lia-alternatives-manpages; \
    apt-get update -qq; \
    cd /tmp; \
    apt-get download -qq bash util-linux; \
    mkdir -p /tmp/lia-manpages; \
    for package in bash_*.deb util-linux_*.deb; do \
      dpkg-deb -x "$package" /tmp/lia-manpages; \
    done; \
    install -D -m644 /tmp/lia-manpages/usr/share/man/man7/bash-builtins.7.gz \
      /usr/share/man/man7/bash-builtins.7.gz; \
    install -D -m644 /tmp/lia-manpages/usr/share/man/man1/more.1.gz \
      /usr/share/man/man1/more.1.gz; \
    ln -sfn /etc/alternatives/pager.1.gz /usr/share/man/man1/pager.1.gz; \
    rm -rf /tmp/lia-manpages /tmp/bash_*.deb /tmp/util-linux_*.deb
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
    docker-ce-cli \
    postgresql-client \
    ffmpeg \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends chromium \
    && DEBIAN_FRONTEND=noninteractive apt-get purge -y docker-buildx-plugin \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
# Since ADR-327 lot 2 the skills sandbox runs on its OWN image
# (Dockerfile.sandbox) and never reads this home. The traversal bit (o+rx)
# stays for the legacy `subprocess` mode, which drops to uid 65534 when the API
# runs as root: `useradd -m` creates the home 0700, and a dropped process could
# not traverse it (measured in production 2026-08-29, before the dedicated
# image). Traversal only: the packages are the application's own.
# (Comments may NOT sit inside a line continuation — Docker reads the `&&` as a
# new instruction and fails to parse. Measured the hard way, CI 2026-08-29.)
RUN useradd -m -u 1000 -s /bin/bash appuser && chmod 0755 /home/appuser

# Set working directory
WORKDIR /app

# Copy installed dependencies from builder (Python packages; Chromium comes from apt above)
COPY --from=builder --chown=appuser:appuser /root/.local /home/appuser/.local

# Copy STT models from model-downloader stage (Whisper + Silero VAD)
COPY --from=model-downloader --chown=appuser:appuser /models/whisper-small /models/whisper-small
COPY --from=model-downloader --chown=appuser:appuser /models/silero-vad /models/silero-vad

# Copy GeoIP database from geoip-downloader stage
COPY --from=geoip-downloader --chown=appuser:appuser /data/geoip /data/geoip

# Copy entrypoint script and fix Windows CRLF line endings
COPY --chown=appuser:appuser docker-entrypoint.sh /app/docker-entrypoint.sh
RUN sed -i 's/\r$//' /app/docker-entrypoint.sh && \
    chmod +x /app/docker-entrypoint.sh

# Copy application code
COPY --chown=appuser:appuser . .

# Copy system knowledge files for FAQ RAG indexation
# These files live at monorepo root (docs/knowledge/) but the build context is apps/api/.
# The docker-compose build section passes them via additional_contexts or they are
# pre-copied by the CI pipeline. If missing, system RAG gracefully degrades (no FAQ).
# See: docs/architecture/ADR-058-System-RAG-Spaces.md
RUN mkdir -p /app/docs/knowledge

# Create data directories for volumes (owned by appuser before USER switch).
# EVERY named-volume destination from docker-compose.prod.yml must be listed
# here: Docker seeds a new volume's ownership from the image only when the
# mount point already exists, otherwise it fabricates it as root:root and the
# appuser runtime can never write there — permanently, since that seeding only
# happens once, at volume creation. `data/skills/users` is gitignored, so it is
# absent from the build context and must be created explicitly.
# Enforced by tests/unit/test_volume_mount_ownership_guard.py.
RUN mkdir -p /app/data/attachments /app/data/skills/users /app/data/tool_cache /app/data/meetings \
    && chown -R appuser:appuser /app/data

# Install Claude Code CLI for DevOps remote server management
# Auth is persisted via Docker volume (~/.claude/)
# CLAUDE.md workspace is mounted via docker-compose
# Refresh Node's bundled npm first: its vendored dependencies lag the fixed
# brace-expansion, ip-address and tar releases even in the newest Node 24 tarball.
# The CLI is pinned: installed by root for a non-root runtime, it can never
# update itself, so an unversioned install only meant a different CLI at each
# build. 2.1.287 is npm's `latest` of 2026-10-01 and what production already
# ran (the image built 2026-10-02); the `stable` channel's 2.1.285 would have
# moved it BACK (ADR-331: a refresh never goes back).
ARG CLAUDE_CODE_VERSION=2.1.287
RUN npm install -g npm@12.1.0 \
    && npm install -g --allow-scripts=@anthropic-ai/claude-code @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
    && rm -rf /root/.npm \
    && mkdir -p /opt/claude-workspace /home/appuser/.claude \
    && chown appuser:appuser /opt/claude-workspace /home/appuser/.claude

# Switch to non-root user
USER appuser

# Expose ports (8000: API HTTP — TLS terminates at cloudflared; 9091: Prometheus metrics HTTP)
EXPOSE 8000 9091

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Set entrypoint to run migrations before starting app
ENTRYPOINT ["/app/docker-entrypoint.sh"]

# Run application
# --proxy-headers: trust X-Forwarded-For/-Proto so request.client.host is the
# real visitor IP (per-IP rate limiting, GeoIP, logs). forwarded-allow-ips="*"
# is safe ONLY because the published port is loopback-bound in
# docker-compose.prod.yml: every peer that can reach uvicorn (cloudflared via
# docker-proxy, the in-container healthcheck, compose-internal services) is trusted.
#
# --timeout-graceful-shutdown: bounds the FIRST of uvicorn's two sequential
# shutdown phases (Server.shutdown waits for in-flight connections, THEN runs the
# lifespan shutdown where ADR-117 drains chat producers). An SSE stream never ends
# on its own, so without this bound the wait is infinite and the drain is never
# reached: 31 of ~42 production stops over 7 days ended in SIGKILL. The budgets
# add up — 20s here + 60s of drain + margin must stay under the 90s
# stop_grace_period, an invariant held by
# tests/unit/test_graceful_shutdown_budget_guard.py.
# Worker count: NOT pinned here. uvicorn honours WEB_CONCURRENCY, and an
# explicit --workers would beat it -- which is exactly what happened: the
# demonstrator reuses this image, declared WEB_CONCURRENCY=2, and ran 4.
# The setting every other layer reads (connection_budget above all) must
# describe the process, so the default lives in the environment instead.
ENV WEB_CONCURRENCY=4

# --ws websockets-sansio: the legacy `websockets` implementation's keepalive
# ping awaits a SHIELDED pong future; when a peer vanishes (a Live session
# closed by the browser) nobody retrieves that future's exception and Python
# logs « ConnectionClosedError: keepalive ping timeout » at ERROR for a normal
# close. The sans-I/O implementation has no such future. One choice for every
# launch (dev, dev image, prod image), held by tests/unit/test_serve_launcher.py.
#
# Launcher: `python -m src.serve`, NOT the `uvicorn` CLI. The CLI imports the
# application in the SUPERVISOR (uvicorn.main.run → config.load_app(), for an
# early import error it then discards), so the process that only forks and
# watches the workers kept 437 MB resident on the production Pi (measured
# 2026-09-12, 407 MB on the demonstrator) for the life of the container.
# src.serve drives the same Config → Server → Multiprocess chain with the
# CLI's flags, one to one, and never imports the app (AST-guarded).
CMD ["python", "-m", "src.serve", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--limit-max-requests", "10000", "--limit-max-requests-jitter", "1000", "--proxy-headers", "--forwarded-allow-ips", "*", "--timeout-graceful-shutdown", "20", "--ws", "websockets-sansio"]
