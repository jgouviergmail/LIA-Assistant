msgid "Password must be at least {count} characters long."
msgstr "La contraseña debe tener al menos {count} caracteres."

msgid "Password cannot be longer than {count} characters."
msgstr "La contraseña no puede superar los {count} caracteres."

msgid "Password must contain at least {count} uppercase letters."
msgstr "La contraseña debe contener al menos {count} letras mayúsculas."

msgid "Password must contain at least {count} digits."
msgstr "La contraseña debe contener al menos {count} dígitos."

msgid ""
"Password must contain at least {count} special characters ({examples}...)."
msgstr ""
"La contraseña debe contener al menos {count} caracteres especiales "
"({examples}...)."

msgid "Link"
msgstr "Enlace"

msgid "The action could not be completed. Please try again."
msgstr "No se pudo completar la acción. Inténtalo de nuevo."

msgid ""
"I couldn't find any results matching your request. Could you clarify or "
"rephrase?"
msgstr ""
"No encontré resultados que coincidan con tu solicitud. ¿Puedes aclararla o "
"reformularla?"

msgid "Sorry, some operations failed after multiple attempts: {operations}"
msgstr ""
"Lo siento, algunas operaciones fallaron después de varios intentos: "
"{operations}"

msgid "The required data could not be found. Could you clarify your request?"
msgstr ""
"No se pudieron encontrar los datos necesarios. ¿Puedes aclarar tu solicitud?"

msgid "A dependency error occurred between steps."
msgstr "Se produjo un error de dependencia entre los pasos."

msgid "The operation is taking too long. Try a more specific request."
msgstr ""
"La operación está tardando demasiado. Intenta una solicitud más específica."

msgid ""
"Unable to execute this request after multiple attempts. Errors: {errors}"
msgstr ""
"No se puede ejecutar esta solicitud después de varios intentos. Errores: "
"{errors}"

msgid "Unable to execute this request after multiple attempts."
msgstr "No se puede ejecutar esta solicitud después de varios intentos."

msgid "No active domain. Please perform a search first."
msgstr "Ningún dominio activo. Realiza primero una búsqueda."

msgid "Domain '{domain}' not registered. Available domains: {available}"
msgstr "Dominio «{domain}» no registrado. Dominios disponibles: {available}"

msgid "none"
msgstr "ninguno"

msgid ""
"No active '{domain}' list in memory. Please perform a search first to create"
" a context."
msgstr ""
"Ninguna lista «{domain}» activa en memoria. Realiza primero una búsqueda "
"para crear un contexto."

msgid "Reference '{reference}' resolved successfully"
msgstr "Referencia «{reference}» resuelta correctamente"

msgid "Reference '{reference}' not found"
msgstr "Referencia «{reference}» no encontrada"

msgid "No active domains"
msgstr "Ningún dominio activo"

msgid "{count} active domain(s)"
msgstr "{count} dominio(s) activo(s)"

msgid "Resolution succeeded but no item found"
msgstr "Resolución correcta, pero no se encontró ningún elemento"

msgid "Item {index} marked as current in {domain}."
msgstr "Elemento {index} marcado como actual en {domain}."

msgid "No active context for domain '{domain}'."
msgstr "Sin contexto activo para el dominio «{domain}»."

msgid "Context state for '{domain}': {count} items"
msgstr "Estado del contexto para «{domain}»: {count} elementos"

msgid "List truncated to {limit} items ({available} available)"
msgstr "Lista truncada a {limit} elementos ({available} disponibles)"

msgid "{count} items retrieved for '{domain}'"
msgstr "{count} elementos recuperados para «{domain}»"

msgid "{count} light(s) found"
msgstr "Luces encontradas: {count}"

msgid "{count} currently on"
msgstr "{count} encendida(s) actualmente"

msgid "Light '{name}' not found. Available: {available}"
msgstr "Luz «{name}» no encontrada. Disponibles: {available}"

msgid "Light control failed"
msgstr "Error al controlar la luz"

#. The state of a light (« Lamp: on »); French, Spanish and Italian agree with
#. the feminine « lumière » / « luz » / « luce ».
msgid "on"
msgstr "encendida"

#. The state of a light (« Lamp: off »); agrees like « on ».
msgid "off"
msgstr "apagada"

msgid "brightness {pct}%"
msgstr "brillo {pct}%"

msgid "color {color}"
msgstr "color {color}"

msgid "{name} ({count} devices)"
msgstr "{name} ({count} dispositivos)"

msgid "{count} room(s): {rooms}"
msgstr "Habitaciones ({count}): {rooms}"

msgid "No rooms found"
msgstr "No se encontraron habitaciones"

msgid "Room '{name}' not found. Available: {available}"
msgstr "Habitación «{name}» no encontrada. Disponibles: {available}"

msgid "Room control failed"
msgstr "Error al controlar la habitación"

msgid "Room '{name}':"
msgstr "Habitación «{name}»:"

#. The state of every light of a room (« Room: all on »).
msgid "all on"
msgstr "todas encendidas"

#. The state of every light of a room (« Room: all off »).
msgid "all off"
msgstr "todas apagadas"

msgid "{count} scene(s): {scenes}"
msgstr "{count} escena(s): {scenes}"

msgid "No scenes found"
msgstr "No se encontraron escenas"

msgid "Scene '{name}' not found. Available: {available}"
msgstr "Escena «{name}» no encontrada. Disponibles: {available}"

msgid "Scene activation failed"
msgstr "Error al activar la escena"

msgid "Scene '{name}' activated"
msgstr "Escena «{name}» activada"

msgid "Preferences"
msgstr "Preferencias"

msgid "Your tastes, preferences and habits"
msgstr "Tus gustos, preferencias y hábitos"

msgid "Personal"
msgstr "Personal"

msgid "Identity information (work, family, where you live)"
msgstr "Datos de identidad (trabajo, familia, dónde vives)"

msgid "Relationships"
msgstr "Relaciones"

msgid "People you mention and the nature of each relationship"
msgstr "Las personas que mencionas y la naturaleza de cada relación"

msgid "Events"
msgstr "Eventos"

msgid "Significant events and important dates"
msgstr "Acontecimientos significativos y fechas importantes"

msgid "Patterns"
msgstr "Patrones"

msgid "Recurring behaviours and habits"
msgstr "Comportamientos y hábitos recurrentes"

msgid "Sensitive Areas"
msgstr "Zonas sensibles"

msgid "Delicate subjects that call for a careful approach"
msgstr "Temas delicados que requieren cuidado"

msgid "Rules & directives"
msgstr "Reglas y directrices"

msgid "Standing instructions on how LIA should work for you"
msgstr "Instrucciones permanentes sobre cómo debe trabajar LIA para ti"

msgid "Please specify a starting point or enable geolocation."
msgstr "Especifica un punto de partida o activa la geolocalización."

msgid "No route found between these locations."
msgstr "No se encontró ninguna ruta entre estos lugares."

msgid "Google Routes API is not configured."
msgstr "La API de Google Routes no está configurada."

msgid "Route calculation failed."
msgstr "Error al calcular la ruta."

msgid "Please specify a city or enable geolocation."
msgstr "Especifica una ciudad o activa la geolocalización."

msgid "Unable to find location: {location}"
msgstr "No se encuentra la ubicación: {location}"

msgid "No search results found from any source for '{query}'"
msgstr "Ninguna fuente devolvió resultados para «{query}»"

msgid "No article found for '{query}' on Wikipedia ({language})"
msgstr ""
"No se encontró ningún artículo para «{query}» en Wikipedia ({language})"

msgid "Wikipedia search for '{query}' ({language}): {count} results"
msgstr "Búsqueda en Wikipedia de «{query}» ({language}): {count} resultados"

msgid "Error during Wikipedia search: {error}"
msgstr "Error durante la búsqueda en Wikipedia: {error}"

msgid "Article '{title}' not found on Wikipedia ({language})"
msgstr "Artículo «{title}» no encontrado en Wikipedia ({language})"

msgid "Wikipedia summary: {title}"
msgstr "Resumen de Wikipedia: {title}"

msgid "Error retrieving summary: {error}"
msgstr "Error al recuperar el resumen: {error}"

msgid "content truncated"
msgstr "contenido truncado"

msgid "Wikipedia article: {title}"
msgstr "Artículo de Wikipedia: {title}"

msgid "Sections"
msgstr "Secciones"

msgid "and {count} more sections"
msgstr "y {count} secciones más"

msgid "Content"
msgstr "Contenido"

msgid "{count} additional characters in registry"
msgstr "{count} caracteres adicionales en el registro"

msgid "Error retrieving article: {error}"
msgstr "Error al recuperar el artículo: {error}"

msgid "No related article found for '{title}'"
msgstr "No se encontró ningún artículo relacionado con «{title}»"

msgid "Articles related to '{title}' ({language}): {count} results"
msgstr "Artículos relacionados con «{title}» ({language}): {count} resultados"

msgid "Error retrieving related articles: {error}"
msgstr "Error al recuperar los artículos relacionados: {error}"

msgid "Preferences updated"
msgstr "Preferencias actualizadas"

msgid "Disabling a connector requires a reason."
msgstr "Desactivar un conector requiere un motivo."

msgid "Important message"
msgstr "Mensaje importante"

msgid "A deactivation must state its reason."
msgstr "Una desactivación debe indicar su motivo."

msgid "Failed to send deactivation email notification"
msgstr "No se pudo enviar el correo de desactivación"

msgid "Failed to send activation email notification"
msgstr "No se pudo enviar el correo de activación"

msgid "Reason"
msgstr "Motivo"

msgid "Your LIA account has been deactivated"
msgstr "Tu cuenta de LIA ha sido desactivada"

#. The greeting line of an e-mail, the person's name included.
msgid "Hello {name},"
msgstr "Hola, {name}:"

msgid ""
"We inform you that your LIA account has been deactivated by an "
"administrator."
msgstr ""
"Te informamos de que un administrador ha desactivado tu cuenta de LIA."

msgid "You can no longer access the application."
msgstr "Ya no puedes acceder a la aplicación."

msgid "If you think this is an error, please contact the administrator."
msgstr "Si crees que se trata de un error, contacta con el administrador."

msgid "This is an automated email, please do not reply."
msgstr "Este es un correo automático, por favor no respondas."

msgid "Account deactivated"
msgstr "Cuenta desactivada"

msgid "Your LIA account has been reactivated"
msgstr "Tu cuenta de LIA ha sido reactivada"

msgid "We inform you that your LIA account has been reactivated."
msgstr "Te informamos de que tu cuenta de LIA ha sido reactivada."

msgid "You can now access the application again."
msgstr "Ya puedes volver a acceder a la aplicación."

msgid "Log in"
msgstr "Iniciar sesión"

msgid "Login link"
msgstr "Enlace de inicio de sesión"

msgid "Account reactivated"
msgstr "Cuenta reactivada"

msgid "Connector {connector} disabled"
msgstr "Conector {connector} desactivado"

msgid "Connector disabled"
msgstr "Conector desactivado"

msgid ""
"We inform you that the connector {connector} has been disabled by an "
"administrator."
msgstr ""
"Te informamos de que un administrador ha desactivado el conector "
"{connector}."

msgid ""
"Your existing connection has been revoked and you can no longer use this "
"connector."
msgstr ""
"Tu conexión existente ha sido revocada y ya no puedes usar este conector."

msgid "If you have any questions, please contact the administrator."
msgstr "Si tienes alguna pregunta, contacta con el administrador."

msgid "Verify your LIA account email"
msgstr "Verifica el correo electrónico de tu cuenta de LIA"

msgid ""
"Welcome to LIA! Please verify your email address to activate your account."
msgstr ""
"¡Te damos la bienvenida a LIA! Verifica tu dirección de correo electrónico "
"para activar tu cuenta."

msgid "Verify my email"
msgstr "Verificar mi correo electrónico"

msgid "This link expires in 24 hours."
msgstr "Este enlace caduca en 24 horas."

msgid "If you did not create an account, you can ignore this email."
msgstr "Si no has creado una cuenta, puedes ignorar este correo."

msgid "Verification link"
msgstr "Enlace de verificación"

msgid "Email verification"
msgstr "Verificación del correo electrónico"

msgid "Reset your LIA password"
msgstr "Restablece tu contraseña de LIA"

msgid "We received a request to reset your password."
msgstr "Hemos recibido una solicitud para restablecer tu contraseña."

msgid "Reset my password"
msgstr "Restablecer mi contraseña"

msgid "This link expires in 1 hour for security reasons."
msgstr "Por motivos de seguridad, este enlace caduca en 1 hora."

msgid "If you did not request a password reset, you can ignore this email."
msgstr ""
"Si no has solicitado restablecer tu contraseña, puedes ignorar este correo."

msgid "Reset link"
msgstr "Enlace de restablecimiento"

msgid "Password reset"
msgstr "Restablecimiento de contraseña"

msgid "Your LIA account is pending activation"
msgstr "Tu cuenta de LIA está pendiente de activación"

msgid "Welcome to LIA! Your account has been created successfully."
msgstr "¡Te damos la bienvenida a LIA! Tu cuenta se ha creado correctamente."

msgid "Your account is currently pending activation by an administrator."
msgstr "Tu cuenta está pendiente de activación por parte de un administrador."

msgid "You will receive an email once your account has been activated."
msgstr "Recibirás un correo cuando tu cuenta haya sido activada."

msgid "Thank you for your patience."
msgstr "Gracias por tu paciencia."

msgid "Account pending activation"
msgstr "Cuenta pendiente de activación"

msgid "[LIA] New user awaiting activation: {email}"
msgstr "[LIA] Nuevo usuario pendiente de activación: {email}"

msgid "New user registered"
msgstr "Nuevo usuario registrado"

msgid "A new user has registered on LIA and is waiting for your activation:"
msgstr "Un nuevo usuario se ha registrado en LIA y espera a que lo actives:"

msgid "Email"
msgstr "Correo electrónico"

msgid "Name"
msgstr "Nombre"

msgid "Method"
msgstr "Método"

msgid "Manage users"
msgstr "Gestionar usuarios"

msgid "Administration link"
msgstr "Enlace de administración"

msgid "This is an automated email from LIA."
msgstr "Este es un correo automático de LIA."
