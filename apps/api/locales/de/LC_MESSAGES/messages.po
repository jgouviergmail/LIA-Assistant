msgid "Password must be at least {count} characters long."
msgstr "Das Passwort muss mindestens {count} Zeichen lang sein."

msgid "Password cannot be longer than {count} characters."
msgstr "Das Passwort darf höchstens {count} Zeichen lang sein."

msgid "Password must contain at least {count} uppercase letters."
msgstr "Das Passwort muss mindestens {count} Großbuchstaben enthalten."

msgid "Password must contain at least {count} digits."
msgstr "Das Passwort muss mindestens {count} Ziffern enthalten."

msgid ""
"Password must contain at least {count} special characters ({examples}...)."
msgstr ""
"Das Passwort muss mindestens {count} Sonderzeichen enthalten "
"({examples}...)."

msgid "Link"
msgstr "Link"

msgid "The action could not be completed. Please try again."
msgstr "Die Aktion konnte nicht ausgeführt werden. Versuche es erneut."

msgid ""
"I couldn't find any results matching your request. Could you clarify or "
"rephrase?"
msgstr ""
"Ich konnte keine Ergebnisse zu deiner Anfrage finden. Kannst du sie "
"präzisieren oder umformulieren?"

msgid "Sorry, some operations failed after multiple attempts: {operations}"
msgstr ""
"Entschuldigung, einige Vorgänge sind nach mehreren Versuchen fehlgeschlagen:"
" {operations}"

msgid "The required data could not be found. Could you clarify your request?"
msgstr ""
"Die erforderlichen Daten konnten nicht gefunden werden. Kannst du deine "
"Anfrage präzisieren?"

msgid "A dependency error occurred between steps."
msgstr "Zwischen den Schritten ist ein Abhängigkeitsfehler aufgetreten."

msgid "The operation is taking too long. Try a more specific request."
msgstr "Der Vorgang dauert zu lange. Versuche eine genauere Anfrage."

msgid ""
"Unable to execute this request after multiple attempts. Errors: {errors}"
msgstr ""
"Diese Anfrage konnte nach mehreren Versuchen nicht ausgeführt werden. "
"Fehler: {errors}"

msgid "Unable to execute this request after multiple attempts."
msgstr "Diese Anfrage konnte nach mehreren Versuchen nicht ausgeführt werden."

msgid "No active domain. Please perform a search first."
msgstr "Keine aktive Domain. Führe zuerst eine Suche durch."

msgid "Domain '{domain}' not registered. Available domains: {available}"
msgstr "Domain „{domain}“ nicht registriert. Verfügbare Domains: {available}"

msgid "none"
msgstr "keine"

msgid ""
"No active '{domain}' list in memory. Please perform a search first to create"
" a context."
msgstr ""
"Keine aktive „{domain}“-Liste im Speicher. Führe zuerst eine Suche durch, um"
" einen Kontext zu erstellen."

msgid "Reference '{reference}' resolved successfully"
msgstr "Referenz „{reference}“ erfolgreich aufgelöst"

msgid "Reference '{reference}' not found"
msgstr "Referenz „{reference}“ nicht gefunden"

msgid "No active domains"
msgstr "Keine aktiven Domains"

msgid "{count} active domain(s)"
msgstr "{count} aktive Domain(s)"

msgid "Resolution succeeded but no item found"
msgstr "Auflösung erfolgreich, aber kein Element gefunden"

msgid "Item {index} marked as current in {domain}."
msgstr "Element {index} als aktuell in {domain} markiert."

msgid "No active context for domain '{domain}'."
msgstr "Kein aktiver Kontext für Domain „{domain}“."

msgid "Context state for '{domain}': {count} items"
msgstr "Kontextstatus für „{domain}“: {count} Elemente"

msgid "List truncated to {limit} items ({available} available)"
msgstr "Liste auf {limit} Elemente gekürzt ({available} verfügbar)"

msgid "{count} items retrieved for '{domain}'"
msgstr "{count} Elemente für „{domain}“ abgerufen"

msgid "{count} light(s) found"
msgstr "{count} Lampe(n) gefunden"

msgid "{count} currently on"
msgstr "{count} derzeit eingeschaltet"

msgid "Light '{name}' not found. Available: {available}"
msgstr "Lampe „{name}“ nicht gefunden. Verfügbar: {available}"

msgid "Light control failed"
msgstr "Lichtsteuerung fehlgeschlagen"

#. The state of a light (« Lamp: on »); French, Spanish and Italian agree with
#. the feminine « lumière » / « luz » / « luce ».
msgid "on"
msgstr "an"

#. The state of a light (« Lamp: off »); agrees like « on ».
msgid "off"
msgstr "aus"

msgid "brightness {pct}%"
msgstr "Helligkeit {pct}%"

msgid "color {color}"
msgstr "Farbe {color}"

msgid "{name} ({count} devices)"
msgstr "{name} ({count} Geräte)"

msgid "{count} room(s): {rooms}"
msgstr "Räume ({count}): {rooms}"

msgid "No rooms found"
msgstr "Keine Räume gefunden"

msgid "Room '{name}' not found. Available: {available}"
msgstr "Raum „{name}“ nicht gefunden. Verfügbar: {available}"

msgid "Room control failed"
msgstr "Raumsteuerung fehlgeschlagen"

msgid "Room '{name}':"
msgstr "Raum „{name}“:"

#. The state of every light of a room (« Room: all on »).
msgid "all on"
msgstr "alle an"

#. The state of every light of a room (« Room: all off »).
msgid "all off"
msgstr "alle aus"

msgid "{count} scene(s): {scenes}"
msgstr "{count} Szene(n): {scenes}"

msgid "No scenes found"
msgstr "Keine Szenen gefunden"

msgid "Scene '{name}' not found. Available: {available}"
msgstr "Szene „{name}“ nicht gefunden. Verfügbar: {available}"

msgid "Scene activation failed"
msgstr "Szenenaktivierung fehlgeschlagen"

msgid "Scene '{name}' activated"
msgstr "Szene „{name}“ aktiviert"

msgid "Preferences"
msgstr "Präferenzen"

msgid "Your tastes, preferences and habits"
msgstr "Deine Vorlieben, Präferenzen und Gewohnheiten"

msgid "Personal"
msgstr "Persönlich"

msgid "Identity information (work, family, where you live)"
msgstr "Angaben zu dir (Beruf, Familie, Wohnort)"

msgid "Relationships"
msgstr "Beziehungen"

msgid "People you mention and the nature of each relationship"
msgstr "Personen, die du erwähnst, und die Art jeder Beziehung"

msgid "Events"
msgstr "Ereignisse"

msgid "Significant events and important dates"
msgstr "Bedeutende Ereignisse und wichtige Termine"

msgid "Patterns"
msgstr "Muster"

msgid "Recurring behaviours and habits"
msgstr "Wiederkehrende Verhaltensweisen und Gewohnheiten"

msgid "Sensitive Areas"
msgstr "Sensible Bereiche"

msgid "Delicate subjects that call for a careful approach"
msgstr "Heikle Themen, die Behutsamkeit erfordern"

msgid "Rules & directives"
msgstr "Regeln & Anweisungen"

msgid "Standing instructions on how LIA should work for you"
msgstr "Dauerhafte Anweisungen, wie LIA für dich arbeiten soll"

msgid "No route found between these locations."
msgstr "Keine Route zwischen diesen Orten gefunden."

msgid "Route measurements are unavailable."
msgstr "Die Messwerte der Route sind nicht verfügbar."

msgid "Please specify a starting point or enable geolocation."
msgstr "Gib einen Startpunkt an oder aktiviere die Geolokalisierung."

msgid "Google Routes API is not configured."
msgstr "Die Google Routes API ist nicht konfiguriert."

msgid "Route calculation failed."
msgstr "Die Routenberechnung ist fehlgeschlagen."

msgid "Please specify a city or enable geolocation."
msgstr "Gib eine Stadt an oder aktiviere die Geolokalisierung."

msgid "Unable to find location: {location}"
msgstr "Ort nicht gefunden: {location}"

msgid "No search results found from any source for '{query}'"
msgstr "Keine Quelle hat Ergebnisse für „{query}“ geliefert"

msgid "No article found for '{query}' on Wikipedia ({language})"
msgstr "Kein Artikel für „{query}“ auf Wikipedia ({language}) gefunden"

msgid "Wikipedia search for '{query}' ({language}): {count} results"
msgstr "Wikipedia-Suche nach „{query}“ ({language}): {count} Ergebnisse"

msgid "Error during Wikipedia search: {error}"
msgstr "Fehler bei der Wikipedia-Suche: {error}"

msgid "Article '{title}' not found on Wikipedia ({language})"
msgstr "Artikel „{title}“ auf Wikipedia ({language}) nicht gefunden"

msgid "Wikipedia summary: {title}"
msgstr "Wikipedia-Zusammenfassung: {title}"

msgid "Error retrieving summary: {error}"
msgstr "Fehler beim Abrufen der Zusammenfassung: {error}"

msgid "content truncated"
msgstr "Inhalt gekürzt"

msgid "Wikipedia article: {title}"
msgstr "Wikipedia-Artikel: {title}"

msgid "Sections"
msgstr "Abschnitte"

msgid "and {count} more sections"
msgstr "und {count} weitere Abschnitte"

msgid "Content"
msgstr "Inhalt"

msgid "{count} additional characters in registry"
msgstr "{count} zusätzliche Zeichen im Register"

msgid "Error retrieving article: {error}"
msgstr "Fehler beim Abrufen des Artikels: {error}"

msgid "No related article found for '{title}'"
msgstr "Kein verwandter Artikel für „{title}“ gefunden"

msgid "Articles related to '{title}' ({language}): {count} results"
msgstr "Artikel zu „{title}“ ({language}): {count} Ergebnisse"

msgid "Error retrieving related articles: {error}"
msgstr "Fehler beim Abrufen verwandter Artikel: {error}"

msgid "Preferences updated"
msgstr "Einstellungen aktualisiert"

msgid "Disabling a connector requires a reason."
msgstr "Das Deaktivieren eines Konnektors erfordert einen Grund."

msgid "Important message"
msgstr "Wichtige Nachricht"

msgid "A deactivation must state its reason."
msgstr "Eine Deaktivierung muss ihren Grund angeben."

msgid "Failed to send deactivation email notification"
msgstr "Die E-Mail zur Deaktivierung konnte nicht gesendet werden"

msgid "Failed to send activation email notification"
msgstr "Die E-Mail zur Aktivierung konnte nicht gesendet werden"

msgid "Reason"
msgstr "Grund"

msgid "Your LIA account has been deactivated"
msgstr "Dein LIA-Konto wurde deaktiviert"

#. The greeting line of an e-mail, the person's name included.
msgid "Hello {name},"
msgstr "Hallo {name},"

msgid ""
"We inform you that your LIA account has been deactivated by an "
"administrator."
msgstr ""
"Wir informieren dich, dass dein LIA-Konto von einem Administrator "
"deaktiviert wurde."

msgid "You can no longer access the application."
msgstr "Du kannst nicht mehr auf die Anwendung zugreifen."

msgid "If you think this is an error, please contact the administrator."
msgstr ""
"Wenn du glaubst, dass es sich um einen Fehler handelt, wende dich an den "
"Administrator."

msgid "This is an automated email, please do not reply."
msgstr "Dies ist eine automatische E-Mail, bitte antworte nicht darauf."

msgid "Account deactivated"
msgstr "Konto deaktiviert"

msgid "Your LIA account has been reactivated"
msgstr "Dein LIA-Konto wurde reaktiviert"

msgid "We inform you that your LIA account has been reactivated."
msgstr "Wir informieren dich, dass dein LIA-Konto reaktiviert wurde."

msgid "You can now access the application again."
msgstr "Du kannst jetzt wieder auf die Anwendung zugreifen."

msgid "Log in"
msgstr "Anmelden"

msgid "Login link"
msgstr "Anmeldelink"

msgid "Account reactivated"
msgstr "Konto reaktiviert"

msgid "Connector {connector} disabled"
msgstr "Konnektor {connector} deaktiviert"

msgid "Connector disabled"
msgstr "Konnektor deaktiviert"

msgid ""
"We inform you that the connector {connector} has been disabled by an "
"administrator."
msgstr ""
"Wir informieren dich, dass der Konnektor {connector} von einem Administrator"
" deaktiviert wurde."

msgid ""
"Your existing connection has been revoked and you can no longer use this "
"connector."
msgstr ""
"Deine bestehende Verbindung wurde widerrufen und du kannst diesen Konnektor "
"nicht mehr verwenden."

msgid "If you have any questions, please contact the administrator."
msgstr "Wenn du Fragen hast, wende dich an den Administrator."

msgid "Verify your LIA account email"
msgstr "Bestätige die E-Mail-Adresse deines LIA-Kontos"

msgid ""
"Welcome to LIA! Please verify your email address to activate your account."
msgstr ""
"Willkommen bei LIA! Bitte bestätige deine E-Mail-Adresse, um dein Konto zu "
"aktivieren."

msgid "Verify my email"
msgstr "Meine E-Mail-Adresse bestätigen"

msgid "This link expires in 24 hours."
msgstr "Dieser Link läuft in 24 Stunden ab."

msgid "If you did not create an account, you can ignore this email."
msgstr "Wenn du kein Konto erstellt hast, kannst du diese E-Mail ignorieren."

msgid "Verification link"
msgstr "Bestätigungslink"

msgid "Email verification"
msgstr "E-Mail-Bestätigung"

msgid "Reset your LIA password"
msgstr "Setze dein LIA-Passwort zurück"

msgid "We received a request to reset your password."
msgstr "Wir haben eine Anfrage zum Zurücksetzen deines Passworts erhalten."

msgid "Reset my password"
msgstr "Mein Passwort zurücksetzen"

msgid "This link expires in 1 hour for security reasons."
msgstr "Aus Sicherheitsgründen läuft dieser Link in 1 Stunde ab."

msgid "If you did not request a password reset, you can ignore this email."
msgstr ""
"Wenn du keine Zurücksetzung deines Passworts angefordert hast, kannst du "
"diese E-Mail ignorieren."

msgid "Reset link"
msgstr "Link zum Zurücksetzen"

msgid "Password reset"
msgstr "Passwort zurücksetzen"

msgid "Your LIA account is pending activation"
msgstr "Dein LIA-Konto wartet auf Aktivierung"

msgid "Welcome to LIA! Your account has been created successfully."
msgstr "Willkommen bei LIA! Dein Konto wurde erfolgreich erstellt."

msgid "Your account is currently pending activation by an administrator."
msgstr ""
"Dein Konto wartet derzeit auf die Aktivierung durch einen Administrator."

msgid "You will receive an email once your account has been activated."
msgstr "Du erhältst eine E-Mail, sobald dein Konto aktiviert wurde."

msgid "Thank you for your patience."
msgstr "Danke für deine Geduld."

msgid "Account pending activation"
msgstr "Konto wartet auf Aktivierung"

msgid "[LIA] New user awaiting activation: {email}"
msgstr "[LIA] Neuer Benutzer wartet auf Aktivierung: {email}"

msgid "New user registered"
msgstr "Neuer Benutzer registriert"

msgid "A new user has registered on LIA and is waiting for your activation:"
msgstr ""
"Ein neuer Benutzer hat sich bei LIA registriert und wartet darauf, dass du "
"ihn aktivierst:"

msgid "Email"
msgstr "E-Mail"

msgid "Name"
msgstr "Name"

msgid "Method"
msgstr "Methode"

msgid "Manage users"
msgstr "Benutzer verwalten"

msgid "Administration link"
msgstr "Administrationslink"

msgid "This is an automated email from LIA."
msgstr "Dies ist eine automatische E-Mail von LIA."
