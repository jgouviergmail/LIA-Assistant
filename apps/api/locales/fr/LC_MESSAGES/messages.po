msgid "Password must be at least {count} characters long."
msgstr "Le mot de passe doit contenir au moins {count} caractères."

msgid "Password cannot be longer than {count} characters."
msgstr "Le mot de passe ne peut pas dépasser {count} caractères."

msgid "Password must contain at least {count} uppercase letters."
msgstr "Le mot de passe doit contenir au moins {count} lettres majuscules."

msgid "Password must contain at least {count} digits."
msgstr "Le mot de passe doit contenir au moins {count} chiffres."

msgid ""
"Password must contain at least {count} special characters ({examples}...)."
msgstr ""
"Le mot de passe doit contenir au moins {count} caractères spéciaux "
"({examples}...)."

msgid "Link"
msgstr "Lien"

msgid "The action could not be completed. Please try again."
msgstr "L'action n'a pas pu être effectuée. Réessaie."

msgid ""
"I couldn't find any results matching your request. Could you clarify or "
"rephrase?"
msgstr ""
"Je n'ai trouvé aucun résultat correspondant à ta demande. Peux-tu préciser "
"ou reformuler ?"

msgid "Sorry, some operations failed after multiple attempts: {operations}"
msgstr ""
"Désolé, certaines opérations ont échoué après plusieurs tentatives : "
"{operations}"

msgid "The required data could not be found. Could you clarify your request?"
msgstr ""
"Les données nécessaires n'ont pas pu être trouvées. Peux-tu préciser ta "
"demande ?"

msgid "A dependency error occurred between steps."
msgstr "Une erreur de dépendance entre les étapes s'est produite."

msgid "The operation is taking too long. Try a more specific request."
msgstr "L'opération prend trop de temps. Essaie une demande plus précise."

msgid ""
"Unable to execute this request after multiple attempts. Errors: {errors}"
msgstr ""
"Impossible d'exécuter cette demande après plusieurs tentatives. Erreurs : "
"{errors}"

msgid "Unable to execute this request after multiple attempts."
msgstr "Impossible d'exécuter cette demande après plusieurs tentatives."

msgid "No active domain. Please perform a search first."
msgstr "Aucun domaine actif. Effectue d'abord une recherche."

msgid "Domain '{domain}' not registered. Available domains: {available}"
msgstr ""
"Domaine « {domain} » non enregistré. Domaines disponibles : {available}"

msgid "none"
msgstr "aucun"

msgid ""
"No active '{domain}' list in memory. Please perform a search first to create"
" a context."
msgstr ""
"Aucune liste « {domain} » active en mémoire. Effectue d'abord une recherche "
"pour créer un contexte."

msgid "Reference '{reference}' resolved successfully"
msgstr "Référence « {reference} » résolue"

msgid "Reference '{reference}' not found"
msgstr "Référence « {reference} » introuvable"

msgid "No active domains"
msgstr "Aucun domaine actif"

msgid "{count} active domain(s)"
msgstr "{count} domaine(s) actif(s)"

msgid "Resolution succeeded but no item found"
msgstr "Résolution réussie, mais aucun élément trouvé"

msgid "Item {index} marked as current in {domain}."
msgstr "Élément {index} marqué comme courant dans {domain}."

msgid "No active context for domain '{domain}'."
msgstr "Aucun contexte actif pour le domaine « {domain} »."

msgid "Context state for '{domain}': {count} items"
msgstr "État du contexte pour « {domain} » : {count} éléments"

msgid "List truncated to {limit} items ({available} available)"
msgstr "Liste tronquée à {limit} éléments ({available} disponibles)"

msgid "{count} items retrieved for '{domain}'"
msgstr "{count} éléments récupérés pour « {domain} »"

msgid "{count} light(s) found"
msgstr "{count} lumière(s) trouvée(s)"

msgid "{count} currently on"
msgstr "{count} actuellement allumée(s)"

msgid "Light '{name}' not found. Available: {available}"
msgstr "Lumière « {name} » introuvable. Disponibles : {available}"

msgid "Light control failed"
msgstr "Échec du contrôle de la lumière"

#. The state of a light (« Lamp: on »); French, Spanish and Italian agree with
#. the feminine « lumière » / « luz » / « luce ».
msgid "on"
msgstr "allumée"

#. The state of a light (« Lamp: off »); agrees like « on ».
msgid "off"
msgstr "éteinte"

msgid "brightness {pct}%"
msgstr "luminosité {pct} %"

msgid "color {color}"
msgstr "couleur {color}"

msgid "{name} ({count} devices)"
msgstr "{name} ({count} appareils)"

msgid "{count} room(s): {rooms}"
msgstr "{count} pièce(s) : {rooms}"

msgid "No rooms found"
msgstr "Aucune pièce trouvée"

msgid "Room '{name}' not found. Available: {available}"
msgstr "Pièce « {name} » introuvable. Disponibles : {available}"

msgid "Room control failed"
msgstr "Échec du contrôle de la pièce"

msgid "Room '{name}':"
msgstr "Pièce « {name} » :"

#. The state of every light of a room (« Room: all on »).
msgid "all on"
msgstr "toutes allumées"

#. The state of every light of a room (« Room: all off »).
msgid "all off"
msgstr "toutes éteintes"

msgid "{count} scene(s): {scenes}"
msgstr "{count} scène(s) : {scenes}"

msgid "No scenes found"
msgstr "Aucune scène trouvée"

msgid "Scene '{name}' not found. Available: {available}"
msgstr "Scène « {name} » introuvable. Disponibles : {available}"

msgid "Scene activation failed"
msgstr "Échec de l'activation de la scène"

msgid "Scene '{name}' activated"
msgstr "Scène « {name} » activée"

msgid "Preferences"
msgstr "Préférences"

msgid "Your tastes, preferences and habits"
msgstr "Tes goûts, préférences et habitudes"

msgid "Personal"
msgstr "Personnel"

msgid "Identity information (work, family, where you live)"
msgstr "Informations d'identité (travail, famille, lieu de vie)"

msgid "Relationships"
msgstr "Relations"

msgid "People you mention and the nature of each relationship"
msgstr "Les personnes que tu mentionnes et la nature de chaque relation"

msgid "Events"
msgstr "Événements"

msgid "Significant events and important dates"
msgstr "Événements marquants et dates importantes"

msgid "Patterns"
msgstr "Patterns"

msgid "Recurring behaviours and habits"
msgstr "Comportements et habitudes récurrents"

msgid "Sensitive Areas"
msgstr "Zones sensibles"

msgid "Delicate subjects that call for a careful approach"
msgstr "Sujets délicats qui demandent de la prudence"

msgid "Rules & directives"
msgstr "Règles et directives"

msgid "Standing instructions on how LIA should work for you"
msgstr "Consignes durables sur la manière dont LIA doit travailler pour toi"

msgid "No route found between these locations."
msgstr "Aucun itinéraire trouvé entre ces lieux."

msgid "Route measurements are unavailable."
msgstr "Les mesures de l’itinéraire sont indisponibles."

msgid "Please specify a starting point or enable geolocation."
msgstr "Précise un point de départ ou active la géolocalisation."

msgid "Google Routes API is not configured."
msgstr "L'API Google Routes n'est pas configurée."

msgid "Route calculation failed."
msgstr "Le calcul de l'itinéraire a échoué."

msgid "Please specify a city or enable geolocation."
msgstr "Précise une ville ou active la géolocalisation."

msgid "Unable to find location: {location}"
msgstr "Impossible de trouver le lieu : {location}"

msgid "No search results found from any source for '{query}'"
msgstr "Aucune source n'a renvoyé de résultat pour « {query} »"

msgid "No article found for '{query}' on Wikipedia ({language})"
msgstr "Aucun article trouvé pour « {query} » sur Wikipédia ({language})"

msgid "Wikipedia search for '{query}' ({language}): {count} results"
msgstr "Recherche Wikipédia pour « {query} » ({language}) : {count} résultats"

msgid "Error during Wikipedia search: {error}"
msgstr "Erreur lors de la recherche Wikipédia : {error}"

msgid "Article '{title}' not found on Wikipedia ({language})"
msgstr "Article « {title} » introuvable sur Wikipédia ({language})"

msgid "Wikipedia summary: {title}"
msgstr "Résumé Wikipédia : {title}"

msgid "Error retrieving summary: {error}"
msgstr "Erreur lors de la récupération du résumé : {error}"

msgid "content truncated"
msgstr "contenu tronqué"

msgid "Wikipedia article: {title}"
msgstr "Article Wikipédia : {title}"

msgid "Sections"
msgstr "Sections"

msgid "and {count} more sections"
msgstr "et {count} autres sections"

msgid "Content"
msgstr "Contenu"

msgid "{count} additional characters in registry"
msgstr "{count} caractères supplémentaires dans le registre"

msgid "Error retrieving article: {error}"
msgstr "Erreur lors de la récupération de l'article : {error}"

msgid "No related article found for '{title}'"
msgstr "Aucun article lié trouvé pour « {title} »"

msgid "Articles related to '{title}' ({language}): {count} results"
msgstr "Articles liés à « {title} » ({language}) : {count} résultats"

msgid "Error retrieving related articles: {error}"
msgstr "Erreur lors de la récupération des articles liés : {error}"

msgid "Preferences updated"
msgstr "Préférences mises à jour"

msgid "Disabling a connector requires a reason."
msgstr "La désactivation d'un connecteur exige une raison."

msgid "Important message"
msgstr "Message important"

msgid "A deactivation must state its reason."
msgstr "Une désactivation doit indiquer sa raison."

msgid "Failed to send deactivation email notification"
msgstr "L'e-mail signalant la désactivation n'a pas pu être envoyé"

msgid "Failed to send activation email notification"
msgstr "L'e-mail signalant l'activation n'a pas pu être envoyé"

msgid "Reason"
msgstr "Raison"

msgid "Your LIA account has been deactivated"
msgstr "Ton compte LIA a été désactivé"

#. The greeting line of an e-mail, the person's name included.
msgid "Hello {name},"
msgstr "Bonjour {name},"

msgid ""
"We inform you that your LIA account has been deactivated by an "
"administrator."
msgstr ""
"Nous t'informons que ton compte LIA a été désactivé par un administrateur."

msgid "You can no longer access the application."
msgstr "Tu ne peux plus accéder à l'application."

msgid "If you think this is an error, please contact the administrator."
msgstr "Si tu penses qu'il s'agit d'une erreur, contacte l'administrateur."

msgid "This is an automated email, please do not reply."
msgstr "Ceci est un e-mail automatique, merci de ne pas y répondre."

msgid "Account deactivated"
msgstr "Compte désactivé"

msgid "Your LIA account has been reactivated"
msgstr "Ton compte LIA a été réactivé"

msgid "We inform you that your LIA account has been reactivated."
msgstr "Nous t'informons que ton compte LIA a été réactivé."

msgid "You can now access the application again."
msgstr "Tu peux de nouveau accéder à l'application."

msgid "Log in"
msgstr "Se connecter"

msgid "Login link"
msgstr "Lien de connexion"

msgid "Account reactivated"
msgstr "Compte réactivé"

msgid "Connector {connector} disabled"
msgstr "Connecteur {connector} désactivé"

msgid "Connector disabled"
msgstr "Connecteur désactivé"

msgid ""
"We inform you that the connector {connector} has been disabled by an "
"administrator."
msgstr ""
"Nous t'informons que le connecteur {connector} a été désactivé par un "
"administrateur."

msgid ""
"Your existing connection has been revoked and you can no longer use this "
"connector."
msgstr ""
"Ta connexion existante a été révoquée et tu ne peux plus utiliser ce "
"connecteur."

msgid "If you have any questions, please contact the administrator."
msgstr "Si tu as des questions, contacte l'administrateur."

msgid "Verify your LIA account email"
msgstr "Vérifie l'adresse e-mail de ton compte LIA"

msgid ""
"Welcome to LIA! Please verify your email address to activate your account."
msgstr ""
"Bienvenue sur LIA ! Vérifie ton adresse e-mail pour activer ton compte."

msgid "Verify my email"
msgstr "Vérifier mon adresse e-mail"

msgid "This link expires in 24 hours."
msgstr "Ce lien expire dans 24 heures."

msgid "If you did not create an account, you can ignore this email."
msgstr "Si tu n'as pas créé de compte, tu peux ignorer cet e-mail."

msgid "Verification link"
msgstr "Lien de vérification"

msgid "Email verification"
msgstr "Vérification de l'adresse e-mail"

msgid "Reset your LIA password"
msgstr "Réinitialise ton mot de passe LIA"

msgid "We received a request to reset your password."
msgstr "Nous avons reçu une demande de réinitialisation de ton mot de passe."

msgid "Reset my password"
msgstr "Réinitialiser mon mot de passe"

msgid "This link expires in 1 hour for security reasons."
msgstr "Pour des raisons de sécurité, ce lien expire dans 1 heure."

msgid "If you did not request a password reset, you can ignore this email."
msgstr ""
"Si tu n'as pas demandé de réinitialisation de mot de passe, tu peux ignorer "
"cet e-mail."

msgid "Reset link"
msgstr "Lien de réinitialisation"

msgid "Password reset"
msgstr "Réinitialisation du mot de passe"

msgid "Your LIA account is pending activation"
msgstr "Ton compte LIA est en attente d'activation"

msgid "Welcome to LIA! Your account has been created successfully."
msgstr "Bienvenue sur LIA ! Ton compte a bien été créé."

msgid "Your account is currently pending activation by an administrator."
msgstr "Ton compte est en attente d'activation par un administrateur."

msgid "You will receive an email once your account has been activated."
msgstr "Tu recevras un e-mail dès que ton compte aura été activé."

msgid "Thank you for your patience."
msgstr "Merci pour ta patience."

msgid "Account pending activation"
msgstr "Compte en attente d'activation"

msgid "[LIA] New user awaiting activation: {email}"
msgstr "[LIA] Nouvel utilisateur en attente d'activation : {email}"

msgid "New user registered"
msgstr "Nouvel utilisateur inscrit"

msgid "A new user has registered on LIA and is waiting for your activation:"
msgstr ""
"Un nouvel utilisateur s'est inscrit sur LIA et attend que tu l'actives :"

msgid "Email"
msgstr "Adresse e-mail"

msgid "Name"
msgstr "Nom"

msgid "Method"
msgstr "Méthode"

msgid "Manage users"
msgstr "Gérer les utilisateurs"

msgid "Administration link"
msgstr "Lien d'administration"

msgid "This is an automated email from LIA."
msgstr "Ceci est un e-mail automatique de LIA."
