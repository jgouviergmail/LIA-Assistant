msgid "Password must be at least {count} characters long."
msgstr "La password deve contenere almeno {count} caratteri."

msgid "Password cannot be longer than {count} characters."
msgstr "La password non può superare i {count} caratteri."

msgid "Password must contain at least {count} uppercase letters."
msgstr "La password deve contenere almeno {count} lettere maiuscole."

msgid "Password must contain at least {count} digits."
msgstr "La password deve contenere almeno {count} cifre."

msgid ""
"Password must contain at least {count} special characters ({examples}...)."
msgstr ""
"La password deve contenere almeno {count} caratteri speciali "
"({examples}...)."

msgid "Link"
msgstr "Link"

msgid "The action could not be completed. Please try again."
msgstr "Non è stato possibile completare l'azione. Riprova."

msgid ""
"I couldn't find any results matching your request. Could you clarify or "
"rephrase?"
msgstr ""
"Non ho trovato risultati corrispondenti alla tua richiesta. Puoi chiarire o "
"riformulare?"

msgid "Sorry, some operations failed after multiple attempts: {operations}"
msgstr ""
"Mi dispiace, alcune operazioni non sono riuscite dopo diversi tentativi: "
"{operations}"

msgid "The required data could not be found. Could you clarify your request?"
msgstr ""
"I dati richiesti non sono stati trovati. Puoi chiarire la tua richiesta?"

msgid "A dependency error occurred between steps."
msgstr "Si è verificato un errore di dipendenza tra i passaggi."

msgid "The operation is taking too long. Try a more specific request."
msgstr ""
"L'operazione sta impiegando troppo tempo. Prova una richiesta più specifica."

msgid ""
"Unable to execute this request after multiple attempts. Errors: {errors}"
msgstr ""
"Impossibile eseguire questa richiesta dopo diversi tentativi. Errori: "
"{errors}"

msgid "Unable to execute this request after multiple attempts."
msgstr "Impossibile eseguire questa richiesta dopo diversi tentativi."

msgid "No active domain. Please perform a search first."
msgstr "Nessun dominio attivo. Effettua prima una ricerca."

msgid "Domain '{domain}' not registered. Available domains: {available}"
msgstr "Dominio «{domain}» non registrato. Domini disponibili: {available}"

msgid "none"
msgstr "nessuno"

msgid ""
"No active '{domain}' list in memory. Please perform a search first to create"
" a context."
msgstr ""
"Nessuna lista «{domain}» attiva in memoria. Effettua prima una ricerca per "
"creare un contesto."

msgid "Reference '{reference}' resolved successfully"
msgstr "Riferimento «{reference}» risolto correttamente"

msgid "Reference '{reference}' not found"
msgstr "Riferimento «{reference}» non trovato"

msgid "No active domains"
msgstr "Nessun dominio attivo"

msgid "{count} active domain(s)"
msgstr "{count} dominio/i attivo/i"

msgid "Resolution succeeded but no item found"
msgstr "Risoluzione riuscita, ma nessun elemento trovato"

msgid "Item {index} marked as current in {domain}."
msgstr "Elemento {index} contrassegnato come corrente in {domain}."

msgid "No active context for domain '{domain}'."
msgstr "Nessun contesto attivo per il dominio «{domain}»."

msgid "Context state for '{domain}': {count} items"
msgstr "Stato del contesto per «{domain}»: {count} elementi"

msgid "List truncated to {limit} items ({available} available)"
msgstr "Lista troncata a {limit} elementi ({available} disponibili)"

msgid "{count} items retrieved for '{domain}'"
msgstr "{count} elementi recuperati per «{domain}»"

msgid "{count} light(s) found"
msgstr "Luci trovate: {count}"

msgid "{count} currently on"
msgstr "{count} attualmente accesa/e"

msgid "Light '{name}' not found. Available: {available}"
msgstr "Luce «{name}» non trovata. Disponibili: {available}"

msgid "Light control failed"
msgstr "Controllo della luce non riuscito"

#. The state of a light (« Lamp: on »); French, Spanish and Italian agree with
#. the feminine « lumière » / « luz » / « luce ».
msgid "on"
msgstr "accesa"

#. The state of a light (« Lamp: off »); agrees like « on ».
msgid "off"
msgstr "spenta"

msgid "brightness {pct}%"
msgstr "luminosità {pct}%"

msgid "color {color}"
msgstr "colore {color}"

msgid "{name} ({count} devices)"
msgstr "{name} ({count} dispositivi)"

msgid "{count} room(s): {rooms}"
msgstr "Stanze ({count}): {rooms}"

msgid "No rooms found"
msgstr "Nessuna stanza trovata"

msgid "Room '{name}' not found. Available: {available}"
msgstr "Stanza «{name}» non trovata. Disponibili: {available}"

msgid "Room control failed"
msgstr "Controllo della stanza non riuscito"

msgid "Room '{name}':"
msgstr "Stanza «{name}»:"

#. The state of every light of a room (« Room: all on »).
msgid "all on"
msgstr "tutte accese"

#. The state of every light of a room (« Room: all off »).
msgid "all off"
msgstr "tutte spente"

msgid "{count} scene(s): {scenes}"
msgstr "{count} scena/e: {scenes}"

msgid "No scenes found"
msgstr "Nessuna scena trovata"

msgid "Scene '{name}' not found. Available: {available}"
msgstr "Scena «{name}» non trovata. Disponibili: {available}"

msgid "Scene activation failed"
msgstr "Attivazione della scena non riuscita"

msgid "Scene '{name}' activated"
msgstr "Scena «{name}» attivata"

msgid "Preferences"
msgstr "Preferenze"

msgid "Your tastes, preferences and habits"
msgstr "I tuoi gusti, le tue preferenze e abitudini"

msgid "Personal"
msgstr "Personale"

msgid "Identity information (work, family, where you live)"
msgstr "Informazioni su di te (lavoro, famiglia, dove vivi)"

msgid "Relationships"
msgstr "Relazioni"

msgid "People you mention and the nature of each relationship"
msgstr "Le persone che menzioni e la natura di ogni relazione"

msgid "Events"
msgstr "Eventi"

msgid "Significant events and important dates"
msgstr "Eventi significativi e date importanti"

msgid "Patterns"
msgstr "Pattern"

msgid "Recurring behaviours and habits"
msgstr "Comportamenti e abitudini ricorrenti"

msgid "Sensitive Areas"
msgstr "Zone sensibili"

msgid "Delicate subjects that call for a careful approach"
msgstr "Argomenti delicati che richiedono cautela"

msgid "Rules & directives"
msgstr "Regole e direttive"

msgid "Standing instructions on how LIA should work for you"
msgstr "Istruzioni permanenti su come LIA deve lavorare per te"

msgid "Please specify a starting point or enable geolocation."
msgstr "Specifica un punto di partenza o attiva la geolocalizzazione."

msgid "No route found between these locations."
msgstr "Nessun percorso trovato tra questi luoghi."

msgid "Google Routes API is not configured."
msgstr "L'API Google Routes non è configurata."

msgid "Route calculation failed."
msgstr "Calcolo del percorso non riuscito."

msgid "Please specify a city or enable geolocation."
msgstr "Specifica una città o attiva la geolocalizzazione."

msgid "Unable to find location: {location}"
msgstr "Impossibile trovare la posizione: {location}"

msgid "No search results found from any source for '{query}'"
msgstr "Nessuna fonte ha restituito risultati per «{query}»"

msgid "No article found for '{query}' on Wikipedia ({language})"
msgstr "Nessun articolo trovato per «{query}» su Wikipedia ({language})"

msgid "Wikipedia search for '{query}' ({language}): {count} results"
msgstr "Ricerca su Wikipedia per «{query}» ({language}): {count} risultati"

msgid "Error during Wikipedia search: {error}"
msgstr "Errore durante la ricerca su Wikipedia: {error}"

msgid "Article '{title}' not found on Wikipedia ({language})"
msgstr "Articolo «{title}» non trovato su Wikipedia ({language})"

msgid "Wikipedia summary: {title}"
msgstr "Riepilogo di Wikipedia: {title}"

msgid "Error retrieving summary: {error}"
msgstr "Errore durante il recupero del riepilogo: {error}"

msgid "content truncated"
msgstr "contenuto troncato"

msgid "Wikipedia article: {title}"
msgstr "Articolo di Wikipedia: {title}"

msgid "Sections"
msgstr "Sezioni"

msgid "and {count} more sections"
msgstr "e altre {count} sezioni"

msgid "Content"
msgstr "Contenuto"

msgid "{count} additional characters in registry"
msgstr "{count} caratteri aggiuntivi nel registro"

msgid "Error retrieving article: {error}"
msgstr "Errore durante il recupero dell'articolo: {error}"

msgid "No related article found for '{title}'"
msgstr "Nessun articolo correlato trovato per «{title}»"

msgid "Articles related to '{title}' ({language}): {count} results"
msgstr "Articoli correlati a «{title}» ({language}): {count} risultati"

msgid "Error retrieving related articles: {error}"
msgstr "Errore durante il recupero degli articoli correlati: {error}"

msgid "Preferences updated"
msgstr "Preferenze aggiornate"

msgid "Disabling a connector requires a reason."
msgstr "La disattivazione di un connettore richiede un motivo."

msgid "Important message"
msgstr "Messaggio importante"

msgid "A deactivation must state its reason."
msgstr "Una disattivazione deve indicarne il motivo."

msgid "Failed to send deactivation email notification"
msgstr "Impossibile inviare l'email di disattivazione"

msgid "Failed to send activation email notification"
msgstr "Impossibile inviare l'email di attivazione"

msgid "Reason"
msgstr "Motivo"

msgid "Your LIA account has been deactivated"
msgstr "Il tuo account LIA è stato disattivato"

#. The greeting line of an e-mail, the person's name included.
msgid "Hello {name},"
msgstr "Ciao {name},"

msgid ""
"We inform you that your LIA account has been deactivated by an "
"administrator."
msgstr ""
"Ti informiamo che il tuo account LIA è stato disattivato da un "
"amministratore."

msgid "You can no longer access the application."
msgstr "Non puoi più accedere all'applicazione."

msgid "If you think this is an error, please contact the administrator."
msgstr "Se pensi che si tratti di un errore, contatta l'amministratore."

msgid "This is an automated email, please do not reply."
msgstr "Questa è un'email automatica, non rispondere."

msgid "Account deactivated"
msgstr "Account disattivato"

msgid "Your LIA account has been reactivated"
msgstr "Il tuo account LIA è stato riattivato"

msgid "We inform you that your LIA account has been reactivated."
msgstr "Ti informiamo che il tuo account LIA è stato riattivato."

msgid "You can now access the application again."
msgstr "Ora puoi accedere di nuovo all'applicazione."

msgid "Log in"
msgstr "Accedi"

msgid "Login link"
msgstr "Link di accesso"

msgid "Account reactivated"
msgstr "Account riattivato"

msgid "Connector {connector} disabled"
msgstr "Connettore {connector} disattivato"

msgid "Connector disabled"
msgstr "Connettore disattivato"

msgid ""
"We inform you that the connector {connector} has been disabled by an "
"administrator."
msgstr ""
"Ti informiamo che il connettore {connector} è stato disattivato da un "
"amministratore."

msgid ""
"Your existing connection has been revoked and you can no longer use this "
"connector."
msgstr ""
"La tua connessione esistente è stata revocata e non puoi più usare questo "
"connettore."

msgid "If you have any questions, please contact the administrator."
msgstr "Se hai domande, contatta l'amministratore."

msgid "Verify your LIA account email"
msgstr "Verifica l'email del tuo account LIA"

msgid ""
"Welcome to LIA! Please verify your email address to activate your account."
msgstr ""
"Ti diamo il benvenuto su LIA! Verifica il tuo indirizzo email per attivare "
"il tuo account."

msgid "Verify my email"
msgstr "Verifica la mia email"

msgid "This link expires in 24 hours."
msgstr "Questo link scade tra 24 ore."

msgid "If you did not create an account, you can ignore this email."
msgstr "Se non hai creato un account, puoi ignorare questa email."

msgid "Verification link"
msgstr "Link di verifica"

msgid "Email verification"
msgstr "Verifica dell'email"

msgid "Reset your LIA password"
msgstr "Reimposta la tua password LIA"

msgid "We received a request to reset your password."
msgstr "Abbiamo ricevuto una richiesta di reimpostazione della tua password."

msgid "Reset my password"
msgstr "Reimposta la mia password"

msgid "This link expires in 1 hour for security reasons."
msgstr "Per motivi di sicurezza, questo link scade tra 1 ora."

msgid "If you did not request a password reset, you can ignore this email."
msgstr ""
"Se non hai richiesto la reimpostazione della password, puoi ignorare questa "
"email."

msgid "Reset link"
msgstr "Link di reimpostazione"

msgid "Password reset"
msgstr "Reimpostazione della password"

msgid "Your LIA account is pending activation"
msgstr "Il tuo account LIA è in attesa di attivazione"

msgid "Welcome to LIA! Your account has been created successfully."
msgstr ""
"Ti diamo il benvenuto su LIA! Il tuo account è stato creato correttamente."

msgid "Your account is currently pending activation by an administrator."
msgstr ""
"Il tuo account è attualmente in attesa di attivazione da parte di un "
"amministratore."

msgid "You will receive an email once your account has been activated."
msgstr "Riceverai un'email una volta che il tuo account sarà stato attivato."

msgid "Thank you for your patience."
msgstr "Grazie per la pazienza."

msgid "Account pending activation"
msgstr "Account in attesa di attivazione"

msgid "[LIA] New user awaiting activation: {email}"
msgstr "[LIA] Nuovo utente in attesa di attivazione: {email}"

msgid "New user registered"
msgstr "Nuovo utente registrato"

msgid "A new user has registered on LIA and is waiting for your activation:"
msgstr "Un nuovo utente si è registrato su LIA e attende che tu lo attivi:"

msgid "Email"
msgstr "Email"

msgid "Name"
msgstr "Nome"

msgid "Method"
msgstr "Metodo"

msgid "Manage users"
msgstr "Gestisci utenti"

msgid "Administration link"
msgstr "Link di amministrazione"

msgid "This is an automated email from LIA."
msgstr "Questa è un'email automatica di LIA."
