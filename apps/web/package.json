{
  "name": "@lia-assistant/web",
  "version": "1.25.6",
  "description": "LIA Assistant - Frontend application",
  "license": "AGPL-3.0-or-later",
  "author": "LIA Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/jgouviergmail/LIA-Assistant.git"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:local": "next dev --webpack --hostname localhost",
    "dev:network": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "lint": "eslint src",
    "a11y:ratchet": "node scripts/check-a11y-ratchet.mjs",
    "react-hooks:ratchet": "node scripts/check-react-hooks-ratchet.mjs",
    "cc:ratchet": "node scripts/check-cc-ratchet.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-api": "openapi-ts --input ../../api/openapi.json --output ./src/lib/generated"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "geist": "^1.7.2",
    "i18next": "^26.3.5",
    "i18next-resources-to-backend": "^1.2.1",
    "katex": "^0.17.0",
    "libphonenumber-js": "^1.13.8",
    "lucide-react": "^1.23.0",
    "mermaid": "^11.16.0",
    "next": "16.2.10",
    "next-i18n-router": "^5.5.8",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-snowfall": "^2.4.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.9.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "6.0.2",
    "vite": "8.1.3",
    "vitest": "^4.1.10"
  }
}
