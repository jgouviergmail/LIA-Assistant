# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
# Named local coverage reports; also excluded inside the web-only bind mount.
/coverage-*/

# next.js
/.next/
/out/
# Per-session E2E proof dists (`NEXT_DIST_DIR=.next-e2e*`, see e2e/README.md).
# The root .gitignore already ignores them for git, but it is NOT inside the
# container bind-mount (only ./apps/web is), and Tailwind's source detection
# reads the .gitignore it finds next to the scanned tree. Without this entry a
# single leftover dist adds ~11k files to every scan and to webpack's
# dependency set: measured 2026-08-23, three of them turned the first page
# compile into 10 min 32 s (9 s once excluded).
/.next-e2e*/
/test-results/
/playwright-report/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated
/src/lib/generated

certificates

# ML Models & WASM runtime - Downloaded via scripts, not committed
# Run: ./scripts/setup-dev.sh (or individual download scripts)
/public/models/whisper-tiny-en/
/public/models/whisper-small/
# ONNX Runtime Web's WASM binary, copied from the pinned package (scripts/copy-ort-runtime.mjs)
/public/ort/
