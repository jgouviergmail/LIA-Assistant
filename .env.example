TELEPHONY_AGENT_LLM_MODEL=gpt-4o-mini                      # LLM behind the voice agent — platform default (gemini-2.5-flash, thinking) recited English reasoning aloud; pin a thinking-free model
TELEPHONY_PROBE_NOT_FOUND_GRACE_SECONDS=60                 # Age before a 404 conversation probe closes an active row as gone (guards freshly dialed calls)
TELEPHONY_PREFETCH_WINDOW_DAYS=10                           # Margin (days) around the objective window for availability pre-fetch
TELEPHONY_MAX_CALL_DURATION_SECONDS=600                     # Hard cap on call duration (used when provisioning the agent)
TELEPHONY_CALL_RETENTION_DAYS=30                            # Retention TTL for PhoneCall.summary/structured_data (D-8)
TELEPHONY_STALE_CALL_TIMEOUT_MINUTES=15                     # A dialing/in_progress call with no webhook after this is marked failed
TELEPHONY_RATE_LIMIT_PER_HOUR=10                            # Per-user place_phone_call rate limit (calls/hour)
TELEPHONY_WEBHOOK_TOLERANCE_SECONDS=1800                    # Post-call webhook HMAC replay window (reject older timestamps)
TELEPHONY_STALE_REAPER_INTERVAL_MINUTES=5                   # Interval (minutes) for the stale-call reaper sweep
TELEPHONY_RETURN_MAX_ATTEMPTS=3                             # Bounded retries of the idempotent post-call return delivery (T1)
TELEPHONY_RETURN_RETRY_DELAY_SECONDS=5                      # Delay (seconds) between post-call return delivery retries
TELEPHONY_NOTIFICATION_GRACE_SECONDS=120                   # Grace before the reaper re-dispatches a PENDING return (avoids racing live dispatch, T1)
TELEPHONY_NOTIFICATION_REAPER_INTERVAL_MINUTES=2           # Interval (minutes) for the return-notification recovery reaper (T1)
TELEPHONY_NOTIFICATION_MAX_ATTEMPTS=5                      # Bounded re-dispatch attempts before a PENDING return is marked FAILED (T1)
TELEPHONY_RETURN_GRACE_SECONDS=120                         # Grace before the return reaper re-runs a RECEIVED inbox synthesis (avoids racing live synthesis, T1-A)
TELEPHONY_RETURN_MAX_AGE_MINUTES=60                        # A RECEIVED inbox row still unsynthesized after this is retired to FAILED + encrypted transcript purged (T1-A, D-8)
TELEPHONY_RETURN_REAPER_INTERVAL_MINUTES=3                 # Interval (minutes) for the pre-synthesis return recovery reaper (T1-A)

