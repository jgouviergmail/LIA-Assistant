# ============================================================================
# [59] CHANNELS — Telegram
# Config: src/core/config/channels.py
# ============================================================================
# Multi-channel messaging for chatting with LIA and receiving proactive notifications.
# Reference: docs/technical/CHANNELS_INTEGRATION.md

CHANNELS_ENABLED=true                                       # Enable multi-channel messaging

# Telegram Bot Configuration
# Get a bot token from @BotFather on Telegram: https://core.telegram.org/bots#botfather
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET            # Webhook signature verification secret
# Public HTTPS URL for webhook (production). If absent, long polling is used (dev).
TELEGRAM_WEBHOOK_URL=https://lia-back.yourdomain.com/api/v1/channels/telegram/webhook
TELEGRAM_BOT_USERNAME=@LIABot                               # Bot @username (displayed in UI for OTP)
TELEGRAM_MESSAGE_MAX_LENGTH=4000                            # Max message length

# OTP Linking Flow
CHANNEL_OTP_TTL_SECONDS=300                                 # OTP validity in seconds (5 min)
CHANNEL_OTP_LENGTH=6                                        # OTP code length
CHANNEL_OTP_MAX_ATTEMPTS=5                                  # Max OTP attempts before block
CHANNEL_OTP_BLOCK_TTL_SECONDS=900                           # Block duration after max attempts (15 min)

# Rate Limiting
CHANNEL_RATE_LIMIT_PER_USER_PER_MINUTE=10                   # Per-user message rate limit
CHANNEL_RATE_LIMIT_GLOBAL_PER_SECOND=25                     # Global message rate limit

# Message Processing
CHANNEL_MESSAGE_LOCK_TTL_SECONDS=120                        # Message processing lock TTL

# SEC-024 — Telegram redelivers an update until it is acknowledged, and an
# answer lost on the wire counts as unacknowledged even though we replied 200.
# Each update_id is claimed in Redis for this long, so the redelivery (or a
# deliberate replay of a captured payload) is dropped instead of answered twice
# and re-consuming a /start OTP.
TELEGRAM_UPDATE_DEDUP_TTL_SECONDS=600                       # Replay window for update_id


# ============================================================================
# [60] HEARTBEAT
# Config: src/core/config/notifications.py
# ============================================================================
# LLM-driven proactive notifications. Aggregates context (calendar, weather,
# interests, memories) and lets the LLM decide whether to notify.
# Reference: docs/technical/HEARTBEAT_AUTONOME.md

HEARTBEAT_ENABLED=true                                      # Global feature toggle

# Scheduler
HEARTBEAT_NOTIFICATION_INTERVAL_MINUTES=30                  # Scheduler run interval (10-120 min)
HEARTBEAT_NOTIFICATION_BATCH_SIZE=50                        # Users per scheduler run (10-200)

# Cooldowns
HEARTBEAT_GLOBAL_COOLDOWN_HOURS=1                           # Min hours between heartbeat notifications (1-12)
HEARTBEAT_ACTIVITY_COOLDOWN_MINUTES=15                      # Don't notify if user active within N minutes (5-60)
HEARTBEAT_INTEREST_SAMPLE_SIZE=5                            # Varied interests shown to the decision LLM (ADR-135)
HEARTBEAT_RECENT_WINDOW_COUNT=10                            # Anti-redundancy window (notifications)
HEARTBEAT_RECENT_WINDOW_DAYS=7                              # Anti-redundancy window (days)
HEARTBEAT_INTEREST_ENRICHMENT_ENABLED=true                  # Fetch real facts for interest-centered heartbeats
HEARTBEAT_ENRICHMENT_TIMEOUT_SECONDS=45                     # Enrichment hard timeout (fail-open)
PROACTIVE_CROSS_TYPE_COOLDOWN_MINUTES=10                    # Min minutes between different proactive types (5-120)

# Context Aggregation
HEARTBEAT_CONTEXT_CALENDAR_HOURS=4                          # Hours ahead to look for calendar events (1-24)
HEARTBEAT_CONTEXT_MEMORY_LIMIT=5                            # Max user memories in context (1-20)
HEARTBEAT_CONTEXT_EMAILS_MAX=5                              # Max recent emails in heartbeat context (default: 5)
HEARTBEAT_CONTEXT_TASKS_DAYS=2                              # Days ahead to look for tasks in context (default: 2)
HEARTBEAT_CONTEXT_BIRTHDAYS_DAYS=1                          # Days ahead to surface contact birthdays (0 = today only, default: 1)
HEARTBEAT_DEPARTURE_ENABLED=false                           # Traffic-aware departure advice source (P6)
HEARTBEAT_DEPARTURE_LOOKAHEAD_HOURS=3                       # Advise only for located events within this window
HEARTBEAT_DEPARTURE_CACHE_TTL_SECONDS=900                   # Routes ETA cache TTL per (user, event)
INTERESTS_LOCAL_ANCHOR_ENABLED=false                        # Anchor interest content locally when a city is resolved (P9)

# Weather Change Detection
HEARTBEAT_WEATHER_RAIN_THRESHOLD_HIGH=0.6                   # Precipitation probability for rain alert (0.3-0.9)
HEARTBEAT_WEATHER_RAIN_THRESHOLD_LOW=0.4                    # Precipitation probability for clearing (0.1-0.5)
HEARTBEAT_WEATHER_TEMP_CHANGE_THRESHOLD=5.0                 # Temperature change in C for notification (2.0-15.0)
HEARTBEAT_WEATHER_WIND_THRESHOLD=14.0                       # Wind speed in m/s for wind alert (8.0-25.0)

# Last-known Location (proactive weather cascade)
LAST_KNOWN_LOCATION_TTL_HOURS=24                            # TTL hours for persisted geoloc before fallback to home (1-168)
LAST_KNOWN_LOCATION_MIN_DISTANCE_KM=50.0                    # Min distance km from home to prefer last-known (1.0-500.0)

# Early-exit Optimization
HEARTBEAT_INACTIVE_SKIP_DAYS=7                              # Skip if user inactive > N days (1-30)


