# Reference: docs/architecture/ADR-062-Agent-Initiative-Phase.md

INITIATIVE_ENABLED=true                                     # Enable initiative phase
INITIATIVE_MAX_ITERATIONS=1                                 # Max initiative iterations per turn (default: 1)
INITIATIVE_MAX_ACTIONS=3                                    # Max read-only actions per initiative evaluation (1-5, default: 3)
INITIATIVE_REACT_ENABLED=false                              # Enable initiative on the ReAct nominal path (ADR-070, default: false)
FOR_EACH_STOP_FORCES_SEQUENTIAL=true                        # on_item_error=stop runs FOR_EACH items sequentially so a failure actually stops the batch (default: true)
RESPONSE_CONTEXT_PREFETCH_ENABLED=true                      # Prefetch response-node context injections from initiative (latency overlap, default: true)
RESPONSE_CONTEXT_PREFETCH_AT_ROUTER_ENABLED=true            # R2: also start the prefetch at router entry (overlaps the router LLM cascade; system-RAG deferred, default: true)
SEMANTIC_PIVOT_ENABLED=true                                # R3 (ships dark): false skips the pivot LLM call, analyzer translates itself (~-1s/turn; A/B domain detection first, default: true)
RESPONSE_CONTEXT_PREFETCH_MAX_ENTRIES=64                    # In-flight prefetch registry bound, oldest cancelled beyond (default: 64)
RESPONSE_CONTEXT_PREFETCH_AWAIT_TIMEOUT_SECONDS=20          # Max wait for the prefetched bundle before inline fallback (default: 20)


# ============================================================================
# [64] RAG SPACES
# Config: src/core/config/rag_spaces.py
# ============================================================================
# User knowledge spaces with document upload (PDF, TXT, MD, DOCX) and
# hybrid search (semantic + BM25) for AI response enrichment.

RAG_SPACES_ENABLED=true                                     # Enable RAG spaces
RAG_SPACES_STORAGE_PATH=/app/data/rag_uploads               # Upload storage directory
RAG_SPACES_MAX_FILE_SIZE_MB=20                              # Max file size in MB
RAG_SPACES_MAX_SPACES_PER_USER=10                           # Max spaces per user
RAG_SPACES_MAX_DOCS_PER_SPACE=100                           # Max documents per space
RAG_REINDEX_LOCK_TTL_SECONDS=1800                          # Reindex lock TTL, renewed per-doc (F001); >= slowest single-doc re-embed
# Durable RAG jobs (F001): entity-as-job lease/heartbeat/retry + recovery reaper. INVARIANT: heartbeat < lease.
RAG_JOB_LEASE_TTL_SECONDS=300                              # Worker claim validity before the reaper may reclaim a job
RAG_JOB_HEARTBEAT_INTERVAL_SECONDS=60                      # Lease renewal cadence while working (MUST be < lease TTL)
RAG_JOB_MAX_ATTEMPTS=3                                     # Bounded retry before a job is marked ERROR
RAG_JOB_REAPER_INTERVAL_SECONDS=120                       # Recovery reaper scan cadence
RAG_JOB_REAPER_GRACE_SECONDS=60                            # Grace before an unclaimed PENDING is treated as orphaned
RAG_JOB_REAPER_BATCH_SIZE=25                               # Max recoverable jobs re-driven per reaper tick
RAG_JOB_REAPER_CONCURRENCY=4                               # Max concurrent re-drives within one tick
RAG_SPACES_CHUNK_SIZE=1000                                  # Chunk size in characters
RAG_SPACES_CHUNK_OVERLAP=200                                # Chunk overlap in characters
RAG_SPACES_RETRIEVAL_LIMIT=5                                # Max chunks retrieved per query
RAG_SPACES_RETRIEVAL_MIN_SCORE=0.62                         # Min SEMANTIC cosine (before the BM25 bonus). Recalibrated 2026-08-22 over the 6 languages, ADR-242.
RAG_SPACES_MAX_CONTEXT_TOKENS=2000                          # Max context tokens injected
RAG_SPACES_BM25_BONUS_WEIGHT=0.05                           # Max bonus BM25 adds on top of the semantic score, to re-order what passed. 0 = no lexical re-ordering.
RAG_SPACES_EMBEDDING_MODEL=models/gemini-embedding-001      # Gemini embedding model for RAG
RAG_SPACES_EMBEDDING_DIMENSIONS=1536                        # Embedding dimensions (must match model)
RAG_SPACES_MAX_CHUNKS_PER_DOCUMENT=500                      # Max chunks per document (default: 500)
RAG_SPACES_ALLOWED_TYPES=text/plain,text/markdown,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv,application/rtf,text/html,application/vnd.oasis.opendocument.text,application/vnd.oasis.opendocument.spreadsheet,application/vnd.oasis.opendocument.presentation,application/epub+zip,application/json,application/xml,text/xml  # Allowed MIME types (CSV)
RAG_SPACES_SYSTEM_ENABLED=true                              # Enable system RAG spaces (FAQ knowledge base) (default: true)
RAG_SPACES_SYSTEM_KNOWLEDGE_DIR=docs/knowledge              # Directory for system knowledge Markdown files (default: docs/knowledge)
RAG_SPACES_DRIVE_SYNC_ENABLED=true                          # Enable Google Drive folder sync for RAG Spaces (default: true)
RAG_DRIVE_MAX_SOURCES_PER_SPACE=5                           # Max Drive folder sources per space (default: 5)


# ============================================================================
# [65] SUB-AGENTS
# Config: src/core/config/agents.py
# ============================================================================
# Persistent Specialized Sub-Agents (F6).
# Reference: docs/technical/SUB_AGENTS.md

SUB_AGENTS_ENABLED=true                                     # Enable sub-agents

# Execution (also used as recursion_limit for the ReAct sub-agent loop, ADR-083)
SUBAGENT_DEFAULT_MAX_ITERATIONS=10                           # Max LLM iterations per execution (1-30). LangGraph counts each node visit; ~3-4 tool rounds + synthesis fit in 10.

# ADR-083 — H2 instruction cap (defends against raw-data inlining via $ref resolution)
SUBAGENT_INSTRUCTION_MAX_TOKENS_RESOLVED=3000               # Hard cap (tokens) on delegate_to_sub_agent_tool.instruction AFTER $ref expansion (blocks raw-data shoveling)

# Timeout (seconds) for a delegate_to_sub_agent_tool step in the parallel executor.
# The sub-agent runs a bounded ReAct loop (read-only toolset); slower reasoning models or
# multiple tool calls push the wall-clock budget above the generic MAX_TOOL_TIMEOUT_SECONDS,
# hence a dedicated floor/ceiling. Range: 30-600.
SUBAGENT_TOOL_TIMEOUT_SECONDS=180.0
# Hard ceiling (seconds) on the effective timeout of a delegate_to_sub_agent_tool step,
# even if the planner requests more. Lets you raise the sub-agent budget without
# touching the application-wide MAX_TOOL_TIMEOUT_SECONDS. Range: 60-900.
SUBAGENT_TOOL_MAX_TIMEOUT_SECONDS=300.0

# Web-research steps backed by an external LLM (unified_web_search_tool,
# perplexity_search_tool, perplexity_ask_tool): the Perplexity synthesis
# legitimately exceeds the generic 30 s default (measured in prod 2026-08).
# Floor (max(planner request, this)) / hard ceiling. Ranges: 30-300 / 60-600.
WEB_RESEARCH_TOOL_TIMEOUT_SECONDS=60.0
MAX_WEB_RESEARCH_TOOL_TIMEOUT_SECONDS=180.0

# Comma-separated whitelist of tool names the ReAct sub-agent may call.
# Empty = legacy blocklist-only behavior (~80 tools exposed). With the default
# (brave_search + fetch_web_page) the sub-agent stays focused on factual
# verification instead of exploring the full catalogue and hitting
# GraphRecursionError.
SUBAGENT_RESEARCH_TOOLS_WHITELIST=brave_search_tool,fetch_web_page_tool


