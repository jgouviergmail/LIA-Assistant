# Config: src/core/config/usage_limits.py
# ============================================================================

USAGE_LIMITS_ENABLED=true                                   # Enable per-user usage limits

# Default Limits (applied at user creation, comment out or leave empty for unlimited)
# DEFAULT_TOKEN_LIMIT_PER_CYCLE=500000
# DEFAULT_MESSAGE_LIMIT_PER_CYCLE=1000
# DEFAULT_COST_LIMIT_PER_CYCLE_EUR=50.00
# DEFAULT_TOKEN_LIMIT_ABSOLUTE=
# DEFAULT_MESSAGE_LIMIT_ABSOLUTE=
# DEFAULT_COST_LIMIT_ABSOLUTE_EUR=

# Instance-wide daily spend ceiling (euros, every cost family included).
# Bounds what the WHOLE deployment may spend in a UTC day, where the limits
# above bound what ONE account consumes. Leave commented for no ceiling.
# An administrator can lower it from Settings > Administration, never raise it.
# Mandatory for a public demonstrator, where every visitor holds an account.
# INSTANCE_DAILY_BUDGET_EUR=1.00

# Cache
USAGE_LIMIT_CACHE_TTL_SECONDS=60                            # Usage limit cache TTL (default: 60)


# Deployment ceilings for the administrable capabilities. Each is the OUTER
# bound: an administrator can lower it from Settings > Administration, never
# raise it. Leaving them at true keeps today's behaviour.
# VOICE_TTS_ENABLED=true
# WEB_SEARCH_ENABLED=true
# BROWSER_ENABLED=true

# ============================================================================
# [XX] PUBLIC DEMONSTRATOR
# Config: src/core/config/demo.py
# ============================================================================

# Whether THIS instance is a public demonstrator. Never enable it on a private
# instance: verifying an email would activate the account without approval,
# and the nightly job would wipe every non-admin account.
# DEMO_MODE_ENABLED=false

# Identifier of the terms a visitor accepts at registration, recorded on the
# account. Bump it whenever the terms change — a consent with no version
# cannot be defended later.
# DEMO_TERMS_VERSION=2026-08-06

# Nightly visitor-account wipe (UTC), so the next day starts from zero.
# DEMO_ACCOUNT_PURGE_HOUR=2
# DEMO_ACCOUNT_PURGE_MINUTE=30

# ============================================================================
# [67b] WEB RISK URL SCREENING (lot D, 2026-08)
# Config: src/core/config/security.py — client: src/infrastructure/security/web_risk.py
# Screens URLs fetched/browsed by the assistant against Google Web Risk
# (malware, phishing). Uses the platform GOOGLE_API_KEY (enable the Web Risk
# API + add it to the key's API allowlist in the Google Cloud console).
# Fail-open: screening unavailability never blocks browsing.
# ============================================================================

WEB_RISK_ENABLED=false                                      # Enable Web Risk URL screening
WEB_RISK_TIMEOUT_SECONDS=3.0                                # HTTP timeout for uris:search
WEB_RISK_CLEAN_TTL_SECONDS=3600                             # Redis TTL for clean verdicts

# Street View thumbnails (lot SV, 2026-08) — location/place cards.
# Availability pre-checked via the FREE metadata endpoint; images $2/1000.
STREET_VIEW_ENABLED=true                                    # Street View thumbnails on cards

# ============================================================================
# [68] RATE LIMITING
# Config: src/core/config/security.py
# ============================================================================

RATE_LIMIT_ENABLED=true                                     # Enable global rate limiting
RATE_LIMIT_PER_MINUTE=60                                    # HTTP requests per minute per user

# SEC-016 — ceiling actually enforced by RateLimitMiddleware (Redis-backed,
# shared across uvicorn workers). A FLOOD BACKSTOP: the specialised limiters
# (login, register, export, static maps, DevOps, tools) stay stricter and keep
# doing the business enforcement. Sized from measurement — one browser session
# on a single page was observed at 67 req/min — so it never fires on real use.
# Redis unavailable => fail-open (a cache outage must not become an API outage);
# the unprotected window is counted by `http_rate_limit_degraded_total` and
# alerted by `GlobalRateLimitDegraded` (alerts-core, ADR-119).
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_BURST=10                                         # Burst allowance
RATE_LIMIT_SCOPE=user                                       # valid: user (per-user), global (shared)

# Tool Rate Limits (all tools: Contacts, Gmail, Calendar, Tasks, etc.)
RATE_LIMIT_DEFAULT_READ_CALLS=20                            # Read operations per window
RATE_LIMIT_DEFAULT_READ_WINDOW=60                           # Read rate limit window (seconds)
