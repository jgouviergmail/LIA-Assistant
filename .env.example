# Alert rules & thresholds: infrastructure/observability/prometheus/
# ============================================================================

ALERTMANAGER_SMTP_SMARTHOST=CHANGE_ME_SMTP_HOST:587         # SMTP server:port
ALERTMANAGER_SMTP_AUTH_USERNAME=CHANGE_ME_SMTP_USERNAME      # SMTP auth username
ALERTMANAGER_SMTP_AUTH_PASSWORD=CHANGE_ME_SMTP_PASSWORD      # SMTP auth password
APPLICATION_SMTP_FROM=noreply@yourdomain.com                # Application email sender
ALERTMANAGER_SMTP_FROM=alerts@yourdomain.com                # Monitoring alert sender
ALERTMANAGER_BACKEND_TEAM_EMAIL=your-email@example.com      # Backend alerts recipient
ALERTMANAGER_FINANCE_TEAM_EMAIL=your-email@example.com      # Finance alerts recipient
ALERTMANAGER_SECURITY_TEAM_EMAIL=your-email@example.com     # Security alerts recipient
ALERTMANAGER_ML_TEAM_EMAIL=your-email@example.com           # ML/AI alerts recipient
# Slack webhook for critical alerts (optional)
ALERTMANAGER_SLACK_WEBHOOK_CRITICAL=
# Slack webhook for warning alerts (optional)
ALERTMANAGER_SLACK_WEBHOOK_WARNING=
# Slack webhook for security alerts (optional)
ALERTMANAGER_SLACK_WEBHOOK_SECURITY=
# PagerDuty routing key (optional)
ALERTMANAGER_PAGERDUTY_ROUTING_KEY=

# Logwatch daily digest (system log summary emailed by cron on the prod host).
# Rendered into infrastructure/logwatch/conf/logwatch.conf at deploy time.
LOGWATCH_MAILTO=your-email@example.com                      # Daily logwatch digest recipient
LOGWATCH_MAILFROM=logwatch@yourdomain.com                   # Daily logwatch digest sender

# End-to-end public URL probe (blackbox-exporter). Set in production to the
# real public URL (e.g. https://lia.yourdomain.com) — feeds PublicEndpointDown
# and CertificateExpirySoon. Leave EMPTY in development (probe disabled).
BLACKBOX_PUBLIC_PROBE_URL=


# ============================================================================
# [21] SCORING — Intent Detection
# Config: src/core/config/agents.py
# ============================================================================
# Determines confidence in the user intent: search, details, create, chat, etc.

SEMANTIC_INTENT_FALLBACK_THRESHOLD=0.7                      # Below = uncertain intent, use fallback (default: 0.50)
SEMANTIC_INTENT_HIGH_THRESHOLD=0.85                         # Above = certain intent (default: 0.75)
SEMANTIC_FALLBACK_THRESHOLD=0.75                            # Global fallback safety net (default: 0.4)


# ============================================================================
# [22] SCORING — Domain Selection
# Config: src/core/config/agents.py
# ============================================================================
# Softmax temperature calibration to amplify score differences between domains.

V3_DOMAIN_SOFTMAX_TEMPERATURE=0.8                           # Softmax temperature (lower = stronger discrimination, recommended: 0.1)
V3_DOMAIN_CALIBRATED_PRIMARY_MIN=0.75                       # Min calibrated score for primary domain
V3_DOMAIN_MIN_RANGE_FOR_DISCRIMINATION=0.03                 # Min raw score range for meaningful discrimination
SEMANTIC_DOMAIN_MAX_DOMAINS=3                               # Max domains selected per query (default: 3)


# ============================================================================
# [23] SCORING — Routing Decision
# Config: src/core/config/agents.py
# ============================================================================
# Decides: chat (direct response, ~500 tokens) vs planner (tool execution, ~3000-6000 tokens).
# TOKEN IMPACT: Critical — bad routing wastes 5000+ tokens.

V3_ROUTING_HIGH_SEMANTIC_THRESHOLD=0.8                      # Above = clearly planner (default: 0.7)
V3_ROUTING_CHAT_SEMANTIC_THRESHOLD=0.7                      # Below = clearly chat (default: 0.4)
V3_ROUTING_MIN_CONFIDENCE=0.75                              # Min confidence for planner in ambiguous zone (default: 0.6)
V3_ROUTING_CHAT_OVERRIDE_THRESHOLD=0.85                     # Chat intent override when confidence >= this (default: 0.85)
V3_ROUTING_CROSS_DOMAIN_THRESHOLD=0.5                       # Cross-domain reference routing threshold (default: 0.5)
ROUTER_CONFIDENCE_HIGH=0.8                                  # High confidence threshold for router decisions (default: 0.8)
ROUTER_CONFIDENCE_MEDIUM=0.6                                # Medium confidence threshold (default: 0.6)
ROUTER_CONFIDENCE_LOW=0.4                                   # Low confidence threshold (default: 0.4)
ROUTER_DEBUG_LOG_ENABLED=false                              # Enable separate debug log for router reasoning (default: false)
ROUTER_DEBUG_LOG_PATH=/var/log/lia/router_debug.log         # Path for router debug log file (default: /var/log/lia/router_debug.log)
V3_DOMAIN_SCORE_DELTA_MIN=0.05                              # Min score delta between top and secondary domains (default: 0.05)
V3_DOMAIN_SECONDARY_THRESHOLD=0.80                          # Min absolute score for secondary domains (default: 0.80)
SEMANTIC_DOMAIN_HARD_THRESHOLD=0.75                         # Hard threshold for domain selection (default: 0.75)
SEMANTIC_DOMAIN_SOFT_THRESHOLD=0.65                         # Soft threshold for domain selection (default: 0.65)


# ============================================================================
# [24] SCORING — Tool Selection
# Config: src/core/config/agents.py
# ============================================================================
# Filters tools sent to LLM. Fewer tools = shorter prompt = fewer tokens + hallucinations.

V3_TOOL_SOFTMAX_TEMPERATURE=0.1                             # Softmax temperature for tool scoring (0.1 = strong discrimination)
V3_TOOL_CALIBRATED_PRIMARY_MIN=0.07                         # Min calibrated score for primary tool
SEMANTIC_TOOL_SELECTOR_MAX_TOOLS=8                          # Max tools sent to LLM per query
V3_TOOL_SELECTOR_HYBRID_ENABLED=true                        # Enable hybrid scoring (description + keywords) (default: true)
V3_TOOL_SELECTOR_HYBRID_ALPHA=0.6                           # Hybrid weight: semantic vs keyword (default: 0.6)
V3_TOOL_SELECTOR_HYBRID_MODE=first_line                     # Hybrid mode: first_line or full (default: first_line)
TOOL_EMBEDDINGS_CACHE_DIR=data/tool_cache                   # Tool-embeddings disk cache; relative = from apps/api. MUST be a mounted volume in prod (see docker-compose.prod.yml)
TOOL_EMBEDDINGS_CACHE_CLAIM_TIMEOUT_SECONDS=40              # Wait for a peer already computing the tool embeddings before computing them too. 0 = every worker computes (pre-v1.25.27)


# ============================================================================
# [25] SCORING — Context Resolution
# Config: src/core/config/agents.py
# ============================================================================
# Resolves contextual references ("the 2nd", "that one", "this appointment").

CONTEXT_REFERENCE_CONFIDENCE_THRESHOLD=0.7                  # Min confidence to validate a context resolution (default: 0.7)
CONTEXT_REFERENCE_RESOLUTION_ENABLED=true                   # Enable reference resolution for follow-up questions (default: true)
CONTEXT_ACTIVE_WINDOW_TURNS=3                               # Active context window in conversation turns (default: 3)
CONTEXT_CURRENT_ITEM_CONFIDENCE=0.95                        # Confidence for current item references (default: 0.95)
CONTEXT_DEMONSTRATIVE_CONFIDENCE=0.8                        # Confidence for demonstrative references (default: 0.8)
CONTEXT_RESOLUTION_TIMEOUT_MS=500                           # Timeout for context resolution in ms (default: 500)
DEFAULT_ITEM_CONFIDENCE=0.5                                 # Default confidence when items lack explicit score (default: 0.5)
QUERY_ENGINE_SIMILARITY_THRESHOLD=0.93                      # Duplicate query detection (SequenceMatcher, not embeddings). Calibrated 2026-04-09.


# ============================================================================
# [26] SCORING — Semantic Validation
# Config: src/core/config/agents.py
# ============================================================================
# Post-execution: verifies tool results answer the user question.

SEMANTIC_VALIDATION_CONFIDENCE_THRESHOLD=0.70               # Min confidence to validate results vs question (default: 0.8)
SEMANTIC_VALIDATION_TIMEOUT_SECONDS=20.0                    # Timeout for semantic validation LLM call
SEMANTIC_VALIDATION_FALLBACK_CONFIDENCE=0.5                 # Fallback confidence when validation uses fallback mode (default: 0.5)
SEMANTIC_VALIDATOR_PROMPT_VERSION=v1                         # Semantic validator prompt version (default: v1)
V3_DISPLAY_ENABLED=true                                     # Enable v3 display formatting (default: true)


# ============================================================================
# [27] SCORING — HITL Classification
# Config: src/core/config/agents.py
# ============================================================================
# Controls when to ask user confirmation/clarification.

HITL_CLASSIFIER_CONFIDENCE_THRESHOLD=0.7                    # Min confidence to classify HITL response (default: 0.7)
HITL_AMBIGUOUS_CONFIDENCE_THRESHOLD=0.7                     # Below = response deemed ambiguous (default: 0.7)
HITL_FUZZY_MATCH_AMBIGUITY_THRESHOLD=0.05                   # Score gap below which two options are ambiguous (default: 0.05)
HITL_LOW_CONFIDENCE_THRESHOLD=0.5                           # Below = inferred rejection (default: 0.5)
HITL_DEMOTION_CONFIDENCE=0.5                                # Confidence threshold when demoting EDIT to AMBIGUOUS (default: 0.5)
HITL_MAX_WAIT_SECONDS=900                                   # Max wait time for HITL user response in seconds (default: 900)
HITL_PENDING_DATA_TTL_SECONDS=3600                          # TTL for pending HITL data in Redis (default: 3600)
HITL_DETECTION_CACHE_TTL_SECONDS=5                          # In-memory pending-HITL detection cache TTL; bounds cross-worker staleness (default: 5)
HITL_CLASSIFIER_PROMPT_VERSION=v1                           # HITL classifier prompt version (default: v1)
HITL_QUESTION_GENERATOR_PROMPT_VERSION=v1                   # HITL question generator prompt version (default: v1)
HITL_PLAN_APPROVAL_QUESTION_PROMPT_VERSION=v1               # HITL plan approval question prompt version (default: v1)
APPROVAL_COST_THRESHOLD_USD=5.00                            # Cost threshold in USD triggering approval (default: 5.00)
APPROVAL_AUTO_APPROVE_ROLES=["admin","power_user"]                # JSON list of roles that auto-approve (default: admin,power_user)
APPROVAL_SENSITIVE_CLASSIFICATIONS=["CONFIDENTIAL","RESTRICTED"]  # JSON list of sensitive classifications (default: CONFIDENTIAL,RESTRICTED)
INSUFFICIENT_CONTENT_MIN_CHARS_THRESHOLD=30                 # Min chars after pattern removal for sufficient content


# ============================================================================
# [30] SCORING — Evaluator Latency SLA
# Config: src/core/config/observability.py
# ============================================================================
# SLA thresholds for Langfuse evaluator quality metrics.

EVALUATOR_LATENCY_EXCELLENT_THRESHOLD_MS=500.0              # Below = excellent score
EVALUATOR_LATENCY_GOOD_THRESHOLD_MS=1000.0                  # Below = good score
EVALUATOR_LATENCY_ACCEPTABLE_THRESHOLD_MS=2000.0            # Below = acceptable score
EVALUATOR_LATENCY_SLOW_THRESHOLD_MS=5000.0                  # Above = slow score


# ============================================================================
# [31] STATE & HISTORY MANAGEMENT
# Config: src/core/config/agents.py
# ============================================================================

AGENT_MAX_ITERATIONS=20                                     # LangGraph graph recursion limit (default: 10, hard limit: 50)
MAX_MESSAGES_HISTORY=150                                    # Max messages in LangGraph state (default: 1000)
MAX_TOKENS_HISTORY=200000                                   # Token threshold before auto-truncation (default: 200000)
AGENT_HISTORY_KEEP_LAST=30                                  # Recent messages kept in ReAct agent context (default: 30)
MAX_CONTEXT_BATCH_SIZE=10                                   # Max items returned by get_context_list (default: 10)
MAX_AGENT_RESULTS=10                                        # Max agent_results kept in memory per turn (default: 10)
V3_DISPLAY_MAX_ITEMS_PER_DOMAIN=5                           # Max items per domain in multi-domain responses
MAX_ROUTING_HISTORY=30                                      # Max routing history entries kept (default: 30)
REGISTRY_MAX_ITEMS=75                                       # Max items in data_registry per conversation (default: 100)

# LLM Windowing (Token Optimization) — number of conversation TURNS sent to LLM
# Note (ADR-094): router/planner/orchestrator window vars removed (helpers never wired).
DEFAULT_MESSAGE_WINDOW_SIZE=4                               # Default windowing fallback (default: 4)
RESPONSE_MESSAGE_WINDOW_SIZE=10                             # Response: creative synthesis (default: 10)
RESPONSE_RECENT_ENTITIES_MAX_TURN_AGE=3                     # Max age (turns) of tool-context entities re-grounded when a turn produces no data (0 disables)

# Global API Security Limits
API_MAX_ITEMS_PER_REQUEST=25                                # Global hard ceiling on items per external API item search/list call (default: 25)


# ============================================================================
# [32] LONG-TERM MEMORY
# Config: src/core/config/agents.py
# ============================================================================

# Embedding Model (OpenAI text-embedding-3-small: 1536 dims)
MEMORY_EXTRACTION_ENABLED=true                              # Enable background memory extraction from conversations (default: true)
MEMORY_EMBEDDING_MODEL=models/gemini-embedding-001          # Gemini embedding model for memory search
MEMORY_EMBEDDING_DIMENSIONS=1536                            # Must match model dimensions
INTEREST_EMBEDDING_MODEL=models/gemini-embedding-001        # Gemini embedding model for interest dedup
INTEREST_EMBEDDING_DIMENSIONS=1536                          # Must match model dimensions
MEMORY_MAX_RESULTS=25                                       # Max memories to retrieve per query
MEMORY_EXTRACTION_MESSAGE_MAX_CHARS=3000                    # Max chars per message for extraction
MEMORY_EXTRACTION_MAX_TOKENS=1000                           # Max tokens for memory extraction LLM response (default: 1000)
MEMORY_EXTRACTION_TOP_P=1.0                                 # Top-p for memory extraction LLM (default: 1.0)
MEMORY_EXTRACTION_FREQUENCY_PENALTY=0.0                     # Frequency penalty for memory extraction LLM (default: 0.0)
MEMORY_EXTRACTION_PRESENCE_PENALTY=0.0                      # Presence penalty for memory extraction LLM (default: 0.0)

# Memory Search Thresholds
MEMORY_MIN_SEARCH_SCORE=0.70                                # Calibrated for Gemini embedding-001 (2026-04-09). Realistic bank: 1-4 results/query.
MEMORY_RELEVANCE_THRESHOLD=0.76                             # Min score for usage_count++ (purge protection). Match p75=0.735.

# Memory Deduplication (extraction-time contradiction detection)
MEMORY_DEDUP_SEARCH_LIMIT=10                                # Max candidates checked for semantic duplicates at extraction time
MEMORY_DEDUP_MIN_SCORE=0.4                                  # Min similarity for dedup candidates (lower = more contradictions caught, slightly more tokens)

# Background extraction safety (shared by memory + interests)
EXTRACTION_MAX_DELETES_PER_RUN=2                            # Max deletions one extraction may apply; above it they are all dropped (0 = none)

# Hybrid Search (BM25 + Semantic)
MEMORY_BM25_CACHE_MAX_USERS=100                             # BM25 local cache LRU limit (default: 100)

# Memory Reference Resolution (Pre-Planner Entity Resolution)
MEMORY_REFERENCE_RESOLUTION_TIMEOUT_MS=5000                 # Timeout for resolving relational references

# Memory Purge Configuration
# Retention score = weight_importance * importance + weight_recency * recency_factor
# recency_factor decays linearly from 1.0 (new) to 0.0 over MEMORY_RECENCY_DECAY_DAYS.
MEMORY_INVALIDATED_RETENTION_DAYS=90                        # ADR-235: days an invalidated memory (supersession trail) is kept before purge (7-730)
HEARTBEAT_OFFERS_WINDOW_DAYS=7                              # Lot 5-C2: days an undecided missed-routine offer stays listed in the proposals inbox (1-90)
REACT_ADAPTIVE_BUDGET_ENABLED=false                         # ADR-238: scale the ReAct iteration budget with the query's domain span (max stays the ceiling)
REACT_ITERATIONS_BASE=6                                     # ADR-238: adaptive budget of a single-domain query (1-50)
REACT_ITERATIONS_PER_EXTRA_DOMAIN=3                         # ADR-238: extra iterations per additional domain (0-20)
# If a memory has usage_count == 0 past the penalty age, its score is multiplied by
# MEMORY_USAGE_PENALTY_FACTOR (never-activated = suspect).
# A memory is purged if its final score < MEMORY_PURGE_THRESHOLD.
MEMORY_CLEANUP_HOUR=4                                       # Cleanup job hour (UTC)
MEMORY_CLEANUP_MINUTE=0                                     # Cleanup job minute
MEMORY_MIN_AGE_FOR_CLEANUP_DAYS=7                           # Grace period before a memory becomes purge-eligible
MEMORY_RECENCY_DECAY_DAYS=45                                # Horizon over which recency_factor decays to 0
MEMORY_USAGE_PENALTY_AGE_DAYS=30                            # Age threshold for applying zero-usage penalty
MEMORY_USAGE_PENALTY_FACTOR=0.5                             # Multiplier on score when usage_count==0 past threshold
MEMORY_RETENTION_WEIGHT_IMPORTANCE=0.7                      # Importance factor weight (dominant signal)
MEMORY_RETENTION_WEIGHT_RECENCY=0.3                         # Recency factor weight
MEMORY_PURGE_THRESHOLD=0.5                                  # Retention score below this = purged
MEMORY_PURGE_AT_RISK_MARGIN=0.1                             # Score band above threshold flagged "at risk" in API (UI hint only)

# Memory Consolidation (daily semantic deduplication of near-identical memories)
# Runs at 5 AM UTC by default, right after the cleanup job. Merges pairs with
# cosine similarity >= MEMORY_CONSOLIDATION_SIMILARITY_THRESHOLD, excluding
# pinned memories, differing categories, and pairs with divergent affect.
MEMORY_CONSOLIDATION_ENABLED=true                           # Enable daily consolidation job
MEMORY_CONSOLIDATION_HOUR=5                                 # UTC hour for the job
MEMORY_CONSOLIDATION_SIMILARITY_THRESHOLD=0.9               # Min cosine similarity to merge
MEMORY_CONSOLIDATION_MAX_PAIRS_PER_USER=50                  # Cap per user per run (blast radius)
MEMORY_CONSOLIDATION_EMOTIONAL_DIFF_SKIP=5                  # Skip pair if |weight_a - weight_b| > this


# ============================================================================
# [33] CIRCUIT BREAKER
# Config: src/core/config/agents.py
# ============================================================================
# Protects against failure cascades when external services are down.
# Pattern: closed -> open (after N failures) -> half-open -> closed/open

CIRCUIT_BREAKER_FAILURE_THRESHOLD=3                         # Consecutive failures before circuit opens (default: 5)
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3                         # Successes needed to close circuit (default: 3)
CIRCUIT_BREAKER_TIMEOUT_SECONDS=10                          # Duration before recovery attempt (default: 60)
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=3                       # Calls allowed in half-open to test (default: 3)


