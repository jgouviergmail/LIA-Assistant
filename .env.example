# [62] SKILLS
# Config: src/core/config/skills.py
# ============================================================================
# agentskills.io standard. Reference: docs/technical/SKILLS_INTEGRATION.md

SKILLS_ENABLED=true                                         # Enable skills feature
SKILLS_SYSTEM_PATH=data/skills/system                       # Admin/system skills directory (git-tracked)
SKILLS_USERS_PATH=data/skills/users                         # User-imported skills directory
SKILL_SCRIPT_ONLY_CUMULATES_NATIVE_PLAN=true                # Script-only skills: keep the domain's native plan steps AND run the skill (false = historical empty-plan bypass)
SKILLS_MAX_PER_USER=20                                      # Max skills per user (1-100)
SKILLS_CHAT_IMPORT_ENABLED=true                             # Allow the skill-generator to import a generated skill directly from chat
SKILLS_ZIP_MAX_DECOMPRESSED_KB=2048                         # Max decompressed size of an imported package (zip-bomb guard, 100-51200 KB)
SKILLS_ZIP_MAX_FILES=64                                     # Max number of files in an imported package (1-512)
SKILLS_URL_IMPORT_ENABLED=true                              # Enable POST /skills/import-from-url (https-only, SSRF-validated)
SKILLS_URL_IMPORT_MAX_BYTES=5242880                         # Streamed download cap for URL skill imports (bytes, 1024-52428800)
SKILLS_URL_IMPORT_TIMEOUT_SECONDS=15                        # Total HTTP timeout for URL skill imports (seconds, 1-120)
SKILLS_URL_IMPORT_RATE_MAX_CALLS=10                         # Per-user URL-import attempts per window (1-1000)
SKILLS_URL_IMPORT_RATE_WINDOW_SECONDS=3600                  # Sliding window for the URL-import rate limit (60-86400 s)
SKILLS_SCRIPTS_ENABLED=true                                 # Enable Python script execution from skills
SKILLS_SCRIPT_TIMEOUT_SECONDS=30                            # Script execution timeout (5-120s)
SKILLS_SCRIPT_MAX_OUTPUT_KB=50                              # Max script output size (1-500 KB)
SKILLS_SCRIPT_MAX_INPUT_KB=100                              # Max script input size (1-500 KB)
# Skill subprocess sandbox (audit A1/A2 — bounds blast radius + denies Docker socket)
SKILLS_SCRIPT_MAX_MEMORY_MB=512                             # RLIMIT_AS address-space ceiling (64-4096)
SKILLS_SCRIPT_MAX_PROCESSES=64                              # RLIMIT_NPROC — fork-bomb guard (1-1024)
SKILLS_SCRIPT_MAX_FILE_SIZE_MB=10                           # RLIMIT_FSIZE — max file a script may write (1-1024)
SKILLS_SCRIPT_MAX_CPU_SECONDS=30                            # RLIMIT_CPU — CPU-time ceiling (1-300)
SKILLS_SCRIPT_DROP_PRIVILEGES=true                          # Drop skill scripts to unprivileged uid when API runs as root
SKILLS_SCRIPT_UNPRIVILEGED_UID=65534                        # Target uid for dropped scripts (default: nobody)
SKILLS_SCRIPT_UNPRIVILEGED_GID=65534                        # Target gid for dropped scripts (default: nogroup)
# SEC-001 — throwaway-container sandbox (the real isolation; the rlimits above
# only protect when the API runs as root, which it does not in production).
SKILLS_SCRIPT_SANDBOX=container                             # container (secure default) | subprocess (legacy, no socket isolation)
SKILLS_SCRIPT_SANDBOX_IMAGE=lia-api:local                   # Image running the script — pinned per environment in docker-compose
SKILLS_SCRIPT_SANDBOX_PYTHONPATH=/home/appuser/.local/lib/python3.14/site-packages  # Where `pip install --user` put the deps
SKILLS_SCRIPT_SANDBOX_TMPFS_MB=32                           # Writable /tmp inside the sandbox (1-512 MB)


