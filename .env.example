BRIEFING_MAX_TASKS_ITEMS=5                                  # Max pending/overdue tasks on the tasks card (1-20)
BRIEFING_TASKS_HORIZON_DAYS=7                               # Tasks card look-ahead: overdue + due within N days (1-30)
BRIEFING_MAX_DOCUMENTS_ITEMS=5                              # Max recently-modified Drive files on the documents card (1-20)
BRIEFING_LAST_GOOD_TTL_SECONDS=172800                       # D-04 stale-while-error: how long the last known-good card payload backs a connector error (0 disables)
BRIEFING_AUDIO_MAX_CHARS=1600                               # A2: max characters accepted by POST /briefing/synthesis/audio (cost bound, 100-10000)
BRIEFING_AUDIO_MAX_SENTENCES=12                             # A2: max sentences synthesized for the listen button (cost bound, 1-50)
RELATIONS_MAX_ITEMS=30                                      # N-09 personal CRM: max relationships listed on the overview (1-200)
RELATIONS_MAX_ITEMS_PER_SECTION=25                         # N-09 personal CRM: items returned per 360° section; the UI previews a few and reveals the rest (1-200)
RELATIONS_PROVIDER_SECTIONS_ENABLED=true                    # N-09 personal CRM: let the 360° view query the contacts/email/calendar connectors (false = strictly database-local)
RELATIONS_PROVIDER_WINDOW_DAYS=90                           # N-09 personal CRM: symmetric past/future window scanned for shared events; the window is shown to the reader (1-365)
RELATIONS_PROVIDER_EMAIL_WINDOW_DAYS=365                    # N-09 personal CRM: how far back mail is searched for one relationship; bounds relevance, not quota (1-3650)
RELATIONS_PROVIDER_MAX_ADDRESSES=3                          # N-09 personal CRM: addresses of one contact card queried for mail/calendar; each costs three mail searches: from, to, cc (1-10)
RELATIONS_PROVIDER_MAX_ITEMS=10                             # N-09 personal CRM: items rendered per provider-backed section (1-50)
RELATIONS_PROVIDER_EMAIL_EXCERPT_MAX_CHARS=220                # N-09 personal CRM: length of the excerpt shown under an exchanged message; it is the provider's own search preview, so it costs no extra call (40-1000)
RELATIONS_PROVIDER_RATE_LIMIT_CALLS=30                      # N-09 personal CRM: per-user budget of provider-backed 360° reads per window; each costs several external API calls (1-1000)
RELATIONS_PROVIDER_RATE_LIMIT_WINDOW_SECONDS=60             # N-09 personal CRM: sliding window in seconds for the budget above (1-3600)
BRIEFING_HEALTH_WINDOW_DAYS=14                              # Rolling window (days) for health card per-kind averages (1-90)
BRIEFING_WEATHER_DAILY_FORECAST_DAYS=5                      # Forecast days on the weather card (max 5 — OpenWeatherMap free tier)


# ============================================================================
# [80] DATABASE BACKUP (PostgreSQL pg_dump sidecar — ADR-109)
# Consumed by docker-compose only (postgres-backup service), NOT by the API —
# there is intentionally no Settings module for these.
# Runbook (manual backup / restore / verify): docs/runbooks/DATABASE_BACKUP_RESTORE.md
# ============================================================================

POSTGRES_BACKUP_SCHEDULE=@daily                             # Cron schedule (evaluated in POSTGRES_BACKUP_TZ; @daily = 00:00)
POSTGRES_BACKUP_KEEP_DAYS=7                                 # Daily backups retained
POSTGRES_BACKUP_KEEP_WEEKS=4                                # Weekly backups retained
POSTGRES_BACKUP_KEEP_MONTHS=6                               # Monthly backups retained
POSTGRES_BACKUP_EXTRA_OPTS=-Z6 --clean --if-exists          # pg_dump options: gzip level 6 + self-cleaning restore (no schema filter)
POSTGRES_BACKUP_TZ=Etc/UTC                                  # Timezone for SCHEDULE evaluation (@daily = midnight in this TZ)
POSTGRES_BACKUP_HOST_DIR=../lia-data/postgres-backups       # PROD compose only: host dir receiving dumps (chmod 700), OUTSIDE the deployed directory so a deploy cannot erase them. Dev uses the postgres_backups named volume.



# ============================================================================
# [81] BACKGROUND CHAT RUNS (ADR-117) — detached generation surviving disconnects
# ============================================================================

BACKGROUND_RUNS_ENABLED=false                               # Master switch: detached producer + Redis Streams broker (false = legacy inline SSE path)
BACKGROUND_RUNS_STREAM_MAXLEN=10000                         # Approximate XADD MAXLEN cap per run stream (100-100000)
BACKGROUND_RUNS_STREAM_TTL_SECONDS=3600                     # Stream EXPIRE once the terminal marker is published (60-86400)
BACKGROUND_RUNS_STREAM_SAFETY_TTL_SECONDS=7200              # Safety EXPIRE NX armed at the FIRST chunk; bounds the key if the producer hard-dies without a terminal marker; must be >= STREAM_TTL and exceed the longest run (600-172800)
BACKGROUND_RUNS_XREAD_BLOCK_MS=2000                         # Subscriber XREAD block window; keep well below REDIS_SOCKET_TIMEOUT*1000 (250-15000)
BACKGROUND_RUNS_DRAIN_TIMEOUT_SECONDS=45                     # Shutdown: max wait for in-flight chat producers (5-300)
SHUTDOWN_BACKGROUND_TASKS_TIMEOUT_SECONDS=15                 # Shutdown: max wait for generic fire-and-forget tasks (1-120)
BACKGROUND_RUNS_ACTIVE_TTL_SECONDS=15                       # Active-run lock TTL; heartbeat-kept, frees a killed run's conversation in <= this (5-120)
BACKGROUND_RUNS_HEARTBEAT_SECONDS=5                         # Producer heartbeat period; keep under ACTIVE_TTL/2 (1-60)
BACKGROUND_RUNS_LISTENER_TTL_SECONDS=30                     # Subscriber-presence counter TTL; voice synthesis skipped at 0 listeners (5-300)
BACKGROUND_RUNS_CANCEL_POLL_SECONDS=1                       # Producer poll period for the stop-button signal; bounds cancel latency (1-10)
BACKGROUND_RUNS_CANCEL_TTL_SECONDS=600                      # Cancel-signal key TTL; self-cleans if the producer already died (30-3600)
BACKGROUND_RUNS_ORPHAN_GRACE_SECONDS=20                     # Subscriber orphan exit: run-lock missing AND no chunk for this long -> synthetic error; must be >= 2x HEARTBEAT (5-300)

# ============================================================================
# [82] STRONG AUTHENTICATION — MFA / Passkeys (security program D1)
# ============================================================================

MFA_ENABLED=false                                           # Master switch: WebAuthn/TOTP routers not mounted when false
# WEBAUTHN_RP_ID: Relying Party ID (domain seen by the browser); empty = derived from FRONTEND_URL host.
# NOTE: no inline comment on empty-valued variables — docker compose would pass the comment AS the value.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=LIA                                        # Name shown by authenticators during ceremonies
# WEBAUTHN_EXPECTED_ORIGIN: expected browser origin for ceremony verification; empty = FRONTEND_URL.
WEBAUTHN_EXPECTED_ORIGIN=
WEBAUTHN_CHALLENGE_TTL_SECONDS=300                          # Pending ceremony challenge TTL in Redis, single-use (60-900 sensible)
MFA_MAX_PASSKEYS_PER_USER=10                                # Cap of registered passkeys per account
MFA_PENDING_TTL_SECONDS=300                                 # Two-step login pending token lifetime (password OK -> TOTP code)
STEP_UP_WINDOW_SECONDS=300                                  # Freshness window of a step-up re-authentication for sensitive actions

# ============================================================================
# [83] ACCOUNT EXPORT — GDPR portability (security program D3)
# ============================================================================

ACCOUNT_EXPORT_ENABLED=false                                # Master switch: export router + executor
EXPORTS_STORAGE_PATH=data/exports                           # Built archives: {path}/{user_id}/{job_id}.zip
ACCOUNT_EXPORT_MAX_BYTES=2147483648                         # 2 GiB archive cap (A5); larger builds fail with export_too_large
ACCOUNT_EXPORT_RETENTION_HOURS=24                           # Download window; the sweep purges past it
ACCOUNT_EXPORT_STALE_RUNNING_MINUTES=30                     # RUNNING older than this = crashed -> failed

# ============================================================================
# [84] DOCUMENT GENERATION — AI document creation (ADR-226)
# Config: src/core/config/document_generation.py
# ============================================================================

DOCUMENT_GENERATION_ENABLED=true                            # Enable AI document generation feature
DOCUMENT_GENERATION_RATE_LIMIT_CALLS=10                     # Max generate_document calls per user per window
DOCUMENT_GENERATION_RATE_LIMIT_WINDOW=300                   # Rate limit window in seconds
DOCUMENT_GENERATION_MAX_SOURCE_CHARS=60000                  # source_data cap forwarded to the document LLM

# ============================================================================
# [99] PERF TOOLING (scripts/perf/measure_ttft.py — dev measurement only)
# Not read by the application; consumed by the TTFT measurement script.
# ============================================================================
LIA_PERF_BASE_URL=https://localhost:8000                     # Target API for the TTFT measurement script
# Dedicated perf user email (create with --register)
LIA_PERF_EMAIL=
# Dedicated perf user password
LIA_PERF_PASSWORD=

# ============================================================================
# [100] DEV/TEST TOOLING (test harness & maintenance scripts — never read by the app)
# ============================================================================
# Set to 1 by DB-promising CI/test jobs: an unreachable test DB then FAILS instead of skipping (F019)
LIA_REQUIRE_DB=
# Optional override for repo-root discovery in tests running from a container mount (tests/_repo_paths.py)
LIA_REPO_ROOT=
# Standard Docker variable; tests only INSPECT it to detect a remote daemon (never forced to loopback then).
# Empty value on purpose — NEVER put an inline comment here (docker compose AND Task dotenv would pass it as the value).
DOCKER_HOST=
PG_CONTAINER=lia-postgres-dev                                # Target PostgreSQL container for scripts/db/replay_check_local.py
API_CONTAINER=lia-api-dev                                    # Target API container for scripts/db/replay_check_local.py
# PostgreSQL superuser for the migration replay script (defaults to POSTGRES_USER)
PG_ADMIN_USER=

# Where the public demonstrator answers. The admin switch that SHOWS the link
# is separate (audited settings store, flipped from Administration): this is
# the deployment fact, and without it the switch stays inert and says so.
DEMO_INSTANCE_PUBLIC_URL=https://demo.example.org

# ============================================================================
# [78] ADAPTIVE THRESHOLDS (lot 7, audit 2026-08-19)
# ============================================================================
# Config: src/core/config/adaptive.py — per-user similarity thresholds moved
# inside HARD per-perimeter bounds (journal injection first). Kill-switch
# freezes everything to the static defaults.
ADAPTIVE_THRESHOLDS_ENABLED=true
ADAPTIVE_THRESHOLD_WINDOW_SIZE=50                           # Rolling top-score samples per (user, perimeter)
ADAPTIVE_THRESHOLD_MIN_SAMPLES=20                           # Samples required before any adjustment
ADAPTIVE_THRESHOLD_STEP=0.01                                # One bounded step per interval (hysteresis)
ADAPTIVE_THRESHOLD_ADJUST_INTERVAL_HOURS=24                 # Min hours between two adjustments
ADAPTIVE_THRESHOLD_STATE_TTL_DAYS=90                        # Sliding TTL of the per-user state key


# ============================================================================
# [85] ACTIVITY TIMELINE ("what LIA did for you" — evolution program Lot 1-A1)
# Config: src/core/config/activity.py (ActivitySettings)
# ============================================================================
ACTIVITY_TIMELINE_ENABLED=true                              # Master switch (router inclusion). Pure read: no scheduler, no LLM, no new table
ACTIVITY_TIMELINE_WINDOW_DAYS=30                            # Look-back window (days) of the aggregation (1-365)
ACTIVITY_TIMELINE_SOURCE_CAP=200                            # Max rows fetched per source; exact totals stay COUNT(*)-based and a hit cap is flagged `truncated` (10-1000)
ACTIVITY_TIMELINE_PAGE_SIZE=25                              # Default page size of the timeline API (5-100)
