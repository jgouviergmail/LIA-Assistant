# =============================================================================
# Logwatch Configuration - LIA Production Server (RPi5)
# TEMPLATE — rendered to /etc/logwatch/conf/logwatch.conf at deploy time by
# scripts/deploy/prepare-prod.ps1, substituting ${LOGWATCH_MAILTO} and
# ${LOGWATCH_MAILFROM} from .env (keeps personal addresses out of the public
# repo). Set both in your .env.prod — see .env.example / .env.prod.example.
# =============================================================================

# --- Output ---
Output = mail
Format = html
MailTo = ${LOGWATCH_MAILTO}
MailFrom = ${LOGWATCH_MAILFROM}
Subject = "LIA Prod - Rapport quotidien"

# --- Detail ---
# High = 10 (maximum detail for clear, comprehensive reports)
Detail = High
Range = yesterday

# --- Services ---
# All standard services + custom ones
Service = All

# Custom LIA services (auto-discovered from /etc/logwatch/conf/services/)
# - docker-lia : etat des conteneurs Docker LIA
# - cloudflared : sante du tunnel Cloudflare
