{
  "title": "22 - Compaction",
  "uid": "22-compaction",
  "tags": [
    "lia",
    "compaction"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "LIA",
      "type": "dashboards",
      "tags": [
        "lia"
      ],
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 10,
      "title": "Compactions (24h)",
      "type": "stat",
      "datasource": "$datasource",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "description": "Total compaction executions by strategy over the last 24h. Zero is normal when no conversation crossed the compaction threshold.",
      "targets": [
        {
          "expr": "sum(increase(compaction_executions_total[24h]))",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 11,
      "title": "Truncation Fallbacks (24h)",
      "type": "stat",
      "datasource": "$datasource",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "description": "Compaction runs that exceeded the global budget and fell back to truncation. Each one drops context quality and shows a user-visible notice — investigate if > 0.",
      "targets": [
        {
          "expr": "sum(increase(compaction_global_timeouts_total[24h]))",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 12,
      "title": "Errors (24h)",
      "type": "stat",
      "datasource": "$datasource",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "description": "Total compaction errors by type (retryable transient LLM errors, unexpected failures) over the last 24h.",
      "targets": [
        {
          "expr": "sum(increase(compaction_errors_total[24h]))",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 13,
      "title": "Writer Unavailable (24h)",
      "type": "stat",
      "datasource": "$datasource",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "description": "Compaction node fallbacks to a no-op stream writer (start/done events dropped). The user gets no compaction feedback in the chat — investigate if > 0.",
      "targets": [
        {
          "expr": "sum(increase(compaction_writer_unavailable_total[24h]))",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 1,
      "title": "Strategy mix",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "description": "Per-strategy compaction rate. Watch for 'truncation' spikes — they indicate global-timeout fallbacks.",
      "targets": [
        {
          "expr": "sum by (strategy) (rate(compaction_executions_total[$__rate_interval]))",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "truncation"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "End-to-end duration (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "description": "Distribution of compact() wall-clock duration (1h window — compactions are sparse). p99 above 90s is a warning sign; above 120s means the global timeout is firing.",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(compaction_total_duration_seconds_bucket[1h])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(compaction_total_duration_seconds_bucket[1h])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(compaction_total_duration_seconds_bucket[1h])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "row",
      "id": 101,
      "title": "Failure & retries",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 3,
      "title": "Per-chunk timeouts (rate)",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "description": "Rate of per-chunk asyncio.wait_for triggers. Tune COMPACTION_PER_CHUNK_TIMEOUT_SECONDS if this stays > 0. Empty panel = zero events in the window (healthy).",
      "targets": [
        {
          "expr": "rate(compaction_chunk_timeouts_total[$__rate_interval])",
          "legendFormat": "chunk_timeouts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "id": 4,
      "title": "Global timeouts → truncation (rate)",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "description": "Rate of whole-compact() global timeouts. Each one triggers the truncation fallback and a user-visible notice. Empty panel = zero events in the window (healthy).",
      "targets": [
        {
          "expr": "rate(compaction_global_timeouts_total[$__rate_interval])",
          "legendFormat": "global_timeouts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Errors by type (rate)",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "description": "LLM errors (retryable transient errors, unexpected failures) seen during compaction. Cross-reference with the strategy mix panel. Empty panel = zero events in the window (healthy).",
      "targets": [
        {
          "expr": "sum by (error_type) (rate(compaction_errors_total[$__rate_interval]))",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "row",
      "id": 102,
      "title": "Volume & savings",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 6,
      "title": "Skipped reasons (rate)",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "description": "Why compaction was skipped (below_threshold / too_few_messages / hitl_pending_* / disabled). Useful to validate threshold tuning.",
      "targets": [
        {
          "expr": "sum by (reason) (rate(compaction_skipped_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Tokens saved per compaction (p50/p95)",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "description": "How many tokens the compaction frees up (1h window — compactions are sparse). Truncation fallbacks usually save a lot; multi_chunk LLM compactions save a moderate amount.",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(compaction_tokens_saved_bucket[1h])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(compaction_tokens_saved_bucket[1h])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      }
    },
    {
      "id": 8,
      "title": "Compaction cost (tokens consumed)",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "description": "Total tokens consumed by compaction LLM calls (prompt + completion). This is the price paid to shrink the context — compare with tokens saved.",
      "targets": [
        {
          "expr": "sum by (token_type) (rate(compaction_cost_tokens_total[$__rate_interval]))",
          "legendFormat": "{{token_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 103,
      "title": "LLM call duration per chunk (p50/p95)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Duration of individual compaction LLM calls (one per chunk, 1h window). Compare with the per-chunk timeout setting.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(compaction_duration_seconds_bucket[1h])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(compaction_duration_seconds_bucket[1h])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
