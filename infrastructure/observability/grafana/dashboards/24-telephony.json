{
  "title": "24 - Telephony",
  "uid": "24-telephony",
  "tags": [
    "lia",
    "telephony",
    "calls"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "LIA",
      "type": "dashboards",
      "tags": [
        "lia"
      ],
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Calls",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "Calls (24h)",
      "type": "stat",
      "datasource": "$datasource",
      "description": "Outbound calls that reached a terminal state over the last 24h.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(telephony_calls_total[24h]))",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Calls by status (24h)",
      "type": "bargauge",
      "datasource": "$datasource",
      "description": "Terminal call statuses over the last 24h — failures stand out against completed calls.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum by (status) (increase(telephony_calls_total[24h]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Webhooks ignored (24h)",
      "type": "stat",
      "datasource": "$datasource",
      "description": "Post-call webhooks dropped by the foreign-filter / signature check. A sustained rise may signal probing or a misconfigured HMAC secret.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(telephony_webhook_ignored_total[24h]))",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Reaper recoveries (24h)",
      "type": "stat",
      "datasource": "$datasource",
      "description": "Return notifications + return syntheses recovered by the T1 reapers after a crash. Zero is nominal; recoveries mean a crash window was healed.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(telephony_notification_recovered_total[24h])) + sum(increase(telephony_return_recovered_total[24h])) or vector(0)",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Calls by status (rate)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Outbound calls reaching a terminal state, by status. Empty panel = zero events in the window (healthy).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(telephony_calls_total[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Call duration (p50/p95)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Billed-by-the-user call duration (1h window — calls are sparse). The hard cap is the agent's maximum duration on the ElevenLabs portal.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(telephony_call_duration_seconds_bucket[1h])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(telephony_call_duration_seconds_bucket[1h])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "id": 101,
      "title": "Recovery reapers (T1)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 7,
      "title": "Notification recoveries (by result)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Return notifications recovered by the reaper after a crash left them PENDING (T1). Empty panel = zero events in the window (healthy).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(telephony_notification_recovered_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Return synthesis recoveries (by result)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Return syntheses replayed by the reaper after a crash stranded the RECEIVED inbox before completion (T1 approach A). Empty panel = zero events in the window (healthy).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(telephony_return_recovered_total[$__rate_interval]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 103,
      "title": "Owner calls — relay into the chat (phone as a channel)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 10,
      "title": "Relay outcomes (by outcome)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "After LIA calls the account holder, what the person said is relayed into the chat as their own turn. answered/waiting = the turn ran (waiting = drafts to confirm); empty/not_owner/pending_question/busy/quota_blocked/failed = the person got a notification saying why. A labelled counter that never fired exposes no series: the fallback keeps the panel at 0 rather than « No data ».",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(telephony_relay_total[$__rate_interval])) or vector(0)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "Relays not run (24h)",
      "type": "stat",
      "datasource": "$datasource",
      "description": "Owner calls whose words did NOT become a chat turn over the last day (every outcome but answered/waiting). A steady non-zero here means the person keeps getting a notification instead of an answer.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "expr": "sum(increase(telephony_relay_total{outcome!~\"answered|waiting\"}[24h])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 12,
      "title": "Live lookups during owner calls (by tool, outcome)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Lookups the voice agent asked LIA for during an owner call (lot 7, TELEPHONY_LIVE_TOOLS_ENABLED). A refusal names why: the flag, the call, the secret, the tool, or the call's budget. `or vector(0)`: a counter that never fired exposes no series.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "expr": "sum by (tool, outcome) (rate(telephony_live_tool_calls_total[$__rate_interval])) or vector(0)",
          "legendFormat": "{{tool}} · {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "Live lookup duration (p50/p95, by tool)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "How long a live lookup takes to answer the voice agent. The vendor waits TELEPHONY_LIVE_TOOL_TIMEOUT_SECONDS; the lookup itself is bounded a few seconds under it.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, tool) (rate(telephony_live_tool_duration_seconds_bucket[1h])))",
          "legendFormat": "p50 {{tool}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(telephony_live_tool_duration_seconds_bucket[1h])))",
          "legendFormat": "p95 {{tool}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Live mode delegations (by outcome)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Requests the voice on the phone handed to LIA through send_to_lia during a Live owner call (ADR-301). The bridge's own outcomes (answered, question, empty, superseded, timed_out, busy, quota_blocked, failed) plus the route's refusals (refused_call, refused_secret, refused_mode, refused_request). `or vector(0)`: a counter that never fired exposes no series.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(telephony_delegations_total[$__rate_interval])) or vector(0)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "title": "Live mode delegation duration (p50/p95)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "How long a delegated request takes from the vendor's call-back to the bridge's answer (ADR-301). The vendor waits TELEPHONY_DELEGATION_TIMEOUT_SECONDS; the bridge answers `timed_out` the inner margin under it and the turn goes on in the chat.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(telephony_delegation_duration_seconds_bucket[1h])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(telephony_delegation_duration_seconds_bucket[1h])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "id": 102,
      "title": "Webhooks",
      "collapsed": false,
      "gridPos": {
