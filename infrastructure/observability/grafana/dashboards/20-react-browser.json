    {
      "id": 51,
      "type": "timeseries",
      "title": "Tool Time P95",
      "description": "Time spent INSIDE tools, the half the reasoning budget never counted. A delegating tool (sub-agent, iterative MCP task, browser run) opens its own LLM loop behind one tool_call; before ADR-256 that work charged nothing anywhere and no predicate could see it. Compare with 'Reasoning Duration P95' to read a turn's real cost.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "noValue": "0",
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 54
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(agent_tool_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 all tools",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
