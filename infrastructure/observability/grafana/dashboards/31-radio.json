    {
      "id": 11,
      "title": "Production time by format (p50 / p95)",
      "description": "Desk, writer, checks, voices and mix of one aired segment. The look-ahead is sized on RADIO_STAGE_* settings: a p95 far above them means a listener waits.",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, format) (rate(radio_segment_production_seconds_bucket[1h])))",
          "legendFormat": "p50 {{format}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, format) (rate(radio_segment_production_seconds_bucket[1h])))",
          "legendFormat": "p95 {{format}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
