{
  "title": "14 - Compaction v2",
  "uid": "14-compaction-v2",
  "tags": ["lia", "compaction", "v2"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "LIA",
      "type": "dashboards",
      "tags": ["lia"],
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "title": "Strategy mix (5m rate)",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "description": "Per-strategy compaction rate. Watch for 'truncation' spikes — they indicate global-timeout fallbacks.",
      "targets": [
        {
          "expr": "sum by (strategy) (rate(compaction_executions_total[5m]))",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "truncation" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "id": 2,
      "title": "End-to-end duration (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "description": "Distribution of compact() wall-clock duration. p99 above 90s is a warning sign; above 120s means the global timeout is firing.",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(compaction_total_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(compaction_total_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(compaction_total_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "type": "row",
      "id": 101,
      "title": "Failure & retries",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "id": 3,
      "title": "Per-chunk timeouts (rate)",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "description": "Rate of per-chunk asyncio.wait_for triggers. Tune COMPACTION_PER_CHUNK_TIMEOUT_SECONDS if this stays > 0.",
      "targets": [
        {
          "expr": "rate(compaction_chunk_timeouts_total[5m])",
          "legendFormat": "chunk_timeouts",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 4,
      "title": "Global timeouts → truncation (rate)",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "description": "Rate of whole-compact() global timeouts. Each one triggers the truncation fallback and a user-visible notice.",
      "targets": [
        {
          "expr": "rate(compaction_global_timeouts_total[5m])",
          "legendFormat": "global_timeouts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      }
    },
    {
      "id": 5,
      "title": "Errors by type (rate)",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "description": "LLM errors (retryable transient errors, unexpected failures) seen during compaction. Cross-reference with the strategy mix panel.",
      "targets": [
        {
          "expr": "sum by (error_type) (rate(compaction_errors_total[5m]))",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "type": "row",
      "id": 102,
      "title": "Volume & savings",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "id": 6,
      "title": "Skipped reasons (rate)",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 19 },
      "description": "Why compaction was skipped (below_threshold / too_few_messages / hitl_pending_* / disabled). Useful to validate threshold tuning.",
      "targets": [
        {
          "expr": "sum by (reason) (rate(compaction_skipped_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "id": 7,
      "title": "Tokens saved per compaction (p50/p95)",
      "type": "timeseries",
      "datasource": "$datasource",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 19 },
      "description": "How many tokens the compaction frees up. Truncation fallbacks usually save a lot; multi_chunk LLM compactions save a moderate amount.",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(compaction_tokens_saved_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(compaction_tokens_saved_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
