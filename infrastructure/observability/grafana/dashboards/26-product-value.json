    {
      "id": 3,
      "title": "Useful results per user (median)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "postgres-product-readonly"
      },
      "description": "NS-03: daily median of validated outcomes per useful user — exact SQL over the read-only product_depth_daily view (a median is not derivable from bounded Prometheus series). n/a until product_outcomes has data.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "rawSql": "SELECT day AS time, median_results AS value FROM product_depth_daily WHERE $__timeFilter(day) ORDER BY day",
          "rawQuery": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "n/a",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
