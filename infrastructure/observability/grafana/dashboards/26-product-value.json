    {
      "id": 1,
      "title": "Users with useful outcome (7d)",
      "type": "stat",
      "datasource": "$datasource",
      "description": "NS-01 North Star: distinct users with >=1 validated E1/E2 outcome over 7 days. DB-backed gauge (exact dedup by result_id computed in SQL). Empty (n/a) until product_outcomes ships (Phase 2, ADR-178) — by design. ",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(product_users_with_useful_outcome{window=\"7d\",evidence=\"any\"})",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "n/a",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
