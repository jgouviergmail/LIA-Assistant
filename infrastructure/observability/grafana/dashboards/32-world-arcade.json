{
  "title": "32 - World arcade",
  "uid": "32-world-arcade",
  "tags": [
    "lia",
    "world"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "editable": true,
  "id": null,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Game commands and refusals",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Finite rule/outcome labels only; no account, cabinet session or round identity.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (game, outcome) (rate(world_game_commands_total[$__rate_interval]))",
          "legendFormat": "{{game}} / {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Computer preparation p95",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Includes bounded wait and fallback. Search runs outside Redis and SQL locks.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(world_game_compute_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Legal computer fallbacks",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Busy or deadline fallback chooses a legal bounded move rather than queuing more work.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(world_game_compute_fallback_total[$__rate_interval])) or vector(0)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Computer search children p95",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Charged before each child expansion; the pure engine enforces the hard node budget.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(world_game_compute_nodes_bucket[$__rate_interval])))",
          "legendFormat": "p95 nodes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Authority integrity failures (by area)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Expected 0: a World transition produced a record the strict reader refused, so nothing was published and the socket closed 1011. A server defect, never a client error; the refused rule's code is on the world_authority_integrity_failed API log line. The area is a top-level authority field, never a value.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (area) (increase(world_authority_integrity_failures_total[$__rate_interval])) or vector(0)",
          "legendFormat": "{{area}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      }
    }
  ],
  "links": [
    {
      "title": "LIA dashboards",
      "type": "dashboards",
      "tags": [
        "lia"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ]
}
