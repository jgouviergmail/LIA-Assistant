    },
    {
      "id": 8,
      "title": "Notifications envoyées (par événement, 24 h)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Following a ticket is OFF by default (D6): a board must not become a source of noise. A rising curve here is the first sign it has.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (event) (increase(workboard_notifications_total{delivered=\"true\"}[1h])) or vector(0)",
          "legendFormat": "{{event}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "Notifications non délivrées (24 h)",
      "type": "stat",
      "datasource": "$datasource",
      "description": "Settled from the dispatch RESULT, never from the absence of an exception (ADR-263). A « waiting » notification nobody received is a ticket that never moves again.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum(increase(workboard_notifications_total{delivered=\"false\"}[24h])) or vector(0)",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 13,
      "title": "Rejeux d'une action approuvée (24 h)",
      "type": "stat",
      "datasource": "$datasource",
      "description": "A run replaying what the person approved on the ticket is let through only when the rebuilt draft is IDENTICAL to what they were shown (ADR-092, ADR-276 lot 7). A mismatch asks again with the new preview and runs nothing; sustained mismatches mean the brief's citation is not enough for the model to reproduce the draft.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum(increase(workboard_replays_total{result=\"matched\"}[24h])) or vector(0)",
          "legendFormat": "conformes",
          "refId": "A"
        },
        {
          "expr": "sum(increase(workboard_replays_total{result=\"mismatched\"}[24h])) or vector(0)",
          "legendFormat": "non conformes",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "non conformes"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "row",
      "title": "Ce que les transcriptions cachées coûtent",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "id": 10,
      "title": "Lignes cachées",
      "type": "stat",
      "datasource": "$datasource",
      "description": "A run archives its question and its answer, hidden from the chat but kept in the record (D3). The owner accepted that on ONE condition: that the growth be watched rather than assumed. Two bounds hold it — ten runs per ticket, and the retention window.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "max(lia_hidden_run_rows) or vector(0)",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 11,
      "title": "Poids des lignes cachées",
      "type": "stat",
      "datasource": "$datasource",
      "description": "The same measurement in bytes: content and stamp. Read it beside the row count — a size climbing while the count does not means longer runs, not more of them.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 23
