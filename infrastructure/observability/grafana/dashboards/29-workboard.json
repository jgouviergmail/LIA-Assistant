    {
      "id": 12,
      "title": "Croissance des transcriptions cachées",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "The curve the retention sweep is supposed to flatten. A monotonic climb means the purge is not running, or the window is too wide.",
