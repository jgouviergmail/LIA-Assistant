        "h": 4,
        "w": 6,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "expr": "max(journal_zero_injection_age_days)",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 1,
          "noValue": "n/a",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 14
              },
              {
                "color": "red",
                "value": 45
              }
