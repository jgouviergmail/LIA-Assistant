    {
      "id": 8,
      "type": "row",
      "title": "Request Performance",
      "collapsed": true,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": [
        {
          "id": 9,
          "type": "timeseries",
          "title": "Request Rate",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 0,
            "y": 10
          },
          "targets": [
            {
              "expr": "http_requests:rate5m",
              "legendFormat": "Requests/s",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "fillOpacity": 10,
                "showPoints": "auto"
              }
            },
            "overrides": []
          },
          "options": {
            "tooltip": {
              "mode": "single"
            },
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "description": "HTTP request rate (total req/sec) Traffic monitoring."
        },
        {
          "id": 10,
          "type": "timeseries",
          "title": "HTTP Error Rate (5xx)",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 8,
            "y": 10
          },
          "targets": [
            {
              "expr": "http_error_rate:5m * 100",
              "legendFormat": "Error Rate %",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "fillOpacity": 10,
                "showPoints": "auto",
                "thresholdsStyle": {
                  "mode": "dashed"
                }
              },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "red",
                    "value": 0.1
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "tooltip": {
              "mode": "single"
            },
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "description": "HTTP error rate (5xx errors) SLI for availability numerator selector matches no series and the ratio would be empty."
        },
        {
          "id": 11,
          "type": "timeseries",
          "title": "P95 Latency (top 10)",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "gridPos": {
            "h": 8,
            "w": 8,
            "x": 16,
            "y": 10
          },
          "targets": [
            {
              "expr": "topk(10, http_request_duration:p95_5m)",
              "legendFormat": "{{endpoint}}",
              "refId": "A"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "fillOpacity": 10,
                "showPoints": "auto"
              }
            },
            "overrides": []
          },
          "options": {
            "tooltip": {
              "mode": "single"
            },
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "description": "HTTP P95 latency (by endpoint) Performance monitoring."
        },
        {
          "id": 12,
          "type": "stat",
          "title": "Requests In Progress",
          "datasource": {
            "type": "prometheus",
            "uid": "$datasource"
          },
          "gridPos": {
            "h": 8,
            "w": 8,
