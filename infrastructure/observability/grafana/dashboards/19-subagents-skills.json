    {
      "id": 34,
      "title": "Skill runner: no tool called (24h)",
      "type": "stat",
      "datasource": "$datasource",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "expr": "sum(increase(skill_runner_outcomes_total{outcome=\"no_tool_call\"}[24h])) or vector(0)",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
