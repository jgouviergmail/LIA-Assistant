              {
                "value": 1,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Script-skill runs in the response node whose sub-agent called NO tool and answered in prose about a widget that does not exist (production 2026-09-20: misled by an earlier text game in the history, the result dropped in silence). Expected 0: the runner is handed the activated skill and the history only for a dialogue skill. The instructions fall back to the passive injection; the log `skill_runner_no_tool_call` names the skill."
    },
