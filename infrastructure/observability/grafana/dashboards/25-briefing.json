{
  "title": "25 - Today Briefing",
  "uid": "25-briefing",
  "tags": [
    "lia",
    "briefing"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "LIA dashboards",
      "type": "dashboards",
      "tags": [
        "lia"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Build",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "Builds (24h)",
      "type": "stat",
      "datasource": "$datasource",
      "description": "Today-briefing builds over the last 24h (all cache states). A page load no longer builds the bundle (progressive dashboard, spec 2026-10-21 §5.8): this covers a refresh-all and the bundle routes' clients; page loads are under « Progressive load ».",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(briefing_build_duration_seconds_count[24h]))",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Refresh requests (24h)",
      "type": "stat",
      "datasource": "$datasource",
      "description": "User-initiated POST /briefing/refresh requests.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(briefing_refresh_requests_total[24h]))",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "LLM failures (24h)",
      "type": "stat",
      "datasource": "$datasource",
      "description": "Briefing LLM invocations (greeting / synthesis) that did not succeed.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(briefing_llm_invocations_total{outcome!=\"success\"}[24h]))",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 9,
      "title": "Duplicate builds avoided (24h)",
      "type": "stat",
      "datasource": "$datasource",
      "description": "Bundle builds a caller JOINED instead of repeating. /briefing/cards and /briefing/synthesis are issued in parallel for one page load and both want the bundle; before this seam each ran its own, calling every connector twice. A value of 0 over 24h with non-zero cold/partial builds means the coalescing is no longer taking effect.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(increase(briefing_bundle_builds_total{outcome=\"joined\"}[24h])) or vector(0)",
          "legendFormat": " ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Build duration p95 (by cache_state)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "End-to-end time to build the Today briefing (parallel fetchers + LLM), split by cache state. Cold builds are LLM-bound; warm ones should be near-instant. A page load no longer builds the bundle (progressive dashboard, spec 2026-10-21 §5.8): this covers a refresh-all and the bundle routes' clients; page loads are under « Progressive load ».",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (cache_state, le) (rate(briefing_build_duration_seconds_bucket[1h])))",
          "legendFormat": "{{cache_state}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Refresh requests (by scope)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "User-initiated briefing refreshes by scope. Empty panel = zero events in the window (healthy). « single » counts a card's own refresh route too (POST /briefing/sections/{name}/refresh).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "sum by (scope) (rate(briefing_refresh_requests_total[$__rate_interval]))",
          "legendFormat": "{{scope}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "id": 101,
      "title": "Sections",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 6,
      "title": "Section outcomes (by section / status)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Per-section build outcomes for the Today briefing. Non-success statuses point at the failing upstream source (agenda, mails, weather...).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (section, status) (rate(briefing_section_status_total[$__rate_interval]))",
          "legendFormat": "{{section}} · {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Sections built (24h)",
      "type": "bargauge",
      "datasource": "$datasource",
      "description": "Section build volume over the last 24h — a missing section means its fetcher never ran.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "sum by (section) (increase(briefing_section_status_total[24h]))",
          "legendFormat": "{{section}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "type": "row",
      "id": 102,
      "title": "LLM",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 8,
      "title": "LLM invocations (by kind / outcome)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Briefing LLM invocations (greeting / synthesis) by outcome. Empty panel = zero events in the window (healthy).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "sum by (kind, outcome) (rate(briefing_llm_invocations_total[$__rate_interval]))",
          "legendFormat": "{{kind}} · {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Bundle builds: owned vs joined",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "One page load should show one owned build and one joined. A joined line flat at zero while owned climbs means the two endpoints are building the bundle separately again.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(briefing_bundle_builds_total[$__rate_interval])) or vector(0)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 103,
      "type": "row",
      "title": "Coalescing",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Attempt markers (written / settled / cleared)",
      "datasource": "$datasource",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(briefing_section_attempt_markers_total[1h])) or vector(0)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "A failed section read leaves a short-lived marker (written); the synthesis or a waiting worker then settles on it instead of rebuilding and reopening the failing source (settled); a later success removes it (cleared). Per hour."
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Section writes fenced by a push (E5)",
      "datasource": "$datasource",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "sum by (section) (increase(briefing_section_writes_fenced_total[1h])) or vector(0)",
          "legendFormat": "{{section}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "A push invalidated the section while a read was in flight: the read's older payload was NOT cached, so the next read is live instead of a stale card for a whole TTL. Per hour."
    },
    {
      "id": 104,
      "type": "row",
      "title": "Progressive load",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      }
    },
    {
      "id": 13,
      "title": "Progressive load: step duration p95 (by step)",
      "type": "timeseries",
      "datasource": "$datasource",
      "description": "Server time of each step of a page load: initial (the first response — cached and local sections), section (one pending section of the act), text (greeting and synthesis), refresh (one card re-read on request).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (step, le) (rate(briefing_act_step_duration_seconds_bucket[1h])))",
          "legendFormat": "{{step}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Progressive load: steps (24h)",
      "type": "bargauge",
      "datasource": "$datasource",
      "description": "How many initial responses, section reads, texts and card refreshes ran.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "targets": [
        {
          "expr": "sum by (step) (increase(briefing_act_step_duration_seconds_count[24h])) or vector(0)",
          "legendFormat": "{{step}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ]
}
