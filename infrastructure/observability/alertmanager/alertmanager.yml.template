# ===================================================================
# AlertManager Configuration - LIA
# ===================================================================
# Rendered at startup by docker-entrypoint.sh (audit A07):
#   - each block between `# @begin <name>` and `# @end <name>` is removed
#     when the channel or the team it serves is not configured — the table
#     is in the entrypoint — so a rendered config never holds an empty Slack
#     URL, an empty PagerDuty key, or a team told what the backend is told;
#   - every placeholder is replaced by its variable LITERALLY, its single
#     quotes doubled: each one sits inside a single-quoted YAML scalar.
#
# Severity fixes the URGENCY of the backend team's notification (channels,
# grouping, repetition); the component adds an AUDIENCE — a team with an
# address of its own is told too (owner decision Q3, 2026-10-22). Every
# loaded alert is critical or warning (test_alerts_core_guard), so the two
# severity routes see all of them; a team route never stands in for them.
#
# Variables (substituted by docker-entrypoint.sh):
#   ALERTMANAGER_SMTP_FROM, ALERTMANAGER_SMTP_SMARTHOST,
#   ALERTMANAGER_SMTP_AUTH_USERNAME, ALERTMANAGER_SMTP_AUTH_PASSWORD,
#   ALERTMANAGER_BACKEND_TEAM_EMAIL (required with SMTP);
#   ALERTMANAGER_{ML,SECURITY}_TEAM_EMAIL,
#   ALERTMANAGER_SLACK_WEBHOOK_{CRITICAL,WARNING,SECURITY},
#   ALERTMANAGER_PAGERDUTY_ROUTING_KEY (optional).
# ===================================================================

global:
  resolve_timeout: 5m
  smtp_from: '${ALERTMANAGER_SMTP_FROM}'
  smtp_smarthost: '${ALERTMANAGER_SMTP_SMARTHOST}'
  smtp_auth_username: '${ALERTMANAGER_SMTP_AUTH_USERNAME}'
  smtp_auth_password: '${ALERTMANAGER_SMTP_AUTH_PASSWORD}'
  smtp_require_tls: true

templates:
  - '/etc/alertmanager/templates/*.tmpl'

# ===================================================================
# ROUTING
# ===================================================================
route:
  # Reached only by an alert no child route matches.
  receiver: 'default-email'
  # Keep deployment identity common to every alert in a notification.
  group_by: ['alertname', 'component', 'severity', 'environment', 'host']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

  routes:
    # ----- URGENCY: the backend team, by severity ---------------------
    - match:
        severity: critical
      receiver: 'critical'
      group_wait: 10s
      group_interval: 2m
      repeat_interval: 30m
      continue: true

    - match:
        severity: warning
      receiver: 'warning'
      group_wait: 1m
      group_interval: 10m
      repeat_interval: 2h
      continue: true

    # ----- AUDIENCE: a team with an address of its own ----------------
    # @begin team-ml
    - match_re:
        component: '(agents|hitl|hitl_streaming)'
      receiver: 'ml-team'
      group_by: ['alertname', 'severity', 'environment', 'host']
      group_wait: 1m
      repeat_interval: 1h
    # @end team-ml
    # @begin team-security
    - match:
        component: oauth
        severity: critical
      receiver: 'security-team'
      group_wait: 5s
      repeat_interval: 30m
    # @end team-security

# ===================================================================
# INHIBITION
# ===================================================================
inhibit_rules:
  # Suppression always stays inside one environment and host.
  # If service is down, don't alert on high error rate or latency
  - source_match:
      alertname: 'ServiceDown'
    target_match:
      component: 'api'
    target_match_re:
      alertname: '(HighErrorRate|HighLatency.*|CriticalLatency.*)'
    equal: ['service', 'environment', 'host']

  # If Redis is down, don't alert on connection issues
  - source_match:
      alertname: 'RedisDown'
    target_match:
      component: 'redis'
    target_match_re:
      alertname: '(RedisConnectionsHigh|RedisMemoryHigh)'
    equal: ['environment', 'host']

  # If PostgreSQL is down, don't alert on connection pool issues
  - source_match:
      alertname: 'PostgreSQLDown'
    target_match:
      component: 'postgresql'
    target_match_re:
      alertname: '(HighDatabaseConnections|CriticalDatabaseConnections|SlowQueries)'
    equal: ['environment', 'host']

  # If container is down, don't alert on container-specific metrics
  - source_match:
      alertname: 'ContainerDown'
    target_match_re:
      alertname: '(HighCPUUsage|HighMemoryUsage|ContainerRestartingFrequently)'
    equal: ['container', 'environment', 'host']

  # If daily budget exceeded, weekly/monthly alerts are redundant
  - source_match_re:
      alertname: '.*DailyBudget.*'
    target_match_re:
      alertname: '.*(Weekly|Monthly)Budget.*'
    equal: ['component', 'environment', 'host']

  # If LLM API has high failure rate, don't alert on latency
  - source_match:
      alertname: 'LLMAPIFailureRateHigh'
    target_match_re:
      alertname: '.*Latency.*'
    equal: ['component', 'environment', 'host']

  # Critical severity inhibits warnings for same alert
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'component', 'environment', 'host']

# ===================================================================
# RECEIVERS
# ===================================================================
receivers:
  - name: 'default-email'
    email_configs:
      - to: '${ALERTMANAGER_BACKEND_TEAM_EMAIL}'
        headers:
          Subject: '[{{ template "notification.identity" .CommonLabels }}] [LIA {{ .Status | toUpper }}] {{ .GroupLabels.alertname }}'
        html: '{{ template "email.default.html" . }}'
        send_resolved: true

  # ----- critical: email, then Slack and PagerDuty when configured -----
  - name: 'critical'
    email_configs:
      - to: '${ALERTMANAGER_BACKEND_TEAM_EMAIL}'
        headers:
          Subject: '[{{ template "notification.identity" .CommonLabels }}] [CRITICAL] LIA: {{ .GroupLabels.alertname }}'
        html: '{{ template "email.critical.html" . }}'
        send_resolved: true
    # @begin slack-critical
    slack_configs:
      - api_url: '${ALERTMANAGER_SLACK_WEBHOOK_CRITICAL}'
        channel: '#alerts-critical'
        title: '[{{ template "notification.identity" .CommonLabels }}] :fire: CRITICAL: {{ .GroupLabels.alertname }}'
        text: |-
          *Environment:* {{ template "notification.environment" .CommonLabels }}
          *Host:* {{ template "notification.host" .CommonLabels }}
          {{ range .Alerts }}
          *Alert:* {{ .Labels.alertname }}
          *Severity:* {{ .Labels.severity }}
          *Component:* {{ .Labels.component }}
          *Summary:* {{ .Annotations.summary }}
          *Description:* {{ .Annotations.description }}
          {{ if .Annotations.runbook_url }}*Runbook:* {{ .Annotations.runbook_url }}{{ end }}
          {{ end }}
        send_resolved: true
        color: '{{ if eq .Status "firing" }}danger{{ else }}good{{ end }}'
    # @end slack-critical
    # @begin pagerduty
    pagerduty_configs:
      - routing_key: '${ALERTMANAGER_PAGERDUTY_ROUTING_KEY}'
        description: '[{{ template "notification.identity" .CommonLabels }}] [{{ .GroupLabels.severity }}] {{ .GroupLabels.alertname }} - {{ .GroupLabels.component }}'
        details:
          environment: '{{ template "notification.environment" .CommonLabels }}'
          host: '{{ template "notification.host" .CommonLabels }}'
          firing: '{{ .Alerts.Firing | len }}'
          resolved: '{{ .Alerts.Resolved | len }}'
          summary: '{{ range .Alerts }}{{ .Annotations.summary }}{{ end }}'
        severity: 'critical'
        send_resolved: true
    # @end pagerduty

  # ----- warning: email, then Slack when configured -----
  - name: 'warning'
    email_configs:
      - to: '${ALERTMANAGER_BACKEND_TEAM_EMAIL}'
        headers:
          Subject: '[{{ template "notification.identity" .CommonLabels }}] [WARNING] LIA: {{ .GroupLabels.alertname }}'
        html: '{{ template "email.warning.html" . }}'
        send_resolved: true
    # @begin slack-warning
    slack_configs:
      - api_url: '${ALERTMANAGER_SLACK_WEBHOOK_WARNING}'
        channel: '#alerts-warning'
        title: '[{{ template "notification.identity" .CommonLabels }}] :warning: Warning: {{ .GroupLabels.alertname }}'
        text: |-
          *Environment:* {{ template "notification.environment" .CommonLabels }}
          *Host:* {{ template "notification.host" .CommonLabels }}
          {{ range .Alerts }}
          *Alert:* {{ .Labels.alertname }}
          *Component:* {{ .Labels.component }}
          *Summary:* {{ .Annotations.summary }}
          {{ end }}
        send_resolved: true
        color: 'warning'
    # @end slack-warning

  # ----- teams: told IN ADDITION to the backend, never instead -----
  # @begin team-ml
  - name: 'ml-team'
    email_configs:
      - to: '${ALERTMANAGER_ML_TEAM_EMAIL}'
        headers:
          Subject: '[{{ template "notification.identity" .CommonLabels }}] [AGENTS] {{ .GroupLabels.alertname }}'
        html: '{{ template "email.agents.html" . }}'
        send_resolved: true
  # @end team-ml
  # @begin team-security
  - name: 'security-team'
    # @begin email-security
    email_configs:
      - to: '${ALERTMANAGER_SECURITY_TEAM_EMAIL}'
        headers:
          Subject: '[{{ template "notification.identity" .CommonLabels }}] [SECURITY CRITICAL] OAuth Alert: {{ .GroupLabels.alertname }}'
        html: '{{ template "email.security.html" . }}'
        send_resolved: true
    # @end email-security
    # @begin slack-security
    slack_configs:
      - api_url: '${ALERTMANAGER_SLACK_WEBHOOK_SECURITY}'
        channel: '#alerts-security'
        title: '[{{ template "notification.identity" .CommonLabels }}] :rotating_light: SECURITY: {{ .GroupLabels.alertname }}'
        text: |-
          *Environment:* {{ template "notification.environment" .CommonLabels }}
          *Host:* {{ template "notification.host" .CommonLabels }}
          {{ range .Alerts }}
          *Security Alert:* {{ .Labels.alertname }}
          *Severity:* CRITICAL
          *Component:* {{ .Labels.component }}
          *Summary:* {{ .Annotations.summary }}
          *Description:* {{ .Annotations.description }}
          {{ end }}
        send_resolved: true
        color: 'danger'
    # @end slack-security
  # @end team-security
