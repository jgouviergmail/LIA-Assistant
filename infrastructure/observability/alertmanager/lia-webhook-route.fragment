    # ------------------------------------------------
    # LIA SELF-DIAGNOSTICS WEBHOOK (spec 2026-08-27)
    # First child route, `continue: true`: the API observes every
    # critical/warning alert as an incident, then routing proceeds to the
    # existing email/Slack/PagerDuty receivers unchanged.
    # ------------------------------------------------
    - match_re:
        severity: 'critical|warning'
      receiver: 'lia-api-webhook'
      group_wait: 10s
      group_interval: 2m
      repeat_interval: 30m
      continue: true
