# Public demonstrator instance — environment template.
#
# Copy to `.env.demo-instance` (git-ignored) and fill the secrets. This file
# configures the STANDARD LIA image running inside the isolated envelope
# (docker-compose.demo-instance.yml); it is never a normal .env.
#
# This is the LOCAL VALIDATION shape: loopback ports, http://localhost, a
# host-only session cookie, development logging. The PRODUCTION shape is its
# sibling `.env.demo-instance.prod.example` — same keys, four deliberate
# differences, each documented there.
#
#   task dev:all             application stack + demonstrator, together
#   task demo:start          the demonstrator alone (edge on 127.0.0.1:8090)
#
# Every variable the Compose files interpolate must be declared here, and every
# variable declared here must be one the code actually reads. Both directions
# are enforced by `apps/api/tests/unit/test_demo_instance_env_template.py`,
# because this template WAS wrong: it named five SMTP settings nothing reads,
# omitted the URL that builds the verification link, and offered an OpenAI key
# to an instance configured for DeepSeek.
#
# After the first boot, mark the database as a demonstrator's:
#
#   task demo:provision
#
# Without that marker the nightly visitor purge refuses to run. That command
# ALSO refuses an instance whose model this database cannot price — a daily
# spend ceiling that reads a flat ledger is not a ceiling.

# ============================================================================
# TABLE OF CONTENTS
# ============================================================================
#
# The demonstrator's own decisions
# [01] WHAT MAKES THIS A DEMONSTRATOR
# [02] SPENDING & SIGN-UP CEILINGS (ADR-216)
# [03] CAPABILITIES OFFERED (deployment ceilings — ADR-217, ADR-280)
# [04] THE ONE ADDRESS, WRITTEN THREE TIMES
# [05] SECRETS (fill these in; never commit the filled file)
# [06] MAIL — the step that ACTIVATES a visitor's account
# [07] POSTGRESQL CONNECTION BUDGET (F004)
# [08] THE DEMONSTRATOR'S MODEL
# [09] ENVIRONMENT & LOGGING
#
# The application's settings, by theme
# [10] RATE LIMITING & SIGN-IN PROTECTION (ADR-363, ADR-364)
# [11] MAPS — interactive maps in the browser
# [12] OBSERVABILITY — OpenTelemetry & Prometheus
# [13] AGENT LOOP & PROMPT CACHE — ReAct, exchange rhythm (ADR-070, ADR-308, ADR-362)
# [14] CONVERSATION — COMPACTION & ACTIONS SHOWN UNDER AN ANSWER
# [15] TOOLS — Emails
# [16] REMINDERS & ROUTINES (ADR-304, ADR-322)
# [17] VOICE — TTS
# [18] MCP — Per-User Servers
# [19] GENERATED FILES — keeping one past its deadline (ADR-319)
# [20] INTERNATIONALIZATION
# [21] PEERS — user-to-user connections (peer-connections program)
# [22] ASSISTANT LOOKUPS — calculation, journal, activity, generated files (ADR-318)
# [23] SPEAKING AVATAR — a personal Simli avatar (ADR-334)
# [24] APPLICATION TOOLS — managing LIA from the conversation (ADR-339)
# [25] SMS & PHONE INGESTION — the personal SMS archive (ADR-357)
# [26] PROACTIVE DISCUSSIONS — LIA opens a conversation (ADR-358, ADR-359, ADR-360)
# [27] INERT HERE — settings of capabilities switched off above

# ============================================================================
# [01] WHAT MAKES THIS A DEMONSTRATOR
# ============================================================================

# Visitor accounts: verifying the email activates the account, registration
# requires accepting the terms, and the nightly purge wipes every non-admin
# account. NEVER set this on a private instance.
DEMO_MODE_ENABLED=true

# Identifier of the terms a visitor accepts. Bump it whenever they change.
DEMO_TERMS_VERSION=2026-08-06

# Nightly wipe, in UTC.
DEMO_ACCOUNT_PURGE_HOUR=2
DEMO_ACCOUNT_PURGE_MINUTE=30

# Daily report sent to the operator JUST BEFORE the 02:30 purge: the database
# lives in tmpfs and disappears with it, so this e-mail is the only recorded
# trace of the activity. Empty = no report; the instance runs exactly the
# same. It borrows the mail relay the verification links already use: no
# extra network route is opened.
DEMO_DAILY_REPORT_RECIPIENT=
DEMO_DAILY_REPORT_HOUR=2
DEMO_DAILY_REPORT_MINUTE=15

# ============================================================================
# [02] SPENDING & SIGN-UP CEILINGS (ADR-216)
# ============================================================================

# Hard ceiling on what this instance may spend per UTC day, every cost family
# included. First come, first served: once reached, visitors are told to come
# back tomorrow. This is THE financial protection (ADR-216).
INSTANCE_DAILY_BUDGET_EUR=1.00

# Accounts this instance may create per UTC day.
#
# The per-address limiter (5 registrations a minute) bounds one caller, never
# the instance: its bucket key comes from a header the caller supplies, and
# thirty accounts were created in 6,4 seconds when that was the only bound
# (measured 2026-08-07). Every account costs one verification email against
# the smarthost quota, which the spend ceiling above does not see.
DEMO_DAILY_SIGNUP_LIMIT=50

# Per-visitor limits, so one visitor cannot drain the daily budget alone.
USAGE_LIMITS_ENABLED=true
DEFAULT_TOKEN_LIMIT_PER_CYCLE=200000
DEFAULT_MESSAGE_LIMIT_PER_CYCLE=25
DEFAULT_COST_LIMIT_PER_CYCLE_EUR=0.05

# ============================================================================
# [03] CAPABILITIES OFFERED (deployment ceilings — ADR-217, ADR-280)
# ============================================================================

# One line per PlatformCapability (domains/feature_switches/registry.py). An
# administrator may lower any of these from Settings > Administration, never
# raise them. A flag ABSENT from this file takes the code's default — which is
# how the workboard, the meetings and model-authored Python reached the public
# demonstrator switched ON by nobody's decision, each behind a door that did
# not open (measured 2026-09-12). Every capability is therefore written down
# here, on or off, with why.
#
# Three declarations must agree for an ON flag to work: this file, the egress
# allowlist (infrastructure/demo-instance/squid.conf) and the edge allowlist
# (infrastructure/demo-instance/Caddyfile). A flag that is ON while its route
# is closed puts a button in front of a visitor that cannot work, which on a
# demonstrator is worse than not offering it. Enforced by
# tests/unit/test_demo_instance_capability_coherence.py (hosts, and the two
# templates agreeing) and tests/unit/test_demo_instance_exposed_routes.py
# (routes, mounted under THIS file's flags).

# --- ON: the conversation and what it draws on — that IS the demo ----------
WEB_SEARCH_ENABLED=true
VOICE_TTS_ENABLED=true
SUB_AGENTS_ENABLED=true
# A generated document is served by GET /attachments/{id}, which is mounted
# whatever the uploads ceiling says (ADR-279, amended 2026-09-12) — before
# that, a report was written here and could not be opened.
DOCUMENT_GENERATION_ENABLED=true
# What LIA learns and keeps for the visitor's own account, wiped nightly.
MEMORY_EXTRACTION_ENABLED=true
INTEREST_EXTRACTION_ENABLED=true
JOURNALS_ENABLED=true
PSYCHE_ENABLED=true
HABITS_ENABLED=true
BOOKMARKS_ENABLED=true
OPEN_LOOPS_ENABLED=true
RELATION_DEBRIEF_ENABLED=true
# A ticket runs on the visitor's own allowance, like a routine does.
WORLD_ENABLED=false
WORLD_CAPACITY=5
WORLD_NAMESPACE=lia
# The arcade is subordinate to WORLD_ENABLED: the World is off here, and so
# are its cabinets (ADR-365).
WORLD_ARCADE_ENABLED=false
WORKBOARD_ENABLED=true
# Connections between two demonstrator accounts — throwaway on both sides.
# Sharing a generated image with a connection (PEERS_IMAGE_SHARE_*, ADR-316)
# keeps the code defaults: no image is generated here to be shared.
PEERS_ENABLED=true
# Application management tools: deployment ceiling; administrator switch under Platform Capabilities.
APPLICATION_TOOLS_ENABLED=true

# --- OFF, each for a written reason ----------------------------------------
# Image generation: expensive, and it demonstrates nothing about what makes
# LIA different (owner arbitration 2026-08-06).
IMAGE_GENERATION_ENABLED=false
# Its tunables (IMAGE_GENERATION_RESULT_*, IMAGE_GENERATION_ENCODING_QUALITY,
# IMAGE_PROMPT_ENHANCEMENT_*) keep the code defaults while the capability is off.
# Interactive browsing drives a real browser: too much surface for a public
# instance, and search already covers the demonstrative need.
BROWSER_ENABLED=false
# Telephony calls through the person's own vendor connector — closed here,
# like every connector (see the live voice mode just below).
TELEPHONY_ENABLED=false
# Live voice mode: runs on the VISITOR's own provider key, and the demonstrator
# closes the connectors (nobody links a real account to an instance wiped
# nightly) — a button that cannot be configured must not be offered.
LIVE_ENABLED=false
# The speaking avatar (ADR-334) runs on the visitor's own Simli connector key:
# closed here for the same reason.
AVATAR_ENABLED=false
# Uploads and document spaces store visitor files on a disposable instance.
ATTACHMENTS_ENABLED=false
RAG_SPACES_ENABLED=false
# Sandboxed execution and user-connected servers are not demonstrated — and
# the envelope mounts no Docker socket, so the container sandbox that
# model-authored Python REQUIRES (ADR-249) cannot exist here.
SKILLS_ENABLED=false
PYTHON_SANDBOX_TOOL_ENABLED=false
PYTHON_SANDBOX_EGRESS_ENABLED=false
MCP_ENABLED=false
# The skill library (ADR-327): skills are off here, and an install fetches a
# stranger's code from GitHub, a host the egress allowlist does not open.
SKILL_LIBRARY_ENABLED=false
# Neither is remote server administration, nor the messaging channels.
DEVOPS_ENABLED=false
CHANNELS_ENABLED=false
# Proactive messages: a visitor is here for minutes, not for a rhythm. An
# anticipated moment is SERVED by the heartbeat sweep (ADR-281), so it goes
# with it.
HEARTBEAT_ENABLED=false
MOMENTS_ENABLED=false
# Personal longitudinal discussions and their paid background work are not a public demo activity.
PROACTIVE_DISCUSSIONS_ENABLED=false
# Dictation is OFF: the local engine holds about 1.6 GB per worker (ADR-283)
# on a host the demonstrator shares with production, and the remote path
# needs a provider key AND its host on the egress allowlist — the coherence
# guard holds you to both. Meetings transcribe through the same engines, so
# they go with it; they are also the costliest surface of the product.
VOICE_STT_ENABLED=false
MEETINGS_ENABLED=false
# Inert while MEETINGS_ENABLED=false: importing a meeting from a file (2026-10-24).
MEETINGS_IMPORT_ENABLED=false
# Remote dictation engines (ADR-345): inert while VOICE_STT_ENABLED=false; Fish
# Audio stays off — no key here, and its host is not on the egress allowlist.
FISHAUDIO_STT_ENABLED=false
# Creating voices on the instance's Fish Audio account (ADR-345): an
# administrator's act, but the demonstrator holds no Fish Audio key, and a clone
# would leave a recorded voice on a vendor account nobody curates.
FISHAUDIO_VOICE_CREATION_ENABLED=false
# Personal phone ingestion stays off on disposable public demonstrator accounts.
SMS_ENABLED=false
# Sending by e-mail (ADR-321): with the connectors closed it would leave through
# the instance's relay — the one that sends the verification e-mail ACTIVATING
# every account. A visitor mailing files to themselves must never exhaust it.
EMAIL_SHARE_ENABLED=false
# The personal radio (ADR-324, owner decision Q9): a session writes, checks and
# voices programmes CONTINUOUSLY on the instance's models and voices — a spend
# no disposable account should run — and its newsroom reads dozens of outside
# feeds the egress allowlist does not open.
RADIO_ENABLED=false

# ============================================================================
# [04] THE ONE ADDRESS, WRITTEN THREE TIMES
# ============================================================================

# They describe the same origin and they move together. FRONTEND_URL is the
# one that builds the email verification link (auth/service.py); leaving it at
# a default produced `https://localhost:/verify-email`, a link nobody could
# click, while every other page worked (measured 2026-08-07).
#
# Locally that origin is the edge's loopback port, so these two must stay in
# step with DEMO_INSTANCE_EDGE_PORT below.

APP_URL_SERVER=http://localhost:8090
FRONTEND_URL=http://localhost:8090

# Landing video (ADR-330): a media directory URL holding manifest.json; empty =
# the demonstrator's landing shows no video (off: nothing to host here).
LANDING_MEDIA_BASE_URL=

# Session cookie: EMPTY here on purpose. An empty domain gives a host-only
# cookie, which is what `localhost` needs; naming a domain would make the
# browser drop it. Production names its exact host and never a parent domain
# — a parent is shared with every sibling, so the demonstrator would hand its
# throwaway sessions to the main instance and receive its own.
SESSION_COOKIE_DOMAIN=

# Loopback ports for the development override (task demo:up:dev). Production
# publishes NOTHING — the tunnel is the way in — so its template declares
# neither of these. A developer machine is a crowded place: 8080 belongs to
# cadvisor here, hence 8090/8100.
DEMO_INSTANCE_EDGE_PORT=8090
DEMO_INSTANCE_API_PORT=8100

# ============================================================================
# [05] SECRETS (fill these in; never commit the filled file)
# ============================================================================

DEMO_INSTANCE_POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://demo:CHANGE_ME@demo-instance-postgres:5432/lia_demo
REDIS_URL=redis://demo-instance-redis:6379/0

# Both MUST differ from every other instance's: a shared SECRET_KEY means a
# session minted here is valid there.
SECRET_KEY=
FERNET_KEY=

# The provider every LLM type is pointed at, and the key it spends. Prefer a
# key DEDICATED to this instance with a provider-side cap: the ceiling above
# is LIA's accounting, not the provider's.
DEEPSEEK_API_KEY=

# Embeddings for memory and interests. Not covered by any capability switch —
# the embedding model is not in LLM_TYPES_REGISTRY — so an absent key leaves
# both silently inert.
GOOGLE_GEMINI_API_KEY=

# Search key the instance LENDS to every visitor account. Brave is a PER-USER
# connector: without it a visitor sees the search agent and can never use it.
DEMO_SHARED_SEARCH_API_KEY=

# ============================================================================
# [06] MAIL — the step that ACTIVATES a visitor's account
# ============================================================================

# The API sits on no outbound network and a HTTP proxy cannot relay SMTP, so
# mail leaves through a confined relay. Two smarthost names, on purpose:
#
#   ALERTMANAGER_SMTP_SMARTHOST  what the APPLICATION talks to — the relay,
#                                inside the private network, no credentials;
#   DEMO_INSTANCE_SMTP_SMARTHOST what the RELAY talks to — the real provider.
#
# Reading one for the other makes the relay forward to itself. The credentials
# below belong to the relay and are BLANKED in the API container by the
# Compose file: the process that talks to visitors never holds them.

ALERTMANAGER_SMTP_SMARTHOST=demo-instance-smtp:25
DEMO_INSTANCE_SMTP_SMARTHOST=smtp.example.org:587
ALERTMANAGER_SMTP_AUTH_USERNAME=
ALERTMANAGER_SMTP_AUTH_PASSWORD=

# Sender domain the relay accepts, and the address visitors see. Prefer a
# domain (or subdomain) dedicated to the demonstrator: the relay accepts any
# sender of this domain to any recipient in the world, so a burst of signups
# spends this domain's sending reputation.
DEMO_INSTANCE_MAIL_DOMAIN=example.org
APPLICATION_SMTP_FROM=lia@example.org

# ============================================================================
# [07] POSTGRESQL CONNECTION BUDGET (F004)
# ============================================================================

# The worst-case burst -- every uvicorn worker holding its whole pool, plus the
# LangGraph checkpointer and store -- must fit under the server's max_connections.
# In production an overflow REFUSES to start; in development it only warns.
# That is why this instance started here and died on the Raspberry Pi
# (measured 2026-08-07):
#
#   ConnectionBudgetError: worst-case burst 288 exceeds usable 195
#
# The file carried none of these settings, so the code defaults applied:
# 4 workers x (30+30) + 4x8 + 4x4 = 288.
#
# And the reference figure was wrong: the demonstrator's database is a standard
# pgvector, whose max_connections is 100, not 200 (checked with
# `show max_connections`). A budget computed against a ceiling that does not
# exist protects nothing.
#
# The sizing kept, for a demonstrator on a Raspberry Pi (mem_limit 2g):
#   2 x (10 + 5) + 2x8 + 2x4 = 54  <=  95 usable (100 - 5 reserved)
WEB_CONCURRENCY=2
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_MAX_CONNECTIONS=100

# PostgreSQL bounds every connection of the application starts with (audit AC-028,
# ADR-304): a lock wait, and an idle transaction. 0 leaves the server's own setting.
DATABASE_LOCK_TIMEOUT_MS=30000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000

# ============================================================================
# [08] THE DEMONSTRATOR'S MODEL
# ============================================================================

# Every LLM type is pointed at this provider when the instance is provisioned.
# The registry ships one provider per type (Qwen here, OpenAI there) for the
# full product; a demonstrator holds one key, so it must override them all or
# the graph calls providers it has no key for.
#
# The model MUST have an ACTIVE per-1M-token price in THIS instance's
# catalogue. That catalogue is built by the migrations alone — the reference
# seed bundle is refused here, because the migrations already insert the
# personalities and the bundle deletes before it inserts (ADR-215 gate).
#
# Why it matters: the daily ceiling above reads a ledger the pricing catalogue
# feeds. An unpriced model is billed by the provider and recorded at zero, so
# the ceiling never fires (measured 2026-08-07: 59 344 real tokens ledgered as
# 0,000025 EUR). `task demo:provision` refuses such a model outright rather
# than arming a blind ceiling, and `task demo:verify` re-checks it on a
# running instance. An INACTIVE price counts as missing.
DEMO_INSTANCE_LLM_PROVIDER=deepseek
DEMO_INSTANCE_LLM_MODEL=deepseek-flash

# ============================================================================
# [09] ENVIRONMENT & LOGGING
# Config: src/core/config/__init__.py
# ============================================================================

ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ============================================================================
# [10] RATE LIMITING & SIGN-IN PROTECTION (ADR-363, ADR-364)
# Config: src/core/config/security.py
# ============================================================================

# API HTTP scan protection (shared Redis bans; normal session/resource errors excluded).
HTTP_SCAN_PROTECTION_ENABLED=true
HTTP_SCAN_WINDOW_SECONDS=60
HTTP_SCAN_NOT_FOUND_LIMIT=20
HTTP_SCAN_AUTH_WINDOW_SECONDS=600
HTTP_SCAN_AUTH_FAILURE_LIMIT=20
HTTP_SCAN_BAN_SECONDS=900
HTTP_SCAN_REDIS_TIMEOUT_SECONDS=0.2

# Password-reset e-mails per ACCOUNT, whatever IP asks (ADR-363): one per
# interval, a few per rolling 24 hours. Past the budget the request answers
# as usual and nothing leaves.
PASSWORD_RESET_ACCOUNT_INTERVAL_SECONDS=900
PASSWORD_RESET_ACCOUNT_DAILY_MAX=3

# Cloudflare Turnstile bot check on password sign-up, sign-in and reset
# requests (ADR-364). Off by default; the keys are YOUR widget
# (dash.cloudflare.com -> Turnstile -> Add widget, hostnames = this instance's
# web hosts: FRONTEND_URL's and those of CORS_ORIGINS). Cloudflare unreachable:
# the sign-in proceeds, a sign-up or a reset request is refused (alert
# TurnstileUnavailable). Cloudflare's testing keys decide outside production
# only; in production they read as no answer.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_TIMEOUT_SECONDS=3.0

# ============================================================================
# [11] MAPS — interactive maps in the browser
# Config: src/core/config/connectors.py
# ============================================================================

# Interactive Maps (server settings): an explicit browser key AND a Cloud map ID;
# no server-key fallback. Never use DEMO_MAP_ID in production. An empty
# configuration keeps maps unavailable.
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_MAP_ID=

# ============================================================================
# [12] OBSERVABILITY — OpenTelemetry & Prometheus
# Config: src/core/config/observability.py
# ============================================================================

# Traces go to the collector inside this envelope.
OTEL_EXPORTER_OTLP_ENDPOINT=http://demo-instance-otel:4317

# ============================================================================
# [13] AGENT LOOP & PROMPT CACHE — ReAct, exchange rhythm (ADR-070, ADR-308, ADR-362)
# Config: src/core/config/agents.py, src/core/config/llm.py
# Toggle between Pipeline (plan → execute) and ReAct (reason → act → observe loop)
# ============================================================================

# Exchange rhythm of a visitor who never chose one (ADR-311: Settings > Usage
# preferences always wins). Occasional here: the ReAct loop keeps its relevance
# selection. Measured on deepseek-flash (2026-09-23), frequent exchanges -- every
# tool bound AND the turn's context after the question -- save about 40 % of a
# ReAct turn (ADR-308); not the default until validated on this instance's provider.
REACT_CROSS_TURN_CACHE_ENABLED=false

# The share of the ReAct loop's history window dropped at once for frequent exchanges
# (ADR-309, ADR-311); inert for occasional ones.
REACT_CROSS_TURN_HISTORY_BLOCK_FRACTION=0.5

# ADR-362: for frequent exchanges, a ReAct turn a person waits for writes the
# prompt cache's two cross-turn read points for the provider's extended lifetime
# (Claude: one hour, a write billed 2x the input price instead of 1.25x). Inert
# here while visitors keep occasional exchanges and no slot runs on Claude.
PROMPT_CACHE_EXTENDED_TTL_ENABLED=true

# ADR-362: an earlier turn's thinking goes back to the Claude model that wrote
# it when that generation keeps it without binding it to its conversation (the
# vendor's default context). Inert here while no slot runs on Claude.
PRIOR_TURN_THINKING_REPLAY_ENABLED=true

# ADR-310: recovery passes a ReAct turn may take when its answer declares facts it
# could not obtain (0 = off).
REACT_RECOVERY_PASSES_MAX=1

# ============================================================================
# [14] CONVERSATION — COMPACTION & ACTIONS SHOWN UNDER AN ANSWER
# Config: src/core/config/agents.py
# ============================================================================

# « Actions performed » under an answer: the longest value one line of an
# effect's label keeps (a reminder, a subject, a recipient), cut on a word
# beyond it. The code default, written so the decision is visible.
EFFECT_LABEL_VALUE_MAX_CHARS=1000

# A compaction summary that dropped an identifier (an id, a reference, an
# address) gets it written back under it, at most this many per list (ADR-086).
# The code default, written so the decision is visible.
COMPACTION_IDENTIFIERS_REINSERT_MAX=30

# ============================================================================
# [15] TOOLS — Emails
# Config: src/core/config/connectors.py
# ============================================================================

# Mailbox drafts one call may move to the trash (ADR-344). Unreachable here — the
# connectors are closed, so no visitor has a mailbox — and declared so the bound is
# decided rather than defaulted.
EMAIL_DRAFTS_BULK_MAX=20

# Folders an Outlook search reads to find one the person named (label:/in:,
# 2026-10-14). Unreachable here for the same reason, and declared so the bound
# is decided rather than defaulted.
OUTLOOK_MAIL_FOLDERS_WALK_MAX=500

# ============================================================================
# [16] REMINDERS & ROUTINES (ADR-304, ADR-322)
# Config: src/core/config/scheduler.py
# ============================================================================

# Reminders are claimed one at a time and notified with no transaction open
# (ADR-304); a claim a crash abandons is released after this many minutes.
# The code default, written so the decision is visible: push channels and
# knowledge spaces are off here, so it is the only ADR-304 setting live.
REMINDER_PROCESSING_STALE_TIMEOUT_MINUTES=10

# Condition routines are checked by the system, not on a schedule (ADR-322).
# The code defaults, written so the decision is visible: a visitor's watch
# reads only what that account connected, and a run past the daily cap waits
# for the next day.
SCHEDULED_ACTIONS_CONDITION_CHECK_MINUTES=10
SCHEDULED_ACTIONS_WEATHER_CHECK_MINUTES=60
SCHEDULED_ACTIONS_WEATHER_HORIZON_HOURS=4
SCHEDULED_ACTIONS_WEATHER_MIN_PRECIPITATION_PERCENT=50
SCHEDULED_ACTIONS_CONDITION_MAX_FIRES_PER_DAY=12

# ============================================================================
# [17] VOICE — TTS
# Config: src/core/config/voice.py
#
# TTS provider/model/voice/tuning is configured in the admin UI under
# "Configuration LLM → Voice Synthesis (TTS)" (LLM type ``voice_tts``).
# Settings live on llm_config_overrides.voice_tts (provider_config JSONB)
# — see ADR-081. Keep only the voice-comment LLM and STT vars here.
# ============================================================================

# Spoken replies speak through the code's default engine (Edge): it performs no
# expressive cue and shares no vendor's concurrency (ADR-345). The code
# defaults, written so the decision is visible — inert while Edge speaks.
VOICE_EXPRESSIVE_CUES_MAX=2
ELEVENLABS_TTS_MAX_CONCURRENCY=5
FISHAUDIO_MAX_CONCURRENCY=5

# ============================================================================
# [18] MCP — Per-User Servers
# Config: src/core/config/mcp.py
# ============================================================================

# Inert while MCP_ENABLED=false: a personal MCP server that fails to connect is
# paused this long, doubling at each consecutive failure up to the maximum
# (ADR-224). The code defaults, written so the decision is visible.
MCP_USER_FAILURE_PAUSE_BASE_SECONDS=30
MCP_USER_FAILURE_PAUSE_MAX_SECONDS=600
# Stored personal MCP catalogue (spec 2026-10-21): the code default, written so the decision is visible.
MCP_USER_CATALOGUE_REVALIDATE_AFTER_SECONDS=900
MCP_USER_DISCOVERY_TIMEOUT_SECONDS=15
MCP_USER_PREPARATION_CONCURRENCY=4
MCP_USER_PREPARATION_CEILING_SECONDS=20
MCP_USER_SLOW_PREPARATION_NOTICE_SECONDS=10

# ============================================================================
# [19] GENERATED FILES — keeping one past its deadline (ADR-319)
# Config: src/core/config/attachments.py
# ============================================================================

# Keeping a generated file past its deadline (ADR-319). Tighter than the code
# defaults: the nightly purge wipes every visitor account, so a kept file lives
# one day at most, but every visitor of the day shares this host's disk.
GENERATED_ASSETS_KEEP_MAX_FILES=20
GENERATED_ASSETS_KEEP_MAX_MB=100

# ============================================================================
# [20] INTERNATIONALIZATION
# Config: src/core/config/advanced.py
# ============================================================================

DEFAULT_LANGUAGE=fr

# ============================================================================
# [21] PEERS — user-to-user connections (peer-connections program)
# Config: src/core/config/peers.py
# ============================================================================

# Peer capability transfers (server settings). Email/event JEV switches are
# DB-backed and default OFF; enable them after local qualification. This file
# never supplies a JEV enable flag or credentials for shared capabilities.
PEERS_CAPABILITY_PREVIEW_TTL_SECONDS=600
PEERS_CAPABILITY_RETRY_TTL_SECONDS=86400
PEERS_CAPABILITY_LEASE_SECONDS=120
PEERS_CAPABILITY_SENDER_DAILY_LIMIT=20
PEERS_CAPABILITY_PAIR_DAILY_LIMIT=5
PEERS_CAPABILITY_RECIPIENT_DAILY_LIMIT=50
PEERS_CAPABILITY_DAILY_BYTES=20971520
PEERS_CAPABILITY_RATE_LIMIT_CALLS=20
PEERS_CAPABILITY_RATE_LIMIT_WINDOW_SECONDS=60

