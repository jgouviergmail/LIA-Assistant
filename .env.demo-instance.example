# ============================================================================
# [26] PROACTIVE DISCUSSIONS — LIA opens a conversation (ADR-358, ADR-359, ADR-360)
# Config: src/core/config/proactive_discussions.py
# An independent opt-in per person; native usage quotas still apply. What a model
# accepts (window, output budget, tariff) is never set here: it is read from the
# configured slots (Admin > LLM Configuration). Recreate the API container after
# a change to apply it.
# ============================================================================

# Inert while PROACTIVE_DISCUSSIONS_ENABLED=false (capabilities above); the
# bounds stay declared so the demonstrator follows the application's settings.

# --- Operator switch and cadence
DISCUSSION_INTERVAL_MINUTES=15                               # Minutes between two producer ticks (1-1440)
DISCUSSION_TICK_CANDIDATES=200                               # Owners one tick examines at random before drawing its batch (>= the owners; 1-10000)
DISCUSSION_TICK_OWNERS=4                                     # Owners one tick serves at most, a requested rebuild first (1-200)
DISCUSSION_TICK_CONCURRENCY=2                                # Runs one tick drives at once (1-16)

# --- Spending ceilings, in USD (daily buckets are UTC days). Unset any of the three
# and paid production stays off. A run reserves its ceiling or what is left of the
# day, whichever is smaller, and starts only with room for its first call, whose
# bound follows the context slot's output budget and tariff (Settings shows both).
DISCUSSION_RUN_BUDGET_USD=0.10
DISCUSSION_OWNER_DAILY_BUDGET_USD=1.00
DISCUSSION_INSTANCE_DAILY_BUDGET_USD=5.00

# --- Consent and the person's attention
# Sensitive topics a NEW account consents to, comma-separated (empty for none):
# health, relationships, finances, grief, intimacy. Each person withdraws any of
# them in the settings; an account that already chose keeps its choice.
DISCUSSION_DEFAULT_SENSITIVE_TOPICS=health,relationships,finances,grief,intimacy
DISCUSSION_ATTENTION_RECENT_TURN_MINUTES=5                   # No opening while the person wrote this recently (0-1440)
DISCUSSION_ATTENTION_ALERT_GAP_MINUTES=0                     # No opening this long after a notification or an alert; 0 lets both coexist
DISCUSSION_ATTENTION_OPENING_GAP_MINUTES=30                  # Minutes between two openings, whatever became of the first
DISCUSSION_ATTENTION_UNANSWERED_OPENING_MINUTES=60           # An unanswered opening holds the next one back this long; 0 leaves only the gap (0-1440)
DISCUSSION_ATTENTION_REMINDER_AHEAD_MINUTES=5                # No opening this close before a reminder rings

# Hours a reply to an opening restrains later discussions while memory has not
# acknowledged it (transient guard, ADR-359).
DISCUSSION_REPLY_GUARD_TTL_HOURS=168
DISCUSSION_REPLY_GUARD_MAX_ROWS=100                          # Live reply guards a run reads, all or none; past it every run defers (1-1000)
DISCUSSION_REPLY_GUARD_MAX_TOKENS=1600                       # Tokens the live reply guards may take; past it every run defers (100-200000)
DISCUSSION_OPENING_PENDING_HOURS=24                          # Hours an opening waits for a reply before it lapses; a newer one closes it sooner (1-720)
DISCUSSION_PAUSE_HOURS=24                                    # Hours a pause lasts: the settings button and "not now" (1-720)

# --- One run: its lease, its deadlines (an opening's shorter than the lease) and its model calls
DISCUSSION_RUN_LEASE_SECONDS=300
DISCUSSION_RUN_DEADLINE_SECONDS=240
DISCUSSION_REBUILD_DEADLINE_SECONDS=900                      # Seconds a requested rebuild may run, then resumes at the next tick (>= the opening's; 10-3600)
DISCUSSION_CONTEXT_CALLS_PER_RUN=3                           # Context calls an opening run may buy (1-10)
DISCUSSION_REBUILD_CONTEXT_CALLS=8                           # Context calls a requested rebuild may buy: it interprets every admitted fact (1-20)
DISCUSSION_CONTEXT_FACTS_PER_PASS=12                         # Facts one context call interprets, at most (1-100)

# --- Source reads (one read's call limit stays within the run's)
DISCUSSION_RUN_READ_CALLS_MAX=64                             # Physical source calls of one run, every read together (1-1000)
DISCUSSION_READ_CALL_LIMIT=8                                 # Physical calls of one source read (1-100)
DISCUSSION_READ_TIMEOUT_SECONDS=10                           # Seconds one source read may take before its page is closed (1-120)
DISCUSSION_RESEARCH_ITEM_LIMIT=5                             # Items one source page returns (1-100)
DISCUSSION_RESEARCH_ITEM_MAX_CHARS=2000                      # Characters of one item's excerpt; the portrait is read whole (100-16000)
DISCUSSION_RESEARCH_DEFAULT_WINDOW_DAYS=7                    # Days before and after now a read covers when no date is named (1-31)

# --- Context reuse and retention
DISCUSSION_REUSED_ITEMS_MAX=100                              # Stored context items one run may reuse, the most recent first
DISCUSSION_REUSED_PROOFS_MAX=24                              # Stored proofs one run reads again before reusing their items
DISCUSSION_HISTORY_OPENINGS=10                               # Prior openings a decision is shown, so none is repeated
DISCUSSION_RULE_CACHE_HOURS=24                               # Hours a compiled read restriction is reused for the same inputs
DISCUSSION_CONTEXT_RETENTION_DAYS=365                        # Days a context item may outlive its read, capped by its source
DISCUSSION_PEER_CONTEXT_RETENTION_DAYS=7                     # The same, for what comes from a peer connection
DISCUSSION_DIRECTIVES_MAX_TOKENS=8000                        # Tokens the person's complete rules may take; past it the run defers
DISCUSSION_DELIVERY_PROOF_MAX_AGE_MINUTES=5                  # Minutes an opening's proofs stay fresh enough to be delivered; a delivery attempt lasts at most this long (1-60)

# --- Delivery, maintenance and provider backoff
DISCUSSION_DELIVERY_BATCH_SIZE=20                            # Pending openings one delivery sweep serves, oldest first (1-500)
DISCUSSION_MAINTENANCE_BATCH_SIZE=100                        # Accounts whose context retention one tick enforces, and expired reservations it settles (1-1000)
DISCUSSION_CONTEXT_PURGE_BATCH_SIZE=250                      # Observations a context purge streams per batch (1-5000)
DISCUSSION_BACKOFF_MINUTES=15                                # Minutes a run defers when a provider asks to wait without saying how long (1-1440)

# --- Prompt versions (files under src/domains/agents/prompts/<version>/)
DISCUSSION_CONTEXT_PROMPT_VERSION=v1
DISCUSSION_DECISION_PROMPT_VERSION=v1
DISCUSSION_MESSAGE_PROMPT_VERSION=v1

# ============================================================================
# [27] INERT HERE — settings of capabilities switched off above
# ============================================================================

# What the capabilities switched OFF in CAPABILITIES OFFERED would use, where
# no section of their own exists. Each line does nothing while its switch is
# off; it is written so the value it would take is decided, not defaulted.

LIVE_STANDBY_MAX_SECONDS=28800  # Inert while LIVE_ENABLED=false: the standby bound of a live session (ADR-329)

# Inert while DEVOPS_ENABLED=false: the model and the reasoning effort every
# remote-administration run (Claude CLI) is started with.
DEVOPS_CLAUDE_MODEL=claude-opus-5-5
DEVOPS_CLAUDE_EFFORT=low

# Inert while VOICE_STT_ENABLED=false: the longest audio one remote dictation
# call may carry, in seconds (ADR-345).
REMOTE_STT_MAX_AUDIO_DURATION_SECONDS=300

# Inert while creation is off: what one Fish Audio voice design costs the instance.
FISHAUDIO_VOICE_DESIGN_COST_USD=0.01

# Inert without a Fish Audio key: how many public voices an administrator may pin.
FISHAUDIO_PINNED_VOICES_MAX=50

# Inert while SMS_ENABLED=false: the recent SMS the Today dashboard card shows.
BRIEFING_MAX_SMS_ITEMS=10

# Today dashboard coalescing (spec 2026-10-21): the code defaults, written so the decision is visible.
BRIEFING_SHARED_BUILD_MAX_WAIT_SECONDS=60
BRIEFING_SECTION_ATTEMPT_MARKER_SECONDS=120
BRIEFING_TEXT_CACHE_TTL_SECONDS=300
BRIEFING_ACT_TOKEN_TTL_SECONDS=600
BRIEFING_SECTION_CONCURRENCY=4

# Dialogue takes (ADR-345): the code default, written so the decision is visible —
# inert while RADIO_ENABLED=false.
RADIO_DIALOGUE_MAX_BYTES=1500
RADIO_REACTIONS_MAX=2

# Self-diagnostics stay at their code default (off), so the reconciliation of an
# alert incident whose resolution was lost is inert here (DIAGNOSTICS_DOMAIN.md).
DIAGNOSTICS_INCIDENT_SILENCE_CLOSE_SECONDS=3600

# No Ollama server is configured here: how long an address that answered nothing
# waits before a config reload asks it again (ADR-267 amendment) — inert.
OLLAMA_DISCOVERY_RETRY_SECONDS=600
LLM_TRANSIENT_RETRY_MAX=2
