# Public demonstrator instance — environment template.
#
# Copy to `.env.demo-instance` (git-ignored) and fill the secrets. This file
# configures the STANDARD LIA image running inside the isolated envelope
# (docker-compose.demo-instance.yml); it is never a normal .env.
#
# This is the LOCAL VALIDATION shape: loopback ports, http://localhost, a
# host-only session cookie, development logging. The PRODUCTION shape is its
# sibling `.env.demo-instance.prod.example` — same keys, four deliberate
# differences, each documented there.
#
#   task dev:all             application stack + demonstrator, together
#   task demo:start          the demonstrator alone (edge on 127.0.0.1:8090)
#
# Every variable the Compose files interpolate must be declared here, and every
# variable declared here must be one the code actually reads. Both directions
# are enforced by `apps/api/tests/unit/test_demo_instance_env_template.py`,
# because this template WAS wrong: it named five SMTP settings nothing reads,
# omitted the URL that builds the verification link, and offered an OpenAI key
# to an instance configured for DeepSeek.
#
# After the first boot, mark the database as a demonstrator's:
#
#   task demo:provision
#
# Without that marker the nightly visitor purge refuses to run. That command
# ALSO refuses an instance whose model this database cannot price — a daily
# spend ceiling that reads a flat ledger is not a ceiling.

# ============================================================================
# WHAT MAKES THIS A DEMONSTRATOR
# ============================================================================

# Visitor accounts: verifying the email activates the account, registration
# requires accepting the terms, and the nightly purge wipes every non-admin
# account. NEVER set this on a private instance.
DEMO_MODE_ENABLED=true

# Identifier of the terms a visitor accepts. Bump it whenever they change.
DEMO_TERMS_VERSION=2026-08-06

# Nightly wipe, in UTC.
DEMO_ACCOUNT_PURGE_HOUR=2
DEMO_ACCOUNT_PURGE_MINUTE=30

# Rapport quotidien envoye a l'exploitant, JUSTE AVANT la purge de 02:30 : la
# base vit en tmpfs et disparait avec elle, donc ce courriel est la seule trace
# historisee de l'activite. Vide = pas de rapport, l'instance tourne a
# l'identique. Il emprunte le relais de courrier deja utilise pour les liens de
# verification : aucune route reseau supplementaire n'est ouverte.
DEMO_DAILY_REPORT_RECIPIENT=
DEMO_DAILY_REPORT_HOUR=2
DEMO_DAILY_REPORT_MINUTE=15


# Hard ceiling on what this instance may spend per UTC day, every cost family
# included. First come, first served: once reached, visitors are told to come
# back tomorrow. This is THE financial protection (ADR-216).
INSTANCE_DAILY_BUDGET_EUR=1.00

# Accounts this instance may create per UTC day.
#
# The per-address limiter (5 registrations a minute) bounds one caller, never
# the instance: its bucket key comes from a header the caller supplies, and
# thirty accounts were created in 6,4 seconds when that was the only bound
# (measured 2026-08-07). Every account costs one verification email against
# the smarthost quota, which the spend ceiling above does not see.
DEMO_DAILY_SIGNUP_LIMIT=50

# Per-visitor limits, so one visitor cannot drain the daily budget alone.
USAGE_LIMITS_ENABLED=true
DEFAULT_TOKEN_LIMIT_PER_CYCLE=200000
DEFAULT_MESSAGE_LIMIT_PER_CYCLE=25
DEFAULT_COST_LIMIT_PER_CYCLE_EUR=0.05

# ============================================================================
# CAPABILITIES OFFERED (deployment ceilings — ADR-217)
# ============================================================================
# An administrator may lower these from Settings > Administration, never
# raise them. Image generation is off: expensive, and it demonstrates nothing
# about what makes LIA different (owner arbitration 2026-08-06).

IMAGE_GENERATION_ENABLED=false
# Interactive browsing drives a real browser: too much surface for a public
# instance, and search already covers the demonstrative need.
BROWSER_ENABLED=false
TELEPHONY_ENABLED=false
# Uploads and document spaces store visitor files on a disposable instance.
ATTACHMENTS_ENABLED=false
RAG_SPACES_ENABLED=false
# Sandboxed execution and user-connected servers are not demonstrated.
SKILLS_ENABLED=false
MCP_ENABLED=false
# Neither is remote server administration, nor the messaging channels.
DEVOPS_ENABLED=false
CHANNELS_ENABLED=false
# Proactive messages: a visitor is here for minutes, not for a rhythm.
HEARTBEAT_ENABLED=false

# Kept: the conversation itself, speech synthesis, and search — that IS the
# demo. Each one's provider host must be on the egress allowlist
# (infrastructure/demo-instance/squid.conf); a flag that is ON while the route
# is closed puts a button in front of a visitor that cannot work, which on a
# demonstrator is worse than not offering it. The pairing is enforced by
# tests/unit/test_demo_instance_capability_coherence.py.
VOICE_TTS_ENABLED=true
WEB_SEARCH_ENABLED=true

# Dictation is OFF: it transcribes through ElevenLabs, which needs a key of
# its own. Measured 2026-08-07 with the flag on and no key: the microphone was
# offered and `CONNECT api.elevenlabs.io:443` answered 403 at the proxy. To
# enable it, set an ELEVENLABS_API_KEY and add api.elevenlabs.io to the
# allowlist — the coherence guard will hold you to doing both.
VOICE_STT_ENABLED=false

# ============================================================================
# THE ONE ADDRESS, WRITTEN THREE TIMES
# ============================================================================
# They describe the same origin and they move together. FRONTEND_URL is the
# one that builds the email verification link (auth/service.py); leaving it at
# a default produced `https://localhost:/verify-email`, a link nobody could
# click, while every other page worked (measured 2026-08-07).
#
# Locally that origin is the edge's loopback port, so these two must stay in
# step with DEMO_INSTANCE_EDGE_PORT below.

APP_URL_SERVER=http://localhost:8090
FRONTEND_URL=http://localhost:8090

# Session cookie: EMPTY here on purpose. An empty domain gives a host-only
# cookie, which is what `localhost` needs; naming a domain would make the
# browser drop it. Production names its exact host and never a parent domain
# — a parent is shared with every sibling, so the demonstrator would hand its
# throwaway sessions to the main instance and receive its own.
SESSION_COOKIE_DOMAIN=

# Loopback ports for the development override (task demo:up:dev). Production
# publishes NOTHING — the tunnel is the way in — so its template declares
# neither of these. A developer machine is a crowded place: 8080 belongs to
# cadvisor here, hence 8090/8100.
DEMO_INSTANCE_EDGE_PORT=8090
DEMO_INSTANCE_API_PORT=8100

# ============================================================================
# SECRETS (fill these in; never commit the filled file)
# ============================================================================

DEMO_INSTANCE_POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://demo:CHANGE_ME@demo-instance-postgres:5432/lia_demo
REDIS_URL=redis://demo-instance-redis:6379/0
# Both MUST differ from every other instance's: a shared SECRET_KEY means a
# session minted here is valid there.
SECRET_KEY=
FERNET_KEY=

# The provider every LLM type is pointed at, and the key it spends. Prefer a
# key DEDICATED to this instance with a provider-side cap: the ceiling above
# is LIA's accounting, not the provider's.
DEEPSEEK_API_KEY=
# Embeddings for memory and interests. Not covered by any capability switch —
# the embedding model is not in LLM_TYPES_REGISTRY — so an absent key leaves
# both silently inert.
GOOGLE_GEMINI_API_KEY=
# Search key the instance LENDS to every visitor account. Brave is a PER-USER
# connector: without it a visitor sees the search agent and can never use it.
DEMO_SHARED_SEARCH_API_KEY=

# ============================================================================
# MAIL — the step that ACTIVATES a visitor's account
# ============================================================================
# The API sits on no outbound network and a HTTP proxy cannot relay SMTP, so
# mail leaves through a confined relay. Two smarthost names, on purpose:
#
#   ALERTMANAGER_SMTP_SMARTHOST  what the APPLICATION talks to — the relay,
#                                inside the private network, no credentials;
#   DEMO_INSTANCE_SMTP_SMARTHOST what the RELAY talks to — the real provider.
#
# Reading one for the other makes the relay forward to itself. The credentials
# below belong to the relay and are BLANKED in the API container by the
# Compose file: the process that talks to visitors never holds them.

ALERTMANAGER_SMTP_SMARTHOST=demo-instance-smtp:25
DEMO_INSTANCE_SMTP_SMARTHOST=smtp.example.org:587
ALERTMANAGER_SMTP_AUTH_USERNAME=
ALERTMANAGER_SMTP_AUTH_PASSWORD=
# Sender domain the relay accepts, and the address visitors see. Prefer a
# domain (or subdomain) dedicated to the demonstrator: the relay accepts any
# sender of this domain to any recipient in the world, so a burst of signups
# spends this domain's sending reputation.
DEMO_INSTANCE_MAIL_DOMAIN=example.org
APPLICATION_SMTP_FROM=lia@example.org

# ============================================================================
# BUDGET DE CONNEXIONS POSTGRESQL (F004)
# ============================================================================
# La rafale du pire cas -- chaque worker uvicorn tenant tout son pool, plus le
# checkpointer et le store LangGraph -- doit tenir sous le max_connections du
# serveur. En production le depassement REFUSE le demarrage ; en developpement
# il n'avertit que. C'est pourquoi cette instance demarrait ici et mourait sur
# le Raspberry (mesure 2026-08-07) :
#
#   ConnectionBudgetError: worst-case burst 288 exceeds usable 195
#
# Le fichier ne portait aucun de ces reglages, donc les defauts du code
# s'appliquaient : 4 workers x (30+30) + 4x8 + 4x4 = 288.
#
# Et le chiffre de reference etait faux : la base du demonstrateur est un
# pgvector standard, dont le max_connections vaut 100, pas 200 (verifie avec
# `show max_connections`). Un budget calcule contre un plafond qui n'existe
# pas ne protege de rien.
#
# Dimensionnement retenu, pour un demonstrateur sur Raspberry (mem_limit 2g) :
#   2 x (10 + 5) + 2x8 + 2x4 = 54  <=  95 usable (100 - 5 reserves)
WEB_CONCURRENCY=3
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_MAX_CONNECTIONS=100

# ============================================================================
# RUNTIME
# ============================================================================

ENVIRONMENT=development
LOG_LEVEL=DEBUG
DEFAULT_LANGUAGE=fr

# Traces go to the collector inside this envelope.
OTEL_EXPORTER_OTLP_ENDPOINT=http://demo-instance-otel:4317

# Every LLM type is pointed at this provider when the instance is provisioned.
# The registry ships one provider per type (Qwen here, OpenAI there) for the
# full product; a demonstrator holds one key, so it must override them all or
# the graph calls providers it has no key for.
#
# The model MUST have an ACTIVE per-1M-token price in THIS instance's
# catalogue. That catalogue is built by the migrations alone — the reference
# seed bundle is refused here, because the migrations already insert the
# personalities and the bundle deletes before it inserts (ADR-215 gate).
#
# Why it matters: the daily ceiling above reads a ledger the pricing catalogue
# feeds. An unpriced model is billed by the provider and recorded at zero, so
# the ceiling never fires (measured 2026-08-07: 59 344 real tokens ledgered as
# 0,000025 EUR). `task demo:provision` refuses such a model outright rather
# than arming a blind ceiling, and `task demo:verify` re-checks it on a
# running instance. An INACTIVE price counts as missing.
DEMO_INSTANCE_LLM_PROVIDER=deepseek
DEMO_INSTANCE_LLM_MODEL=deepseek-v4-flash
