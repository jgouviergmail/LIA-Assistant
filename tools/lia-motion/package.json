{
  "name": "lia-motion",
  "version": "0.1.0",
  "private": true,
  "description": "Editable LIA film, landing cut and product focuses. Offline authoring, outside the application bundle.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "studio": "npm run assets && remotion studio src/index.ts --port=3100",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "render": "node scripts/render.mjs",
    "storyboard": "node --experimental-strip-types scripts/storyboard.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "zod": "$zod",
    "fast-uri": "^3.1.9"
  }
}
