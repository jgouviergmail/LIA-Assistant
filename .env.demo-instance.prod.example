# Public demonstrator — PRODUCTION environment template.
#
# Copy to `.env.demo-instance.prod` (git-ignored) and fill the secrets. This is
# the file `task demo:prod:up` reads on the host, and the shape that faces the
# Internet. Its sibling `.env.demo-instance.example` is the LOCAL validation
# shape; the two differ in exactly four ways, and each difference matters:
#
#   1. the URLs are the public hostname, never localhost — FRONTEND_URL builds
#      the verification link a stranger clicks;
#   2. no DEMO_INSTANCE_EDGE_PORT / _API_PORT: production publishes NO host
#      port at all. The tunnel is the way in, and that exclusivity is what
#      makes CF-Connecting-IP — the rate limiter's identity — trustworthy;
#   3. DEMO_INSTANCE_TUNNEL_TOKEN is required: it is what puts the instance on
#      the Internet;
#   4. ENVIRONMENT=production, LOG_LEVEL=INFO.
#
# Both templates are checked against the Compose files and against the code by
# `apps/api/tests/unit/test_demo_instance_env_template.py`: every `${VAR}` the
# envelope interpolates must be declared here, and every key declared here
# must be one the code actually reads.
#
# Deploying does NOT start this instance (`task deploy:prod` ships it and stops
# there). Starting it is a decision:
#
#   task demo:prod:up        start, with the tunnel — it becomes public
#   task demo:prod:verify    closed surface + spend ceiling + host isolation
#   task demo:prod:down      stop; the tmpfs database dies with it
#   task demo:prod:harden    (re)install the container->host firewall rules

# ============================================================================
# WHAT MAKES THIS A DEMONSTRATOR
# ============================================================================

DEMO_MODE_ENABLED=true
DEMO_TERMS_VERSION=2026-08-06
DEMO_ACCOUNT_PURGE_HOUR=2
DEMO_ACCOUNT_PURGE_MINUTE=30

# Rapport quotidien envoye a l'exploitant, JUSTE AVANT la purge de 02:30 : la
# base vit en tmpfs et disparait avec elle, donc ce courriel est la seule trace
# historisee de l'activite. Vide = pas de rapport, l'instance tourne a
# l'identique. Il emprunte le relais de courrier deja utilise pour les liens de
# verification : aucune route reseau supplementaire n'est ouverte.
DEMO_DAILY_REPORT_RECIPIENT=
DEMO_DAILY_REPORT_HOUR=2
DEMO_DAILY_REPORT_MINUTE=15


# THE financial protection (ADR-216). It reads a ledger the pricing catalogue
# feeds, so it is only a ceiling while DEMO_INSTANCE_LLM_MODEL below is priced
# — `task demo:prod:up` provisions, and provisioning refuses otherwise.
INSTANCE_DAILY_BUDGET_EUR=1.00

# Accounts per UTC day. The per-address limiter bounds one caller, never the
# instance; every account costs one verification email against the smarthost
# quota, which the spend ceiling does not see.
DEMO_DAILY_SIGNUP_LIMIT=50

USAGE_LIMITS_ENABLED=true
DEFAULT_TOKEN_LIMIT_PER_CYCLE=200000
DEFAULT_MESSAGE_LIMIT_PER_CYCLE=25
DEFAULT_COST_LIMIT_PER_CYCLE_EUR=0.05

# ============================================================================
# CAPABILITIES OFFERED (deployment ceilings — ADR-217, ADR-280)
# ============================================================================
# One line per PlatformCapability (domains/feature_switches/registry.py). An
# administrator may lower any of these from Settings > Administration, never
# raise them. A flag ABSENT from this file takes the code's default — which is
# how the workboard, the meetings and model-authored Python reached the public
# demonstrator switched ON by nobody's decision, each behind a door that did
# not open (measured 2026-09-12). Every capability is therefore written down
# here, on or off, with why.
#
# Three declarations must agree for an ON flag to work: this file, the egress
# allowlist (infrastructure/demo-instance/squid.conf) and the edge allowlist
# (infrastructure/demo-instance/Caddyfile). A flag that is ON while its route
# is closed puts a button in front of a visitor that cannot work, which on a
# demonstrator is worse than not offering it. Enforced by
# tests/unit/test_demo_instance_capability_coherence.py (hosts, and the two
# templates agreeing) and tests/unit/test_demo_instance_exposed_routes.py
# (routes, mounted under THIS file's flags).

# --- ON: the conversation and what it draws on — that IS the demo ----------
WEB_SEARCH_ENABLED=true
VOICE_TTS_ENABLED=true
SUB_AGENTS_ENABLED=true
# A generated document is served by GET /attachments/{id}, which is mounted
# whatever the uploads ceiling says (ADR-279, amended 2026-09-12) — before
# that, a report was written here and could not be opened.
DOCUMENT_GENERATION_ENABLED=true
# What LIA learns and keeps for the visitor's own account, wiped nightly.
MEMORY_EXTRACTION_ENABLED=true
INTEREST_EXTRACTION_ENABLED=true
JOURNALS_ENABLED=true
PSYCHE_ENABLED=true
HABITS_ENABLED=true
BOOKMARKS_ENABLED=true
OPEN_LOOPS_ENABLED=true
RELATION_DEBRIEF_ENABLED=true
# A ticket runs on the visitor's own allowance, like a routine does.
WORKBOARD_ENABLED=true
# Connections between two demonstrator accounts — throwaway on both sides.
PEERS_ENABLED=true

# --- OFF, each for a written reason ----------------------------------------
# Image generation: expensive, and it demonstrates nothing about what makes
# LIA different (owner arbitration 2026-08-06).
IMAGE_GENERATION_ENABLED=false
# Interactive browsing drives a real browser: too much surface for a public
# instance, and search already covers the demonstrative need.
BROWSER_ENABLED=false
TELEPHONY_ENABLED=false
# Uploads and document spaces store visitor files on a disposable instance.
ATTACHMENTS_ENABLED=false
RAG_SPACES_ENABLED=false
# Sandboxed execution and user-connected servers are not demonstrated — and
# the envelope mounts no Docker socket, so the container sandbox that
# model-authored Python REQUIRES (ADR-249) cannot exist here.
SKILLS_ENABLED=false
PYTHON_SANDBOX_TOOL_ENABLED=false
MCP_ENABLED=false
# Neither is remote server administration, nor the messaging channels.
DEVOPS_ENABLED=false
CHANNELS_ENABLED=false
# Proactive messages: a visitor is here for minutes, not for a rhythm. An
# anticipated moment is SERVED by the heartbeat sweep (ADR-281), so it goes
# with it.
HEARTBEAT_ENABLED=false
MOMENTS_ENABLED=false
# Dictation is OFF: the local engine holds about 1.6 GB per worker (ADR-283)
# on a host the demonstrator shares with production, and the remote path
# needs a provider key AND its host on the egress allowlist — the coherence
# guard holds you to both. Meetings transcribe through the same engines, so
# they go with it; they are also the costliest surface of the product.
VOICE_STT_ENABLED=false
MEETINGS_ENABLED=false

# ============================================================================
# THE ONE ADDRESS, WRITTEN THREE TIMES
# ============================================================================
# They describe the same origin and they move together. FRONTEND_URL is the one
# that builds the email verification link.

APP_URL_SERVER=https://demo.example.org
FRONTEND_URL=https://demo.example.org

# Bound to THIS host and nothing else. A parent domain (".example.org") is
# shared with every sibling, so the demonstrator would hand its throwaway
# sessions to the main instance — and receive its own.
SESSION_COOKIE_DOMAIN=demo.example.org

# ============================================================================
# SECRETS (fill these in; never commit the filled file)
# ============================================================================

DEMO_INSTANCE_POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://demo:CHANGE_ME@demo-instance-postgres:5432/lia_demo
REDIS_URL=redis://demo-instance-redis:6379/0
# Both MUST differ from every other instance's, production included: a shared
# SECRET_KEY means a session minted here is valid there.
SECRET_KEY=
FERNET_KEY=

# The provider every LLM type is pointed at. Prefer a key DEDICATED to this
# instance with a provider-side cap: the ceiling above is LIA's accounting,
# not the provider's, and this process talks to strangers.
DEEPSEEK_API_KEY=
# Embeddings for memory and interests. No capability switch covers it, so an
# absent key leaves both silently inert. A dedicated key here too: sharing the
# production one puts it in a process anyone can talk to.
GOOGLE_GEMINI_API_KEY=
# Search key the instance LENDS to every visitor account.
DEMO_SHARED_SEARCH_API_KEY=

# Cloudflare tunnel connector token — REQUIRED here: it is what puts this
# instance on the Internet, and `task demo:prod:up` refuses without it.
DEMO_INSTANCE_TUNNEL_TOKEN=

# ============================================================================
# MAIL — the step that ACTIVATES a visitor's account
# ============================================================================
# Two smarthosts, and swapping them silently kills the signup journey:
#
#   ALERTMANAGER_SMTP_SMARTHOST  what the APPLICATION opens a socket to — the
#                                relay, on the private network, no credentials;
#   DEMO_INSTANCE_SMTP_SMARTHOST what the RELAY forwards to — the provider.
#
# The application sits on no outbound network, so naming the provider on the
# first line means the verification email can never leave (found exactly that
# way in the real production file, 2026-08-07). The credentials below belong to
# the relay and are BLANKED in the API container by the Compose file.

ALERTMANAGER_SMTP_SMARTHOST=demo-instance-smtp:25
DEMO_INSTANCE_SMTP_SMARTHOST=smtp.example.org:587
ALERTMANAGER_SMTP_AUTH_USERNAME=
ALERTMANAGER_SMTP_AUTH_PASSWORD=
# The relay accepts any sender of this domain, to any recipient in the world.
# Prefer a domain (or subdomain) dedicated to the demonstrator: a burst of
# signups spends this domain's sending reputation.
DEMO_INSTANCE_MAIL_DOMAIN=example.org
APPLICATION_SMTP_FROM=lia@example.org

# ============================================================================
# BUDGET DE CONNEXIONS POSTGRESQL (F004)
# ============================================================================
# La rafale du pire cas -- chaque worker uvicorn tenant tout son pool, plus le
# checkpointer et le store LangGraph -- doit tenir sous le max_connections du
# serveur. En production le depassement REFUSE le demarrage ; en developpement
# il n'avertit que. C'est pourquoi cette instance demarrait ici et mourait sur
# le Raspberry (mesure 2026-08-07) :
#
#   ConnectionBudgetError: worst-case burst 288 exceeds usable 195
#
# Le fichier ne portait aucun de ces reglages, donc les defauts du code
# s'appliquaient : 4 workers x (30+30) + 4x8 + 4x4 = 288.
#
# Et le chiffre de reference etait faux : la base du demonstrateur est un
# pgvector standard, dont le max_connections vaut 100, pas 200 (verifie avec
# `show max_connections`). Un budget calcule contre un plafond qui n'existe
# pas ne protege de rien.
#
# Dimensionnement retenu, pour un demonstrateur sur Raspberry (mem_limit 2g) :
#   2 x (10 + 5) + 2x8 + 2x4 = 54  <=  95 usable (100 - 5 reserves)
WEB_CONCURRENCY=3
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_MAX_CONNECTIONS=100

# ============================================================================
# RUNTIME
# ============================================================================

ENVIRONMENT=production
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=fr

OTEL_EXPORTER_OTLP_ENDPOINT=http://demo-instance-otel:4317

# Every LLM type is pointed at this provider when the instance is provisioned.
#
# The model MUST have an ACTIVE per-1M-token price in this instance's
# catalogue, which the reference seed bundle builds at every boot. An unpriced
# model is billed by the provider and recorded at ZERO, so the daily ceiling
# never fires (measured 2026-08-07: 59 344 real tokens ledgered as
# 0,000025 EUR). `task demo:prod:up` provisions and refuses such a model;
# `task demo:prod:verify` re-asks a running instance.
DEMO_INSTANCE_LLM_PROVIDER=deepseek
DEMO_INSTANCE_LLM_MODEL=deepseek-v4-flash
