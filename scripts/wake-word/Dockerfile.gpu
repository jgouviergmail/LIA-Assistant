# The wake-word toolbox's GPU half (ADR-329): natural voices of the phrase and
# its near misses, generated by VoxCPM2 (Apache-2.0 code and weights) — voices
# DESIGNED from a description and voices CLONED from real recordings of the
# corpora — and the TRAINING on CUDA (the same recipe as the CPU image, the
# feature stages on ONNX Runtime's CUDA provider). The measurement and the
# golden fixture stay in the CPU image (Dockerfile): the arithmetic they certify
# is the browser's.
#
#   task wake:image:gpu
#   task wake:clone -- fr           # needs an NVIDIA GPU (docker run --gpus all)
#   task wake:run:gpu -- train --lang fr
#
# The model weights are downloaded once into the volume (HF_HOME=/data/hf).
FROM python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/data/hf

# build-essential: VoxCPM compiles its kernels through torch.compile and Triton,
# which needs a C compiler (measured 2026-10-01: "Failed to find C compiler").
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /toolbox

COPY requirements-gpu.lock.txt ./
RUN pip install --require-hashes -r requirements-gpu.lock.txt

COPY wakeword ./wakeword

ENTRYPOINT ["python", "-m", "wakeword"]
