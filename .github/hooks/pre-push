#!/bin/bash
#
# Pre-push hook for LIA: the CI's secret scan, over exactly what this push sends.
#
# The CI's Secret Scan (gitleaks, the `secret-scan` job of ci.yml) runs after
# the push, when a secret on the remote can no longer be taken back. On
# 2026-10-02 two dummy values a scanner reads as keys reached the remote that
# way, and the next commit held four more. `task security:secrets` is the CI's
# scanner run locally (same version, same configuration); this hook calls it for
# every ref the push updates, on the commits the remote does not have yet.
#
# Git passes one line per ref on stdin:
#   <local ref> <local object> <remote ref> <remote object>
# An all-zero object means "no such ref": a deletion on the local side (nothing
# is sent), a new ref on the remote side (everything no remote has is sent).

set -euo pipefail

if ! command -v task >/dev/null 2>&1; then
    echo "pre-push: Task (https://taskfile.dev) is required to run the secret scan." >&2
    exit 1
fi
if ! docker info >/dev/null 2>&1; then
    echo "pre-push: Docker is not running; the secret scan (task security:secrets) needs it." >&2
    echo "pre-push: start Docker and push again." >&2
    exit 1
fi

status=0
while read -r local_ref local_object remote_ref remote_object; do
    if [ -z "${local_object:-}" ] || [[ "$local_object" =~ ^0+$ ]]; then
        continue
    fi
    if [[ "$remote_object" =~ ^0+$ ]]; then
        range="$local_object --not --remotes"
    else
        range="$remote_object..$local_object"
    fi
    echo "pre-push: secret scan of $local_ref -> $remote_ref"
    task security:secrets RANGE="$range" || status=1
done

if [ "$status" -ne 0 ]; then
    echo "pre-push: the secret scan failed; nothing was pushed." >&2
fi
exit "$status"
